{% extends 'base.html.twig' %}

{% block title %}Email Statistics{% endblock %}

{% block body %}
<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Email Statistics</h1>
        <a href="{{ path('email_log_index') }}" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i> Back to Logs
        </a>
    </div>

    <div class="card mb-4">
        <div class="card-header bg-light">
            <div class="d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Period: {{ startDate|date('M d, Y') }} - {{ endDate|date('M d, Y') }}</h5>
                <div class="btn-group">
                    <a href="{{ path('email_log_stats', {period: '7days'}) }}" class="btn btn-sm btn-outline-primary {% if period == '7days' %}active{% endif %}">Last 7 Days</a>
                    <a href="{{ path('email_log_stats', {period: '30days'}) }}" class="btn btn-sm btn-outline-primary {% if period == '30days' %}active{% endif %}">Last 30 Days</a>
                    <a href="{{ path('email_log_stats', {period: 'year'}) }}" class="btn btn-sm btn-outline-primary {% if period == 'year' %}active{% endif %}">Last Year</a>
                </div>
            </div>
        </div>
        <div class="card-body">
            <div class="row mb-4">
                <div class="col-md-4">
                    <div class="card bg-primary text-white">
                        <div class="card-body text-center">
                            <h3 class="display-4">{{ stats.total }}</h3>
                            <p class="lead">Total Emails</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card bg-success text-white">
                        <div class="card-body text-center">
                            <h3 class="display-4">{{ stats.sent }}</h3>
                            <p class="lead">Sent Successfully</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card bg-danger text-white">
                        <div class="card-body text-center">
                            <h3 class="display-4">{{ stats.failed }}</h3>
                            <p class="lead">Failed</p>
                        </div>
                    </div>
                </div>
            </div>
            
            {% if stats.total > 0 %}
                <div class="row">
                    <div class="col-md-6">
                        <div class="card h-100">
                            <div class="card-header">
                                <h5 class="mb-0">Success Rate</h5>
                            </div>
                            <div class="card-body d-flex align-items-center justify-content-center">
                                <div class="text-center">
                                    <h1 class="display-4">{{ (stats.sent / stats.total * 100)|round(1) }}%</h1>
                                    <p class="text-muted">Success Rate</p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="card h-100">
                            <div class="card-header">
                                <h5 class="mb-0">Top Templates</h5>
                            </div>
                            <div class="card-body p-0">
                                {% if templateStats|length > 0 %}
                                    <ul class="list-group list-group-flush">
                                        {% for stat in templateStats %}
                                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                                <div>
                                                    <a href="{{ path('email_log_template', {code: stat.template_code}) }}">
                                                        {{ stat.template_name ?? stat.template_code }}
                                                    </a>
                                                </div>
                                                <span class="badge bg-primary rounded-pill">{{ stat.count }}</span>
                                            </li>
                                        {% endfor %}
                                    </ul>
                                {% else %}
                                    <div class="p-3">No template data available</div>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>
            {% else %}
                <div class="alert alert-info">
                    <i class="fas fa-info-circle me-2"></i>
                    No email data available for this period.
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %} 