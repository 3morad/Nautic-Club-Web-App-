{% extends 'base.html.twig' %}

{% block title %}Email Logs for {{ user.email }}{% endblock %}

{% block body %}
<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Email Logs for User</h1>
        <a href="{{ path('email_log_index') }}" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i> Back to All Logs
        </a>
    </div>

    <div class="card mb-4">
        <div class="card-header bg-light">
            <h5 class="mb-0">User Information</h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <p><strong>Name:</strong> {{ user.fullName }}</p>
                    <p><strong>Email:</strong> {{ user.email }}</p>
                </div>
                <div class="col-md-6">
                    <p><strong>User ID:</strong> {{ user.id }}</p>
                    <p><strong>Total Emails:</strong> {{ logs|length }}</p>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header bg-light">
            <h5 class="mb-0">Email History</h5>
        </div>
        <div class="card-body p-0">
            {% if logs|length > 0 %}
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>ID</th>
                                <th>Template</th>
                                <th>Subject</th>
                                <th>Date Sent</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for log in logs %}
                                <tr>
                                    <td>{{ log.id }}</td>
                                    <td>
                                        <a href="{{ path('email_log_template', {code: log.emailTemplate}) }}">
                                            {{ log.emailTemplate }}
                                        </a>
                                    </td>
                                    <td>{{ log.subject }}</td>
                                    <td>{{ log.sentAt|date('Y-m-d H:i:s') }}</td>
                                    <td>
                                        {% if log.status == 'sent' %}
                                            <span class="badge bg-success">Sent</span>
                                        {% else %}
                                            <span class="badge bg-danger" title="{{ log.errorMessage }}">Failed</span>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% else %}
                <div class="alert alert-info m-3">
                    No email logs found for this user.
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %} 