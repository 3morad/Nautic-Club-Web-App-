{% extends 'base.html.twig' %}

{% block title %}Email Logs for Template{% endblock %}

{% block body %}
<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Email Logs for Template</h1>
        <a href="{{ path('email_log_index') }}" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i> Back to All Logs
        </a>
    </div>

    <div class="card mb-4">
        <div class="card-header bg-light">
            <h5 class="mb-0">Template Information</h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    {% if template %}
                        <p><strong>Name:</strong> {{ template.name }}</p>
                        <p><strong>Code:</strong> <code>{{ template.code }}</code></p>
                        <p><strong>Subject:</strong> {{ template.subject }}</p>
                    {% else %}
                        <p><strong>Template Code:</strong> <code>{{ templateCode }}</code></p>
                        <div class="alert alert-warning">
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            Template details not available. It may have been deleted.
                        </div>
                    {% endif %}
                </div>
                <div class="col-md-6">
                    <p><strong>Total Emails:</strong> {{ logs|length }}</p>
                    {% if template %}
                        <p><strong>Category:</strong> {{ template.category }}</p>
                        <div class="mt-3">
                            <a href="{{ path('email_template_edit', {id: template.id}) }}" class="btn btn-sm btn-outline-primary me-2">
                                <i class="fas fa-edit me-1"></i> Edit Template
                            </a>
                            <a href="{{ path('email_template_preview', {id: template.id}) }}" class="btn btn-sm btn-outline-info" target="_blank">
                                <i class="fas fa-eye me-1"></i> Preview Template
                            </a>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header bg-light">
            <h5 class="mb-0">Email History</h5>
        </div>
        <div class="card-body p-0">
            {% if logs|length > 0 %}
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>ID</th>
                                <th>Recipient</th>
                                <th>Subject</th>
                                <th>Date Sent</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for log in logs %}
                                <tr>
                                    <td>{{ log.id }}</td>
                                    <td>
                                        <a href="{{ path('email_log_user', {id: log.user.id}) }}">
                                            {{ log.user.email }}
                                        </a>
                                    </td>
                                    <td>{{ log.subject }}</td>
                                    <td>{{ log.sentAt|date('Y-m-d H:i:s') }}</td>
                                    <td>
                                        {% if log.status == 'sent' %}
                                            <span class="badge bg-success">Sent</span>
                                        {% else %}
                                            <span class="badge bg-danger" title="{{ log.errorMessage }}">Failed</span>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% else %}
                <div class="alert alert-info m-3">
                    No email logs found for this template.
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %} 