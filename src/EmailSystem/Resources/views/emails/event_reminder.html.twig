<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Upcoming Event Reminder</title>
    <style>
        body { 
            font-family: Arial, sans-serif;
            line-height: 1.6;
            color: #333;
            max-width: 600px;
            margin: 0 auto;
            padding: 20px;
        }
        .header {
            background-color: #6D28D9;
            color: white;
            padding: 20px;
            text-align: center;
            border-radius: 5px 5px 0 0;
        }
        .content {
            padding: 20px;
            background-color: #F9FAFB;
            border: 1px solid #E5E7EB;
        }
        .footer {
            padding: 15px;
            text-align: center;
            font-size: 12px;
            color: #6B7280;
            background-color: #F3F4F6;
            border-radius: 0 0 5px 5px;
        }
        .button {
            display: inline-block;
            padding: 10px 20px;
            background-color: #6D28D9;
            color: white;
            text-decoration: none;
            border-radius: 5px;
            margin: 20px 0;
        }
        .event-details {
            background-color: #FFFFFF;
            border: 1px solid #E5E7EB;
            border-radius: 5px;
            padding: 15px;
            margin: 20px 0;
        }
        .event-details h3 {
            margin-top: 0;
            color: #6D28D9;
        }
        .event-details p {
            margin: 5px 0;
        }
        .event-image {
            width: 100%;
            max-height: 250px;
            object-fit: cover;
            border-radius: 5px;
            margin-bottom: 15px;
        }
    </style>
</head>
<body>
    <div class="header">
        <h1>Event Reminder</h1>
    </div>
    
    <div class="content">
        <h2>Hello {{ recipient.firstName }},</h2>
        
        <p>This is a friendly reminder that you're registered for an upcoming event!</p>
        
        <div class="event-details">
            <h3>{{ event.name }}</h3>
            
            {% if event.imageUrl %}
                <img src="{{ event.imageUrl }}" alt="{{ event.name }}" class="event-image">
            {% endif %}
            
            <p><strong>Date & Time:</strong> {{ event.date|date('F d, Y') }} at {{ event.date|date('g:i A') }}</p>
            <p><strong>Location:</strong> {{ event.location }}</p>
            
            {% if event.description %}
                <p>{{ event.description|nl2br }}</p>
            {% endif %}
            
            <p><strong>Your Registration:</strong> {{ registration.quantity }} ticket(s)</p>
        </div>
        
        <h3>What to bring:</h3>
        <ul>
            <li>Your ticket (digital or printed)</li>
            <li>Photo ID</li>
            <li>Appropriate clothing for the weather</li>
            <li>Any equipment mentioned in the event details</li>
        </ul>
        
        <div style="text-align: center;">
            <a href="{{ view_registration_url|default('#') }}" class="button">View My Registration</a>
        </div>
        
        <p>If you need to cancel or modify your registration, please do so at least 48 hours before the event.</p>
        
        <p>
            We look forward to seeing you!<br>
            The Nautic Club Team
        </p>
    </div>
    
    <div class="footer">
        <p>© {{ current_year }} Nautic Club. All rights reserved.</p>
        <p>123 Ocean Drive, Beach City | <a href="mailto:info@nauticclub.com">info@nauticclub.com</a> | +1 234 567 890</p>
    </div>
</body>
</html> 