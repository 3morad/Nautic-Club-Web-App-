{% extends 'admin/base.html.twig' %}

{% block title %}Edit Email Template{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
    .form-container {
        background-color: #fff;
        border-radius: 1rem;
        box-shadow: 0 0.5rem 1.5rem rgba(0, 0, 0, 0.1);
        margin-bottom: 2rem;
    }
    
    .title-section {
        padding: 1.5rem 2rem;
        border-bottom: 1px solid #e3e6f0;
        background: linear-gradient(to right, #f8f9fc, #fff);
    }
    
    .title-section h1 {
        margin: 0;
        font-weight: 700;
        color: #4e73df;
        display: flex;
        align-items: center;
    }
    
    .title-section h1 i {
        margin-right: 0.75rem;
        font-size: 1.25rem;
    }
    
    .form-section {
        padding: 2rem;
    }
    
    .form-control, .form-select {
        border-radius: 0.5rem;
        padding: 0.75rem 1rem;
        border: 1px solid #e3e6f0;
        font-size: 0.95rem;
        transition: all 0.2s;
    }
    
    .form-control:focus, .form-select:focus {
        border-color: #bac8f3;
        box-shadow: 0 0 0 0.25rem rgba(78, 115, 223, 0.25);
    }
    
    .action-btns {
        display: flex;
        gap: 0.5rem;
    }
    
    .action-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.6rem 1.25rem;
        border-radius: 0.5rem;
        font-weight: 600;
        transition: all 0.3s;
    }
    
    .action-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
    }
    
    .action-btn.primary {
        background: linear-gradient(135deg, #4e73df 0%, #3a5ccc 100%);
        border: none;
        color: white;
    }
    
    .action-btn.secondary {
        background: white;
        border: 1px solid #d1d3e2;
        color: #6e707e;
    }
    
    .action-btn.warning {
        background: #f6c23e;
        border: none;
        color: white;
    }
    
    .form-label {
        font-weight: 600;
        margin-bottom: 0.5rem;
        color: #5a5c69;
    }
    
    .required-field::after {
        content: '*';
        color: #e74a3b;
        margin-left: 0.25rem;
    }
    
    .field-group {
        margin-bottom: 1.5rem;
    }
    
    .helper-text {
        color: #858796;
        font-size: 0.85rem;
        margin-top: 0.5rem;
    }
    
    .code-block {
        background-color: #f8f9fc;
        border-radius: 0.5rem;
        padding: 1.25rem;
        margin: 1rem 0;
        border-left: 4px solid #4e73df;
    }
    
    .code-highlight {
        background-color: rgba(78, 115, 223, 0.1);
        padding: 0.2rem 0.4rem;
        border-radius: 0.25rem;
        color: #4e73df;
        font-family: monospace;
        font-size: 0.9rem;
        border: 1px solid rgba(78, 115, 223, 0.2);
    }
    
    .variables-section {
        background-color: #f1f7ff;
        border-radius: 0.75rem;
        padding: 1.5rem;
        margin-bottom: 1.5rem;
        border: 1px solid rgba(78, 115, 223, 0.2);
    }
    
    .variables-section h5 {
        color: #4e73df;
        font-weight: 700;
        margin-bottom: 1rem;
        display: flex;
        align-items: center;
    }
    
    .variables-section h5 i {
        margin-right: 0.5rem;
    }
    
    .variable-list {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 0.75rem;
    }
    
    .variable-item {
        display: flex;
        align-items: center;
        background: white;
        padding: 0.6rem 1rem;
        border-radius: 0.5rem;
        border: 1px solid rgba(78, 115, 223, 0.15);
        transition: all 0.2s;
    }
    
    .variable-item:hover {
        transform: translateY(-2px);
        box-shadow: 0 0.25rem 0.75rem rgba(0, 0, 0, 0.05);
        border-color: #4e73df;
    }
    
    .alert {
        border-radius: 0.5rem;
        padding: 1rem 1.25rem;
    }
    
    .alert-info {
        background-color: #e1f0ff;
        border-color: #bbd9ff;
        color: #3a70d1;
    }
    
    .back-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 1rem;
        font-weight: 600;
        color: #5a5c69;
        transition: all 0.2s;
    }
    
    .back-btn:hover {
        color: #4e73df;
        transform: translateX(-3px);
    }
    
    @media (max-width: 768px) {
        .variable-list {
            grid-template-columns: 1fr;
        }
    }
</style>
{% endblock %}

{% block body %}
<div class="container-fluid px-4 py-4">
    <a href="{{ path('email_template_index') }}" class="back-btn">
        <i class="fas fa-arrow-left"></i> Back to Templates
    </a>
    
    <div class="form-container">
        <div class="title-section d-flex justify-content-between align-items-center">
            <h1><i class="fas fa-envelope-open-text"></i> Edit Email Template</h1>
            <div class="action-btns">
                <a href="{{ path('email_template_preview', {id: template.id}) }}" class="action-btn warning" target="_blank">
                    <i class="fas fa-eye"></i> Preview
                </a>
            </div>
        </div>
        
        <div class="form-section">
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ label }} alert-dismissible fade show mb-4">
                        {% if label == 'success' %}<i class="fas fa-check-circle me-2"></i>{% endif %}
                        {% if label == 'error' %}<i class="fas fa-exclamation-circle me-2"></i>{% endif %}
                        {{ message }}
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                {% endfor %}
            {% endfor %}
            
            <form method="post" action="{{ path('email_template_edit', {id: template.id}) }}">
                <div class="row">
                    <div class="col-md-6">
                        <div class="field-group">
                            <label class="form-label">Template Code</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="fas fa-code"></i></span>
                                <input type="text" class="form-control" value="{{ template.code }}" readonly>
                            </div>
                            <p class="helper-text">
                                <i class="fas fa-info-circle me-1"></i> Template code cannot be changed after creation.
                            </p>
                        </div>
                    </div>
                    
                    <div class="col-md-6">
                        <div class="field-group">
                            <label for="category" class="form-label required-field">Category</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="fas fa-tag"></i></span>
                                <select id="category" name="category" class="form-select" required>
                                    <option value="general" {% if template.category == 'general' %}selected{% endif %}>General</option>
                                    <option value="notifications" {% if template.category == 'notifications' %}selected{% endif %}>Notifications</option>
                                    <option value="marketing" {% if template.category == 'marketing' %}selected{% endif %}>Marketing</option>
                                    <option value="events" {% if template.category == 'events' %}selected{% endif %}>Events</option>
                                    <option value="system" {% if template.category == 'system' %}selected{% endif %}>System</option>
                                </select>
                            </div>
                            <p class="helper-text">
                                <i class="fas fa-info-circle me-1"></i> Used for organizing and filtering templates.
                            </p>
                        </div>
                    </div>
                </div>
                
                <div class="field-group">
                    <label for="name" class="form-label required-field">Template Name</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="fas fa-font"></i></span>
                        <input type="text" id="name" name="name" class="form-control" value="{{ template.name }}" required>
                    </div>
                    <p class="helper-text">
                        <i class="fas fa-info-circle me-1"></i> A descriptive name for identifying this template.
                    </p>
                </div>
                
                <div class="field-group">
                    <label for="subject" class="form-label required-field">Email Subject</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="fas fa-heading"></i></span>
                        <input type="text" id="subject" name="subject" class="form-control" value="{{ template.subject }}" required>
                    </div>
                    <p class="helper-text">
                        <i class="fas fa-info-circle me-1"></i> The subject line of the email. You can use template variables here.
                    </p>
                </div>
                
                <div class="field-group">
                    <label for="view_name" class="form-label required-field">View Template Name</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="fas fa-file-code"></i></span>
                        <input type="text" id="view_name" name="view_name" class="form-control" value="{{ template.viewName }}" required>
                    </div>
                    <p class="helper-text">
                        <i class="fas fa-info-circle me-1"></i> Name of the template file without extension (e.g. <span class="code-highlight">welcome</span> for "welcome.html.twig").
                    </p>
                </div>
                
                <div class="field-group">
                    <label for="description" class="form-label">Description</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="fas fa-align-left"></i></span>
                        <textarea id="description" name="description" class="form-control" rows="3">{{ template.description }}</textarea>
                    </div>
                    <p class="helper-text">
                        <i class="fas fa-info-circle me-1"></i> Optional description for internal use.
                    </p>
                </div>
                
                <div class="variables-section">
                    <h5><i class="fas fa-code"></i> Available Template Variables</h5>
                    <p class="mb-3">Use these variables in your template to personalize content:</p>
                    
                    <div class="variable-list">
                        <div class="variable-item">
                            <span class="code-highlight me-2">{{ '{{ recipient.firstName }}' }}</span>
                            <span class="text-muted">User's first name</span>
                        </div>
                        <div class="variable-item">
                            <span class="code-highlight me-2">{{ '{{ recipient.lastName }}' }}</span>
                            <span class="text-muted">User's last name</span>
                        </div>
                        <div class="variable-item">
                            <span class="code-highlight me-2">{{ '{{ recipient.email }}' }}</span>
                            <span class="text-muted">User's email</span>
                        </div>
                        <div class="variable-item">
                            <span class="code-highlight me-2">{{ '{{ app_name }}' }}</span>
                            <span class="text-muted">Application name</span>
                        </div>
                        <div class="variable-item">
                            <span class="code-highlight me-2">{{ '{{ current_year }}' }}</span>
                            <span class="text-muted">Current year</span>
                        </div>
                    </div>
                    
                    <div class="alert alert-info mt-3 mb-0">
                        <i class="fas fa-lightbulb me-2"></i> <strong>Tip:</strong> After updating the template, use the Preview button to check how it looks.
                    </div>
                </div>
                
                <div class="d-flex justify-content-between align-items-center mt-4">
                    <a href="{{ path('email_template_index') }}" class="action-btn secondary">
                        <i class="fas fa-times"></i> Cancel
                    </a>
                    <button type="submit" class="action-btn primary">
                        <i class="fas fa-save"></i> Update Template
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %} 