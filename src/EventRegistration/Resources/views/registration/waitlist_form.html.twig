{% extends 'base.html.twig' %}

{% block title %}Join Waitlist for {{ event.name }}{% endblock %}

{% block body %}
<div class="container mx-auto px-4 py-8">
    <div class="flex justify-between items-center mb-6">
        <h1 class="text-3xl font-bold text-purple-600 flex items-center">
            <i class="fas fa-clock mr-3"></i>Join Waitlist for {{ event.name }}
        </h1>
        <a href="{{ path('simple_event_show', {'id': event.id}) }}" class="bg-gray-600 hover:bg-gray-700 text-white font-bold py-2 px-4 rounded-lg shadow transition duration-300 flex items-center">
            <i class="fas fa-arrow-left mr-2"></i>Back to Event
        </a>
    </div>

    {% for message in app.flashes('success') %}
        <div class="bg-green-100 border-l-4 border-green-500 text-green-700 p-4 mb-6 rounded-md" role="alert">
            <p class="font-medium">{{ message }}</p>
        </div>
    {% endfor %}
    
    {% for message in app.flashes('error') %}
        <div class="bg-red-100 border-l-4 border-red-500 text-red-700 p-4 mb-6 rounded-md" role="alert">
            <p class="font-medium">{{ message }}</p>
        </div>
    {% endfor %}
    
    {% for message in app.flashes('info') %}
        <div class="bg-blue-100 border-l-4 border-blue-500 text-blue-700 p-4 mb-6 rounded-md" role="alert">
            <p class="font-medium">{{ message }}</p>
        </div>
    {% endfor %}

    <div class="bg-yellow-50 border-l-4 border-yellow-400 p-4 mb-6 rounded-md" role="alert">
        <div class="flex">
            <div class="flex-shrink-0">
                <i class="fas fa-exclamation-circle text-yellow-400 text-lg mt-0.5"></i>
            </div>
            <div class="ml-3">
                <p class="text-sm text-yellow-700">
                    This event is currently at full capacity. You can join the waitlist, and we'll notify you if a spot becomes available.
                </p>
            </div>
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Event Details (Left Column) -->
        <div class="md:col-span-1">
            <div class="bg-white rounded-lg shadow-lg overflow-hidden">
                <div class="p-6">
                    <h2 class="text-xl font-semibold text-gray-800 mb-4">Event Details</h2>
                    
                    {% if event.imageFilename %}
                        <div class="mb-4">
                            <img src="{{ asset('uploads/events/' ~ event.imageFilename) }}" alt="{{ event.name }}" class="w-full h-auto rounded-md">
                        </div>
                    {% endif %}
                    
                    <div class="space-y-4">
                        <div>
                            <h3 class="font-medium text-gray-700">Event</h3>
                            <p class="text-xl font-semibold">{{ event.name }}</p>
                        </div>
                        
                        <div>
                            <h3 class="font-medium text-gray-700">Date & Time</h3>
                            <p>{{ event.eventDate|date('F d, Y \\a\\t g:i A') }}</p>
                        </div>
                        
                        <div>
                            <h3 class="font-medium text-gray-700">Location</h3>
                            <p>{{ event.locationWeather.name }}, {{ event.locationWeather.region }}</p>
                        </div>
                        
                        <div>
                            <h3 class="font-medium text-gray-700">Price</h3>
                            <p class="text-xl font-bold text-purple-600">
                                {% if event.price %}
                                    ${{ event.price|number_format(2) }}
                                {% else %}
                                    Free
                                {% endif %}
                            </p>
                        </div>
                        
                        <div>
                            <h3 class="font-medium text-gray-700">Status</h3>
                            <p class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">
                                <i class="fas fa-users-slash mr-1"></i> Fully Booked
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Waitlist Form (Right Column) -->
        <div class="md:col-span-2">
            <div class="bg-white rounded-lg shadow-lg overflow-hidden">
                <div class="p-6">
                    <h2 class="text-xl font-semibold text-gray-800 mb-4">Join the Waitlist</h2>
                    
                    <div class="bg-blue-50 p-4 rounded-md mb-6">
                        <h3 class="font-medium text-blue-700 flex items-center mb-2">
                            <i class="fas fa-info-circle mr-2"></i>How the Waitlist Works
                        </h3>
                        <ul class="list-disc pl-5 text-blue-700 space-y-1">
                            <li>You'll be added to the waitlist in the order of registration.</li>
                            <li>If a spot becomes available (due to a cancellation), we'll automatically move you from the waitlist.</li>
                            <li>You'll receive an email notification if you're moved from the waitlist.</li>
                            <li>Being on the waitlist does not guarantee entry to the event.</li>
                        </ul>
                    </div>
                    
                    <form method="post" action="{{ path('event_registration_register', {'id': event.id}) }}">
                        <div class="mb-4">
                            <label for="quantity" class="block text-gray-700 font-medium mb-2">Number of Tickets</label>
                            <select id="quantity" name="quantity" class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-purple-500">
                                {% for i in 1..3 %}
                                    <option value="{{ i }}">{{ i }}</option>
                                {% endfor %}
                            </select>
                            <p class="text-sm text-gray-500 mt-1">Maximum 3 tickets per waitlist registration. Smaller groups have a higher chance of being accommodated.</p>
                        </div>
                        
                        <div class="mb-6">
                            <label for="notes" class="block text-gray-700 font-medium mb-2">Special Requests or Notes</label>
                            <textarea id="notes" name="notes" rows="3" class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-purple-500"></textarea>
                            <p class="text-sm text-gray-500 mt-1">Optional: Any dietary requirements, accessibility needs, or other notes</p>
                        </div>
                        
                        <!-- Terms and Conditions -->
                        <div class="mb-6">
                            <div class="flex items-start">
                                <div class="flex items-center h-5">
                                    <input id="terms" name="terms" type="checkbox" required class="focus:ring-purple-500 h-4 w-4 text-purple-600 border-gray-300 rounded">
                                </div>
                                <div class="ml-3 text-sm">
                                    <label for="terms" class="font-medium text-gray-700">I understand the waitlist policy</label>
                                    <p class="text-gray-500">By joining the waitlist, you agree to be notified if a spot becomes available, with no guarantee of entry.</p>
                                </div>
                            </div>
                        </div>
                        
                        <div class="flex justify-end">
                            <button type="submit" class="bg-yellow-500 hover:bg-yellow-600 text-white font-bold py-2 px-6 rounded-lg shadow transition duration-300 flex items-center">
                                <i class="fas fa-clock mr-2"></i>Join Waitlist
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %} 