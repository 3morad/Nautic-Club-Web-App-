{% extends 'base.html.twig' %}

{% block title %}Register for {{ event.name }}{% endblock %}

{% block body %}
<div class="container mx-auto px-4 py-8">
    <div class="flex justify-between items-center mb-6">
        <h1 class="text-3xl font-bold text-purple-600 flex items-center">
            <i class="fas fa-ticket-alt mr-3"></i>Register for {{ event.name }}
        </h1>
        <a href="{{ path('simple_event_show', {'id': event.id}) }}" class="bg-gray-600 hover:bg-gray-700 text-white font-bold py-2 px-4 rounded-lg shadow transition duration-300 flex items-center">
            <i class="fas fa-arrow-left mr-2"></i>Back to Event
        </a>
    </div>

    {% for message in app.flashes('success') %}
        <div class="bg-green-100 border-l-4 border-green-500 text-green-700 p-4 mb-6 rounded-md" role="alert">
            <p class="font-medium">{{ message }}</p>
        </div>
    {% endfor %}
    
    {% for message in app.flashes('error') %}
        <div class="bg-red-100 border-l-4 border-red-500 text-red-700 p-4 mb-6 rounded-md" role="alert">
            <p class="font-medium">{{ message }}</p>
        </div>
    {% endfor %}

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Event Details (Left Column) -->
        <div class="md:col-span-1">
            <div class="bg-white rounded-lg shadow-lg overflow-hidden">
                <div class="p-6">
                    <h2 class="text-xl font-semibold text-gray-800 mb-4">Event Details</h2>
                    
                    {% if event.imageFilename %}
                        <div class="mb-4">
                            <img src="{{ asset('uploads/events/' ~ event.imageFilename) }}" alt="{{ event.name }}" class="w-full h-auto rounded-md">
                        </div>
                    {% endif %}
                    
                    <div class="space-y-4">
                        <div>
                            <h3 class="font-medium text-gray-700">Event</h3>
                            <p class="text-xl font-semibold">{{ event.name }}</p>
                        </div>
                        
                        <div>
                            <h3 class="font-medium text-gray-700">Date & Time</h3>
                            <p>{{ event.eventDate|date('F d, Y \\a\\t g:i A') }}</p>
                        </div>
                        
                        <div>
                            <h3 class="font-medium text-gray-700">Location</h3>
                            <p>{{ event.locationWeather.name }}, {{ event.locationWeather.region }}</p>
                        </div>
                        
                        <div>
                            <h3 class="font-medium text-gray-700">Price</h3>
                            <p class="text-xl font-bold text-purple-600">
                                {% if event.price %}
                                    ${{ event.price|number_format(2) }}
                                {% else %}
                                    Free
                                {% endif %}
                            </p>
                        </div>
                        
                        <div>
                            <h3 class="font-medium text-gray-700">Availability</h3>
                            {% if event.capacity %}
                                <p>{{ event.availableSpots }}/{{ event.capacity }} spots available</p>
                                <div class="w-full bg-gray-200 rounded-full h-2.5 mt-2">
                                    {% set percentFilled = (1 - (event.availableSpots / event.capacity)) * 100 %}
                                    <div class="bg-purple-600 h-2.5 rounded-full" style="width: {{ percentFilled }}%"></div>
                                </div>
                            {% else %}
                                <p>Unlimited spots available</p>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Registration Form (Right Column) -->
        <div class="md:col-span-2">
            <div class="bg-white rounded-lg shadow-lg overflow-hidden">
                <div class="p-6">
                    <h2 class="text-xl font-semibold text-gray-800 mb-4">Registration Form</h2>
                    
                    <form method="post" action="{{ path('event_registration_register', {'id': event.id}) }}">
                        <div class="mb-4">
                            <label for="quantity" class="block text-gray-700 font-medium mb-2">Number of Tickets</label>
                            <select id="quantity" name="quantity" class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-purple-500">
                                {% for i in 1..10 %}
                                    {% if event.capacity is null or i <= event.availableSpots %}
                                        <option value="{{ i }}">{{ i }}</option>
                                    {% endif %}
                                {% endfor %}
                            </select>
                            <p class="text-sm text-gray-500 mt-1">Maximum 10 tickets per registration</p>
                        </div>
                        
                        <div class="mb-6">
                            <label for="notes" class="block text-gray-700 font-medium mb-2">Special Requests or Notes</label>
                            <textarea id="notes" name="notes" rows="3" class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-purple-500"></textarea>
                            <p class="text-sm text-gray-500 mt-1">Optional: Any dietary requirements, accessibility needs, or other notes</p>
                        </div>
                        
                        <!-- Price Calculation -->
                        {% if event.price %}
                            <div class="bg-gray-50 p-4 rounded-md mb-6">
                                <h3 class="font-medium text-gray-700 mb-2">Price Breakdown</h3>
                                <div class="flex justify-between mb-1">
                                    <span>Event Price</span>
                                    <span>${{ event.price|number_format(2) }}</span>
                                </div>
                                <div class="flex justify-between mb-1">
                                    <span>Processing Fee (5%)</span>
                                    <span>${{ (event.price * 0.05)|number_format(2) }}</span>
                                </div>
                                <div class="flex justify-between mb-1 text-sm text-gray-500">
                                    <span>Per Ticket Total</span>
                                    <span>${{ (event.price + (event.price * 0.05))|number_format(2) }}</span>
                                </div>
                                <div class="border-t border-gray-300 my-2"></div>
                                <div class="flex justify-between font-bold">
                                    <span>Total (<span id="ticket-count">1</span> ticket<span id="plural">s</span>)</span>
                                    <span id="total-price">${{ (event.price + (event.price * 0.05))|number_format(2) }}</span>
                                </div>
                            </div>
                        {% endif %}
                        
                        <!-- Terms and Conditions -->
                        <div class="mb-6">
                            <div class="flex items-start">
                                <div class="flex items-center h-5">
                                    <input id="terms" name="terms" type="checkbox" required class="focus:ring-purple-500 h-4 w-4 text-purple-600 border-gray-300 rounded">
                                </div>
                                <div class="ml-3 text-sm">
                                    <label for="terms" class="font-medium text-gray-700">I agree to the Terms and Conditions</label>
                                    <p class="text-gray-500">By registering, you agree to the refund policy and event terms.</p>
                                </div>
                            </div>
                        </div>
                        
                        <div class="flex justify-end">
                            <button type="submit" class="bg-purple-600 hover:bg-purple-700 text-white font-bold py-2 px-6 rounded-lg shadow transition duration-300 flex items-center">
                                <i class="fas fa-ticket-alt mr-2"></i>
                                {% if event.price %}Complete Registration & Proceed to Payment{% else %}Complete Registration{% endif %}
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

{% if event.price %}
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const quantitySelect = document.getElementById('quantity');
        const ticketCount = document.getElementById('ticket-count');
        const pluralSpan = document.getElementById('plural');
        const totalPrice = document.getElementById('total-price');
        const basePrice = {{ event.price + (event.price * 0.05) }};
        
        quantitySelect.addEventListener('change', function() {
            const quantity = parseInt(this.value);
            ticketCount.textContent = quantity;
            pluralSpan.style.display = quantity === 1 ? 'none' : 'inline';
            totalPrice.textContent = '$' + (basePrice * quantity).toFixed(2);
        });
        
        // Initialize with default value
        pluralSpan.style.display = quantitySelect.value === '1' ? 'none' : 'inline';
    });
</script>
{% endif %}
{% endblock %} 