{% extends 'base.html.twig' %}

{% block title %}Payment Cancelled{% endblock %}

{% block body %}
<div class="container mx-auto px-4 py-8">
    <div class="max-w-lg mx-auto bg-white shadow-md rounded-lg overflow-hidden p-6 text-center">
        <div class="rounded-full bg-red-100 h-20 w-20 flex items-center justify-center mx-auto mb-6">
            <i class="fas fa-times text-4xl text-red-500"></i>
        </div>
        
        <h1 class="text-2xl font-bold text-gray-800 mb-4">Payment Cancelled</h1>
        
        <p class="text-gray-600 mb-6">
            Your payment has been cancelled. No charges have been made to your account.
        </p>
        
        <div class="flex justify-center space-x-4">
            <a href="{{ path('payment_page') }}" class="bg-purple-600 hover:bg-purple-700 text-white px-6 py-3 rounded-md">
                Try Again
            </a>
            <a href="{{ path('ticket_index') }}" class="bg-gray-200 hover:bg-gray-300 text-gray-800 px-6 py-3 rounded-md">
                Return to My Tickets
            </a>
        </div>
    </div>
</div>
{% endblock %} 