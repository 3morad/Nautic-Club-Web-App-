{% extends 'base.html.twig' %}

{% block title %}E-Ticket - {{ ticket.eventName }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        @media print {
            body * {
                visibility: hidden;
            }
            .printable-ticket, .printable-ticket * {
                visibility: visible;
            }
            .printable-ticket {
                position: absolute;
                left: 0;
                top: 0;
                width: 100%;
            }
            .no-print {
                display: none !important;
            }
        }
        
        .printable-ticket {
            max-width: 800px;
            margin: 0 auto;
            padding: 2rem;
            background: white;
            border-radius: 12px;
            box-shadow: 0 0 20px rgba(0, 0, 0, 0.1);
        }
        
        .event-header {
            background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
            color: white;
            padding: 2rem;
            border-radius: 8px 8px 0 0;
            position: relative;
            overflow: hidden;
        }
        
        .event-header::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: url('https://images.unsplash.com/photo-1501426026826-31c667bdf23d') center/cover;
            opacity: 0.1;
            mix-blend-mode: overlay;
        }
        
        .ticket-body {
            padding: 2rem;
            border: 1px solid #e5e7eb;
            border-top: none;
            border-radius: 0 0 8px 8px;
        }
        
        .ticket-info {
            display: flex;
            flex-wrap: wrap;
            margin-bottom: 2rem;
        }
        
        .ticket-info-item {
            flex: 1 1 50%;
            margin-bottom: 1rem;
        }
        
        .ticket-info-label {
            font-size: 0.875rem;
            color: #6b7280;
            margin-bottom: 0.25rem;
        }
        
        .ticket-info-value {
            font-size: 1.125rem;
            font-weight: 600;
            color: #1f2937;
        }
        
        .ticket-divider {
            height: 1px;
            background: linear-gradient(to right, transparent, #e5e7eb, transparent);
            margin: 2rem 0;
            position: relative;
        }
        
        .ticket-divider::before,
        .ticket-divider::after {
            content: '';
            position: absolute;
            width: 20px;
            height: 20px;
            border-radius: 50%;
            background: white;
            border: 1px solid #e5e7eb;
            top: 50%;
            transform: translate(-50%, -50%);
        }
        
        .ticket-divider::before {
            left: 0;
        }
        
        .ticket-divider::after {
            left: 100%;
        }
        
        .ticket-footer {
            text-align: center;
            padding-top: 1rem;
            border-top: 1px dashed #e5e7eb;
            color: #6b7280;
            font-size: 0.875rem;
        }
        
        .ticket-qr {
            display: flex;
            justify-content: center;
            margin: 2rem 0;
        }
        
        .print-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 0.75rem 1.5rem;
            background-color: #4f46e5;
            color: white;
            font-weight: 600;
            border-radius: 0.375rem;
            cursor: pointer;
            transition: background-color 0.2s;
            border: none;
            margin-top: 1rem;
        }
        
        .print-btn:hover {
            background-color: #4338ca;
        }
        
        .print-btn svg {
            margin-right: 0.5rem;
            width: 1.25rem;
            height: 1.25rem;
        }
        
        .actions {
            display: flex;
            gap: 1rem;
            margin-top: 2rem;
            justify-content: center;
        }
        
        .back-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 0.75rem 1.5rem;
            background-color: #9ca3af;
            color: white;
            font-weight: 600;
            border-radius: 0.375rem;
            cursor: pointer;
            transition: background-color 0.2s;
            text-decoration: none;
        }
        
        .back-btn:hover {
            background-color: #6b7280;
        }
    </style>
{% endblock %}

{% block body %}
<div class="container mx-auto px-4 py-8">
    <div class="printable-ticket">
        <div class="event-header">
            <h1 class="text-3xl font-bold mb-2">{{ ticket.eventName }}</h1>
            <p class="text-xl opacity-80">{{ ticket.eventDate|date('F d, Y') }}</p>
        </div>
        
        <div class="ticket-body">
            <div class="ticket-info">
                <div class="ticket-info-item">
                    <div class="ticket-info-label">Ticket Type</div>
                    <div class="ticket-info-value">{{ ticket.ticketType }}</div>
                </div>
                
                <div class="ticket-info-item">
                    <div class="ticket-info-label">Ticket ID</div>
                    <div class="ticket-info-value">#{{ ticket.id }}</div>
                </div>
                
                <div class="ticket-info-item">
                    <div class="ticket-info-label">Event Date</div>
                    <div class="ticket-info-value">{{ ticket.eventDate|date('M d, Y') }}</div>
                </div>
                
                <div class="ticket-info-item">
                    <div class="ticket-info-label">Price</div>
                    <div class="ticket-info-value">${{ ticket.price|number_format(2) }}</div>
                </div>
            </div>
            
            <div class="ticket-divider"></div>
            
            {% if qr_code_data_uri is defined and qr_code_data_uri is not null %}
                <div class="ticket-qr">
                    <img src="{{ qr_code_data_uri }}" alt="Ticket QR Code" width="200" height="200">
                </div>
            {% endif %}
            
            <div class="ticket-footer">
                <p>This ticket is your official admission document. Please present it at the event entrance.</p>
                <p>Generated on {{ "now"|date('F d, Y') }}</p>
            </div>
        </div>
    </div>
    
    <div class="actions no-print">
        <button onclick="window.print()" class="print-btn">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
            </svg>
            Print Ticket
        </button>
        
        <a href="{{ path('ticket_show', {'id': ticket.id}) }}" class="back-btn">
            Back to Ticket
        </a>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
{% endblock %} 