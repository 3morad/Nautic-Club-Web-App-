{% extends 'base.html.twig' %}

{% block title %}Payment Successful - Nautic Club{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .success-container {
            max-width: 600px;
            margin: 3rem auto;
        }
        
        .success-header {
            text-align: center;
            margin-bottom: 2rem;
        }
        
        .success-icon {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 4rem;
            height: 4rem;
            background-color: #ecfdf5;
            color: #10b981;
            border-radius: 50%;
            margin-bottom: 1rem;
            font-size: 2rem;
        }
        
        .ticket-card {
            background: white;
            border-radius: 16px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.1);
            overflow: hidden;
            position: relative;
        }
        
        .ticket-header {
            background: linear-gradient(135deg, #8b5cf6 0%, #6366f1 100%);
            color: white;
            padding: 1.5rem;
            text-align: center;
        }
        
        .ticket-body {
            padding: 1.5rem;
        }
        
        .qr-code {
            text-align: center;
            margin: 1.5rem 0;
        }
        
        .qr-code img {
            max-width: 200px;
            border: 8px solid white;
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        }
        
        .qr-placeholder {
            width: 200px;
            height: 200px;
            background-color: #f3f4f6;
            border: 8px solid white;
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
            display: flex;
            align-items: center;
            justify-content: center;
            flex-direction: column;
            margin: 0 auto;
        }
        
        .qr-placeholder i {
            font-size: 3rem;
            color: #6366f1;
            margin-bottom: 1rem;
        }
        
        .qr-placeholder-text {
            font-size: 0.9rem;
            color: #4b5563;
            text-align: center;
            padding: 0 1rem;
        }
        
        .ticket-info {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1rem;
            margin-bottom: 1.5rem;
        }
        
        .info-item {
            margin-bottom: 0.5rem;
        }
        
        .info-label {
            font-size: 0.875rem;
            color: #6b7280;
            margin-bottom: 0.25rem;
        }
        
        .info-value {
            font-weight: 600;
            color: #374151;
        }
        
        .action-button {
            display: inline-block;
            background: #8b5cf6;
            color: white;
            padding: 0.75rem 1.5rem;
            border-radius: 0.5rem;
            font-weight: 600;
            text-align: center;
            text-decoration: none;
            transition: background-color 0.2s;
        }
        
        .action-button:hover {
            background: #7c3aed;
        }
        
        .actions {
            text-align: center;
            margin-top: 2rem;
        }
        
        .stripe-badge {
            text-align: center;
            margin-top: 2rem;
        }
        
        .stripe-badge img {
            height: 32px;
        }
        
        .payment-details {
            margin-top: 2rem;
            border-top: 1px solid #e2e8f0;
            padding-top: 1.5rem;
        }
        
        .payment-details h3 {
            font-size: 1.25rem;
            font-weight: 600;
            margin-bottom: 1rem;
            color: #374151;
        }
    </style>
{% endblock %}

{% block body %}
<div class="success-container">
    <div class="success-header">
        <div class="success-icon">
            <i class="fas fa-check"></i>
        </div>
        <h1 class="text-3xl font-bold mb-2">Payment Successful</h1>
        <p class="text-gray-600">Thank you for your purchase!</p>
    </div>
    
    <div class="ticket-card">
        <div class="ticket-header">
            <h2 class="text-2xl font-bold">{{ ticket.eventName }}</h2>
        </div>
        
        <div class="ticket-body">
            <div class="qr-code">
                {% if transaction.qrCode %}
                    <img src="{{ transaction.qrCode }}" alt="Ticket QR Code" class="mx-auto">
                {% else %}
                    <div class="qr-placeholder">
                        <i class="fas fa-qrcode"></i>
                        <div class="qr-placeholder-text">Ticket code: {{ 'NAUTIC-' ~ ticket.id ~ '-' ~ transaction.id }}</div>
                    </div>
                {% endif %}
                <p class="text-sm text-gray-500 mt-2">Scan this code at the entrance</p>
            </div>
            
            <div class="ticket-info">
                <div class="info-item">
                    <div class="info-label">Ticket Type</div>
                    <div class="info-value">{{ ticket.ticketType }}</div>
                </div>
                
                <div class="info-item">
                    <div class="info-label">Price</div>
                    <div class="info-value">${{ ticket.price|number_format(2) }}</div>
                </div>
                
                <div class="info-item">
                    <div class="info-label">Date</div>
                    <div class="info-value">{{ ticket.eventDate|date('M d, Y') }}</div>
                </div>
                
                <div class="info-item">
                    <div class="info-label">Time</div>
                    <div class="info-value">{{ ticket.eventDate|date('g:i A') }}</div>
                </div>
                
                <div class="info-item">
                    <div class="info-label">Transaction ID</div>
                    <div class="info-value">#{{ transaction.id }}</div>
                </div>
                
                <div class="info-item">
                    <div class="info-label">Payment Method</div>
                    <div class="info-value">{{ transaction.paymentMethod }}</div>
                </div>

                {% if transaction.cardLastFour %}
                <div class="info-item">
                    <div class="info-label">Card</div>
                    <div class="info-value">•••• •••• •••• {{ transaction.cardLastFour }}</div>
                </div>
                {% endif %}

                {% if transaction.gatewayReference %}
                <div class="info-item">
                    <div class="info-label">Payment Reference</div>
                    <div class="info-value">{{ transaction.gatewayReference }}</div>
                </div>
                {% endif %}
            </div>
            
            <div class="payment-details">
                <h3>Payment Information</h3>
                <p>Your payment has been processed securely through our payment gateway. A confirmation email has been sent to your registered email address.</p>
                
                {% if transaction.gatewayReference %}
                <div class="info-item mt-3">
                    <div class="info-label">Payment Status</div>
                    <div class="info-value">
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                            <i class="fas fa-check-circle mr-1"></i> Completed
                        </span>
                    </div>
                </div>
                <div class="info-item">
                    <div class="info-label">Payment ID</div>
                    <div class="info-value">{{ transaction.gatewayReference }}</div>
                </div>
                <div class="info-item">
                    <div class="info-label">Payment Date</div>
                    <div class="info-value">{{ transaction.createdAt|date('M d, Y H:i:s') }}</div>
                </div>
                {% endif %}
            </div>
            
            <div class="text-sm text-gray-500 text-center mt-4">
                <p>Please arrive 30 minutes before the event. This ticket is non-refundable.</p>
            </div>
            
            <div class="stripe-badge">
                <img src="https://b.stripecdn.com/site-srv/assets/Brewer/c2b29e49a09cf565ba48b9aacf2513c4/powered-by-stripe.png" alt="Powered by Stripe">
            </div>
        </div>
    </div>
    
    <div class="actions">
        <a href="{{ path('app_feedback_new') }}" class="action-button">
            <i class="far fa-comment-alt mr-2"></i> Share Your Feedback
        </a>
    </div>
    <div class="container mx-auto px-4 py-8">
    <div class="printable-ticket">
        <div class="event-header">
            <h1 class="text-3xl font-bold mb-2">{{ ticket.eventName }}</h1>
            <p class="text-xl opacity-80">{{ ticket.eventDate|date('F d, Y') }}</p>
        </div>
        
        <div class="ticket-body">
            <div class="ticket-info">
                <div class="ticket-info-item">
                    <div class="ticket-info-label">Ticket Type</div>
                    <div class="ticket-info-value">{{ ticket.ticketType }}</div>
                </div>
                
                <div class="ticket-info-item">
                    <div class="ticket-info-label">Ticket ID</div>
                    <div class="ticket-info-value">#{{ ticket.id }}</div>
                </div>
                
                <div class="ticket-info-item">
                    <div class="ticket-info-label">Event Date</div>
                    <div class="ticket-info-value">{{ ticket.eventDate|date('M d, Y') }}</div>
                </div>
                
                <div class="ticket-info-item">
                    <div class="ticket-info-label">Price</div>
                    <div class="ticket-info-value">${{ ticket.price|number_format(2) }}</div>
                </div>
            </div>
            
            <div class="ticket-divider"></div>
            
            {% if qr_code_data_uri is defined and qr_code_data_uri is not null %}
                <div class="ticket-qr">
                    <img src="{{ qr_code_data_uri }}" alt="Ticket QR Code" width="200" height="200">
                </div>
            {% endif %}
            
            <div class="ticket-footer">
                <p>This ticket is your official admission document. Please present it at the event entrance.</p>
                <p>Generated on {{ "now"|date('F d, Y') }}</p>
            </div>
        </div>
    </div>
    
    <div class="actions no-print">
        <button onclick="window.print()" class="print-btn">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
            </svg>
            Print Ticket
        </button>
        
        <a href="{{ path('ticket_show', {'id': ticket.id}) }}" class="back-btn">
            Back to Ticket
        </a>
    </div>
  </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Add any success page specific scripts here
        });
    </script>
{% endblock %} 

