{% extends 'base.html.twig' %}

{% block title %}Payment Successful - Nautic Club{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .ticket {
            background-color: white;
            border-radius: 0.75rem;
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
            overflow: hidden;
            position: relative;
        }
        .ticket:before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 0.25rem;
            background: linear-gradient(90deg, #6366f1, #8b5cf6);
        }
        .ticket-info {
            border-bottom: 1px dashed #e2e8f0;
        }
        .ticket-qr {
            width: 150px;
            height: 150px;
            margin: 0 auto;
            display: flex;
            align-items: center;
            justify-content: center;
            background-color: #f3f4f6;
            border-radius: 0.5rem;
        }
        .ticket-qr img {
            max-width: 100%;
            max-height: 100%;
        }
    </style>
{% endblock %}

{% block body %}
<div class="container mx-auto px-4 py-8">
    <div class="max-w-2xl mx-auto text-center">
        <div class="mb-8">
            <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-green-100 text-green-500 mb-4">
                <i class="fas fa-check-circle text-3xl"></i>
            </div>
            <h1 class="text-3xl font-bold mb-2">Payment Successful</h1>
            <p class="text-lg text-gray-600">Thank you for your purchase!</p>
        </div>
        
        <div class="ticket mb-8">
            <div class="ticket-info p-6">
                <h2 class="text-2xl font-bold mb-4">{{ ticket.eventName }}</h2>
                <div class="grid grid-cols-2 gap-4 mb-4">
                    <div class="text-left">
                        <p class="text-sm text-gray-500">Ticket Type</p>
                        <p class="font-semibold">{{ ticket.ticketType }}</p>
                    </div>
                    <div class="text-right">
                        <p class="text-sm text-gray-500">Price</p>
                        <p class="font-semibold">${{ ticket.price|number_format(2) }}</p>
                    </div>
                </div>
                <div class="grid grid-cols-2 gap-4">
                    <div class="text-left">
                        <p class="text-sm text-gray-500">Date</p>
                        <p class="font-semibold">{{ ticket.eventDate|date('M d, Y') }}</p>
                    </div>
                    <div class="text-right">
                        <p class="text-sm text-gray-500">Time</p>
                        <p class="font-semibold">{{ ticket.eventDate|date('g:i A') }}</p>
                    </div>
                </div>
            </div>
            
            <div class="p-6">
                <p class="text-sm text-gray-500 mb-4 text-center">Transaction ID: {{ transaction.id }}</p>
                <div class="ticket-qr mb-4">
                    <!-- In a real app, replace with actual QR code -->
                    <img src="https://api.qrserver.com/v1/create-qr-code/?size=150x150&data={{ transaction.qrCode }}" alt="QR Code">
                </div>
                <p class="text-sm text-gray-500 text-center">Please present this QR code at the event entrance</p>
            </div>
        </div>
        
        <div class="flex flex-col md:flex-row justify-center gap-4">
            <a href="{{ path('app_home') }}" class="px-6 py-3 bg-gray-600 text-white rounded-lg font-medium hover:bg-gray-700">
                <i class="fas fa-home mr-2"></i>Return to Home
            </a>
            <button onclick="window.print()" class="px-6 py-3 bg-purple-600 text-white rounded-lg font-medium hover:bg-purple-700">
                <i class="fas fa-print mr-2"></i>Print Ticket
            </button>
        </div>
    </div>
    
    <div class="mt-12 max-w-md mx-auto">
        <h3 class="text-xl font-bold mb-4">Need Help?</h3>
        <p class="text-gray-600 mb-4">If you have any questions about your ticket, please contact our customer service:</p>
        <div class="flex items-center text-gray-700 mb-2">
            <i class="fas fa-envelope mr-2"></i>
            <span>support@nauticclub.com</span>
        </div>
        <div class="flex items-center text-gray-700">
            <i class="fas fa-phone-alt mr-2"></i>
            <span>+1 (555) 123-4567</span>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Add any success page specific scripts here
        });
    </script>
{% endblock %} 