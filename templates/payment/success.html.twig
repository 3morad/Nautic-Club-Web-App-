{% extends 'base.html.twig' %}

{% block title %}Payment Successful{% endblock %}

{% block body %}
<div class="container mx-auto px-4 py-8">
    <div class="max-w-lg mx-auto bg-white shadow-md rounded-lg overflow-hidden p-6 text-center">
        <div class="rounded-full bg-green-100 h-20 w-20 flex items-center justify-center mx-auto mb-6">
            <i class="fas fa-check text-4xl text-green-500"></i>
        </div>
        
        <h1 class="text-2xl font-bold text-gray-800 mb-4">Payment Successful!</h1>
        
        <p class="text-gray-600 mb-6">
            Thank you for your purchase! Your ticket has been confirmed and added to your account.
        </p>
        
        <div class="bg-gray-50 p-4 rounded-lg mb-6">
            <p class="text-sm text-gray-500 mb-1">Confirmation Number</p>
            <p class="font-medium text-gray-800">TKT-{{ "now"|date("Ymd") }}-{{ random(1000, 9999) }}</p>
        </div>
        
        <div class="flex justify-center space-x-4">
            <a href="{{ path('ticket_index') }}" class="bg-purple-600 hover:bg-purple-700 text-white px-6 py-3 rounded-md">
                View My Tickets
            </a>
            <a href="{{ path('payment_page') }}" class="bg-gray-200 hover:bg-gray-300 text-gray-800 px-6 py-3 rounded-md">
                Book Another Ticket
            </a>
        </div>
    </div>
</div>
{% endblock %} 