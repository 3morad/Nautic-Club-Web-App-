{% extends 'base.html.twig' %}

{% block title %}Book Tickets{% endblock %}

{% block body %}
<div class="container mx-auto px-4 py-8">
    <h1 class="text-3xl font-bold text-gray-800 mb-6">Book Event Tickets</h1>
    
    <div class="bg-white shadow-md rounded-lg overflow-hidden mb-8">
        <div class="border-b px-6 py-4">
            <h2 class="text-xl font-semibold text-gray-800">Select an Event</h2>
        </div>
        
        <div class="divide-y">
            {% if upcoming_events|length > 0 %}
                {% for event in upcoming_events %}
                    <div class="p-6 hover:bg-gray-50 transition duration-150">
                        <div class="md:flex md:justify-between md:items-center">
                            <div>
                                <h3 class="text-lg font-semibold text-gray-800">{{ event.name }}</h3>
                                <div class="mt-2 flex items-center text-gray-600">
                                    <i class="far fa-calendar-alt mr-2"></i>
                                    <span>{{ event.eventDate|date('F j, Y \\a\\t g:i A') }}</span>
                                </div>
                                <div class="mt-1 flex items-center text-gray-600">
                                    <i class="fas fa-map-marker-alt mr-2"></i>
                                    <span>{{ event.locationWeather ? event.locationWeather.name : 'Location not specified' }}</span>
                                </div>
                                
                                <div class="mt-2">
                                    <span class="text-purple-600 font-medium">
                                        {% if event.price > 0 %}
                                            €{{ event.price|number_format(2, '.', ',') }}
                                        {% else %}
                                            Free
                                        {% endif %}
                                    </span>
                                    
                                    {% if event.capacity %}
                                        <span class="ml-2 text-sm text-gray-500">
                                            {% if event.isFull() %}
                                                <span class="text-red-500">Sold Out</span>
                                            {% else %}
                                                {{ event.availableSpots }} spots left
                                            {% endif %}
                                        </span>
                                    {% endif %}
                                </div>
                            </div>
                            
                            <div class="mt-4 md:mt-0">
                                {% if not event.isFull() %}
                                    <a href="{{ path('payment_process', {'id': event.id}) }}" class="bg-purple-600 hover:bg-purple-700 text-white px-4 py-2 rounded-md text-sm inline-block">
                                        Book Now
                                    </a>
                                {% else %}
                                    <span class="bg-gray-300 text-gray-600 px-4 py-2 rounded-md text-sm inline-block cursor-not-allowed">
                                        Sold Out
                                    </span>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                {% endfor %}
            {% else %}
                <div class="p-6 text-center text-gray-500">
                    No upcoming events available for booking at this time.
                </div>
            {% endif %}
        </div>
    </div>
    
    <div class="mt-6">
        <a href="{{ path('ticket_index') }}" class="text-purple-600 hover:underline flex items-center">
            <i class="fas fa-arrow-left mr-2"></i> Back to My Tickets
        </a>
    </div>
</div>
{% endblock %} 