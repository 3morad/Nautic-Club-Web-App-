{% extends 'base.html.twig' %}

{% block title %}Complete Payment - {{ registration.event.name }}{% endblock %}

{% block body %}
<div class="container mx-auto px-4 py-8">
    <div class="max-w-3xl mx-auto">
        <div class="flex items-center mb-6">
            <a href="{{ path('event_registration_my_registrations') }}" class="text-purple-600 hover:text-purple-800 mr-3">
                <i class="fas fa-arrow-left"></i>
            </a>
            <h1 class="text-3xl font-bold text-purple-600">Complete Payment</h1>
        </div>

        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="bg-{{ label == 'success' ? 'green' : (label == 'error' ? 'red' : (label == 'info' ? 'blue' : 'yellow')) }}-100 border-l-4 border-{{ label == 'success' ? 'green' : (label == 'error' ? 'red' : (label == 'info' ? 'blue' : 'yellow')) }}-500 text-{{ label == 'success' ? 'green' : (label == 'error' ? 'red' : (label == 'info' ? 'blue' : 'yellow')) }}-700 p-4 mb-6 rounded-md" role="alert">
                    <p>{{ message }}</p>
                </div>
            {% endfor %}
        {% endfor %}

        <!-- Order Summary -->
        <div class="bg-white rounded-lg shadow-md overflow-hidden mb-8">
            <div class="bg-purple-600 text-white p-4">
                <h2 class="text-xl font-semibold">Order Summary</h2>
            </div>
            
            <div class="p-6">
                <h3 class="text-xl font-bold text-gray-800 mb-4">{{ registration.event.name }}</h3>
                
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
                    <div>
                        <p class="text-sm text-gray-500 mb-1">Date & Time</p>
                        <p class="font-medium">{{ registration.event.eventDate|date('F j, Y - g:i A') }}</p>
                    </div>
                    
                    <div>
                        <p class="text-sm text-gray-500 mb-1">Location</p>
                        <p class="font-medium">{{ registration.event.locationWeather.name }}</p>
                    </div>
                    
                    <div>
                        <p class="text-sm text-gray-500 mb-1">Quantity</p>
                        <p class="font-medium">{{ registration.quantity }} ticket{{ registration.quantity > 1 ? 's' : '' }}</p>
                    </div>
                    
                    <div>
                        <p class="text-sm text-gray-500 mb-1">Order Date</p>
                        <p class="font-medium">{{ registration.createdAt|date('F j, Y') }}</p>
                    </div>
                </div>
                
                <div class="bg-gray-50 p-4 rounded-lg mb-4">
                    <h4 class="font-semibold text-gray-800 mb-3">Payment Details</h4>
                    
                    <div class="space-y-2">
                        <div class="flex justify-between">
                            <span class="text-gray-600">Ticket Price</span>
                            <span class="font-medium">€{{ registration.event.price|number_format(2, '.', ',') }} × {{ registration.quantity }}</span>
                        </div>
                        
                        <div class="flex justify-between">
                            <span class="text-gray-600">Processing Fee</span>
                            <span class="font-medium">€{{ (registration.event.price * 0.05 * registration.quantity)|number_format(2, '.', ',') }}</span>
                        </div>
                        
                        <div class="border-t pt-2 mt-2 flex justify-between">
                            <span class="font-semibold">Total</span>
                            <span class="font-bold text-purple-700">€{{ registration.getTotalPrice|number_format(2, '.', ',') }}</span>
                        </div>
                    </div>
                </div>
                
                {% if registration.notes %}
                <div class="mb-4">
                    <p class="text-sm text-gray-500 mb-1">Special Requests/Notes</p>
                    <p class="text-gray-700 italic">{{ registration.notes }}</p>
                </div>
                {% endif %}
            </div>
        </div>
        
        <!-- Payment Form -->
        <div class="bg-white rounded-lg shadow-md overflow-hidden">
            <div class="bg-purple-600 text-white p-4">
                <h2 class="text-xl font-semibold">Payment Method</h2>
            </div>
            
            <div class="p-6">
                <!-- Credit Card Form -->
                <div class="mb-6">
                    <div class="space-y-4">
                        <div>
                            <label for="card-number" class="block text-sm font-medium text-gray-700 mb-1">Card Number</label>
                            <input type="text" id="card-number" class="w-full border-gray-300 rounded-md shadow-sm focus:ring-purple-500 focus:border-purple-500" placeholder="1234 5678 9012 3456">
                        </div>
                        
                        <div class="grid grid-cols-2 gap-4">
                            <div>
                                <label for="expiry" class="block text-sm font-medium text-gray-700 mb-1">Expiry Date</label>
                                <input type="text" id="expiry" class="w-full border-gray-300 rounded-md shadow-sm focus:ring-purple-500 focus:border-purple-500" placeholder="MM/YY">
                            </div>
                            
                            <div>
                                <label for="cvv" class="block text-sm font-medium text-gray-700 mb-1">CVV</label>
                                <input type="text" id="cvv" class="w-full border-gray-300 rounded-md shadow-sm focus:ring-purple-500 focus:border-purple-500" placeholder="123">
                            </div>
                        </div>
                        
                        <div>
                            <label for="name" class="block text-sm font-medium text-gray-700 mb-1">Name on Card</label>
                            <input type="text" id="name" class="w-full border-gray-300 rounded-md shadow-sm focus:ring-purple-500 focus:border-purple-500" placeholder="John Doe">
                        </div>
                    </div>
                </div>
                
                <!-- Payment Methods -->
                <div class="mb-6">
                    <p class="text-sm font-medium text-gray-700 mb-3">Or pay with:</p>
                    <div class="flex space-x-4">
                        <button class="px-4 py-2 border border-gray-300 rounded-md flex items-center justify-center hover:bg-gray-50">
                            <i class="fab fa-paypal text-blue-500 mr-2"></i> PayPal
                        </button>
                        <button class="px-4 py-2 border border-gray-300 rounded-md flex items-center justify-center hover:bg-gray-50">
                            <i class="fab fa-apple-pay text-black mr-2"></i> Apple Pay
                        </button>
                        <button class="px-4 py-2 border border-gray-300 rounded-md flex items-center justify-center hover:bg-gray-50">
                            <i class="fab fa-google-pay text-gray-700 mr-2"></i> Google Pay
                        </button>
                    </div>
                </div>
                
                <div class="mb-6">
                    <div class="flex items-start">
                        <div class="flex items-center h-5">
                            <input id="terms" type="checkbox" class="h-4 w-4 text-purple-600 border-gray-300 rounded focus:ring-purple-500">
                        </div>
                        <div class="ml-3 text-sm">
                            <label for="terms" class="font-medium text-gray-700">I agree to the payment terms</label>
                            <p class="text-gray-500">By proceeding, you confirm that all payment details are correct.</p>
                        </div>
                    </div>
                </div>
                
                <div class="flex justify-end space-x-4">
                    <a href="{{ path('event_registration_my_registrations') }}" class="px-6 py-3 bg-gray-300 text-gray-700 rounded-md hover:bg-gray-400 transition">
                        Cancel
                    </a>
                    <a href="{{ path('event_registration_payment_success', {'id': registration.id}) }}" class="px-6 py-3 bg-purple-600 text-white rounded-md hover:bg-purple-700 transition">
                        Pay €{{ registration.getTotalPrice|number_format(2, '.', ',') }}
                    </a>
                </div>
                
                <div class="mt-6 text-center">
                    <p class="text-xs text-gray-500">This is a demonstration payment page. No actual payment will be processed.</p>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %} 