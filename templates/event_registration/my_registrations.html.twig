{% extends 'base.html.twig' %}

{% block title %}My Event Registrations{% endblock %}

{% block body %}
<div class="container mx-auto px-4 py-8">
    <div class="max-w-5xl mx-auto">
        <div class="flex justify-between items-center mb-6">
            <h1 class="text-3xl font-bold text-purple-600">My Event Registrations</h1>
            <a href="{{ path('user_dashboard') }}" class="text-purple-600 hover:text-purple-800">
                <i class="fas fa-arrow-left mr-2"></i>Back to Dashboard
            </a>
        </div>

        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="bg-{{ label == 'success' ? 'green' : (label == 'error' ? 'red' : (label == 'info' ? 'blue' : 'yellow')) }}-100 border-l-4 border-{{ label == 'success' ? 'green' : (label == 'error' ? 'red' : (label == 'info' ? 'blue' : 'yellow')) }}-500 text-{{ label == 'success' ? 'green' : (label == 'error' ? 'red' : (label == 'info' ? 'blue' : 'yellow')) }}-700 p-4 mb-6 rounded-md" role="alert">
                    <p>{{ message }}</p>
                </div>
            {% endfor %}
        {% endfor %}

        <div class="bg-white rounded-lg shadow-md overflow-hidden mb-8">
            <div class="bg-purple-600 text-white p-4">
                <h2 class="text-xl font-semibold">Upcoming Events</h2>
            </div>
            
            {% if registrations|length > 0 %}
                <div class="divide-y divide-gray-200">
                    {% for registration in registrations %}
                        {% if registration.event.eventDate > date() %}
                            <div class="p-6 hover:bg-gray-50 transition duration-150">
                                <div class="md:flex md:justify-between md:items-center">
                                    <div class="md:flex md:items-center md:space-x-6">
                                        {% if registration.event.imageFilename %}
                                            <div class="hidden md:block flex-shrink-0 h-24 w-36 bg-gray-200 rounded overflow-hidden mb-4 md:mb-0">
                                                <img src="{{ asset('uploads/events/' ~ registration.event.imageFilename) }}" alt="{{ registration.event.name }}" class="h-full w-full object-cover">
                                            </div>
                                        {% endif %}
                                        
                                        <div>
                                            <h3 class="text-lg font-semibold text-gray-800 hover:text-purple-600">
                                                <a href="{{ path('simple_event_show', {'id': registration.event.id}) }}">
                                                    {{ registration.event.name }}
                                                </a>
                                            </h3>
                                            
                                            <div class="mt-2 text-sm text-gray-600 space-y-1">
                                                <div class="flex items-center">
                                                    <i class="fas fa-calendar-day text-purple-500 mr-2 w-5 text-center"></i>
                                                    <span>{{ registration.event.eventDate|date('F j, Y') }}</span>
                                                </div>
                                                <div class="flex items-center">
                                                    <i class="fas fa-clock text-purple-500 mr-2 w-5 text-center"></i>
                                                    <span>{{ registration.event.eventDate|date('g:i A') }}</span>
                                                </div>
                                                {% if registration.event.locationWeather %}
                                                <div class="flex items-center">
                                                    <i class="fas fa-map-marker-alt text-purple-500 mr-2 w-5 text-center"></i>
                                                    <span>{{ registration.event.locationWeather.name }}</span>
                                                </div>
                                                {% endif %}
                                                <div class="flex items-center mt-2">
                                                    <i class="fas fa-ticket-alt text-purple-500 mr-2 w-5 text-center"></i>
                                                    <span>{{ registration.quantity }} ticket{{ registration.quantity > 1 ? 's' : '' }}</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    
                                    <div class="mt-4 md:mt-0 flex flex-col items-end">
                                        <div class="mb-3">
                                            {% if registration.paymentStatus == 'pending' %}
                                                <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-yellow-100 text-yellow-800">
                                                    <i class="fas fa-clock mr-1"></i> Payment Pending
                                                </span>
                                            {% elseif registration.paymentStatus == 'paid' %}
                                                <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-green-100 text-green-800">
                                                    <i class="fas fa-check-circle mr-1"></i> Confirmed
                                                </span>
                                            {% else %}
                                                <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-red-100 text-red-800">
                                                    <i class="fas fa-times-circle mr-1"></i> {{ registration.paymentStatus|capitalize }}
                                                </span>
                                            {% endif %}
                                        </div>
                                        
                                        <div class="flex space-x-2">
                                            {% if registration.event.price > 0 and registration.paymentStatus == 'pending' %}
                                                <a href="{{ path('event_registration_payment', {'id': registration.id}) }}" class="px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 transition flex items-center justify-center">
                                                    <i class="fas fa-credit-card mr-2"></i> Pay Now
                                                </a>
                                            {% endif %}
                                            
                                            <form method="post" action="{{ path('event_registration_cancel', {'id': registration.id}) }}" onsubmit="return confirm('Are you sure you want to cancel this registration? This action cannot be undone.');" class="flex-1">
                                                <input type="hidden" name="_token" value="{{ csrf_token('cancel' ~ registration.id) }}">
                                                <button type="submit" class="w-full px-4 py-2 bg-red-600 text-white rounded-md hover:bg-red-700 transition flex items-center justify-center">
                                                    <i class="fas fa-times-circle mr-2"></i> Cancel Registration
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                                
                                {% if registration.notes %}
                                    <div class="mt-4 p-3 bg-gray-50 rounded-md">
                                        <p class="text-sm text-gray-500 mb-1">Your Notes:</p>
                                        <p class="text-gray-700 italic">{{ registration.notes }}</p>
                                    </div>
                                {% endif %}
                            </div>
                        {% endif %}
                    {% endfor %}
                </div>
            {% else %}
                <div class="p-8 text-center">
                    <div class="mb-4">
                        <i class="fas fa-calendar-times text-gray-400 text-5xl"></i>
                    </div>
                    <h3 class="text-lg font-medium text-gray-800 mb-2">No registrations found</h3>
                    <p class="text-gray-600 mb-6">You haven't registered for any events yet.</p>
                    <a href="{{ path('simple_event_index') }}" class="inline-flex items-center px-4 py-2 bg-purple-600 text-white rounded-md hover:bg-purple-700 transition">
                        <i class="fas fa-search mr-2"></i> Browse Events
                    </a>
                </div>
            {% endif %}
        </div>
        
        <!-- Past Events Section -->
        <div class="bg-white rounded-lg shadow-md overflow-hidden">
            <div class="bg-gray-700 text-white p-4">
                <h2 class="text-xl font-semibold">Past Events</h2>
            </div>
            
            {% set hasPastEvents = false %}
            {% for registration in registrations %}
                {% if registration.event.eventDate <= date() %}
                    {% set hasPastEvents = true %}
                {% endif %}
            {% endfor %}
            
            {% if hasPastEvents %}
                <div class="divide-y divide-gray-200">
                    {% for registration in registrations %}
                        {% if registration.event.eventDate <= date() %}
                            <div class="p-6 hover:bg-gray-50 transition duration-150">
                                <div class="md:flex md:justify-between md:items-center">
                                    <div class="md:flex md:items-center md:space-x-6">
                                        {% if registration.event.imageFilename %}
                                            <div class="hidden md:block flex-shrink-0 h-24 w-36 bg-gray-200 rounded overflow-hidden mb-4 md:mb-0">
                                                <img src="{{ asset('uploads/events/' ~ registration.event.imageFilename) }}" alt="{{ registration.event.name }}" class="h-full w-full object-cover opacity-50">
                                            </div>
                                        {% endif %}
                                        
                                        <div>
                                            <h3 class="text-lg font-semibold text-gray-600">
                                                {{ registration.event.name }}
                                            </h3>
                                            
                                            <div class="mt-2 text-sm text-gray-500 space-y-1">
                                                <div class="flex items-center">
                                                    <i class="fas fa-calendar-day text-gray-400 mr-2 w-5 text-center"></i>
                                                    <span>{{ registration.event.eventDate|date('F j, Y') }}</span>
                                                </div>
                                                <div class="flex items-center">
                                                    <i class="fas fa-clock text-gray-400 mr-2 w-5 text-center"></i>
                                                    <span>{{ registration.event.eventDate|date('g:i A') }}</span>
                                                </div>
                                                {% if registration.event.locationWeather %}
                                                <div class="flex items-center">
                                                    <i class="fas fa-map-marker-alt text-gray-400 mr-2 w-5 text-center"></i>
                                                    <span>{{ registration.event.locationWeather.name }}</span>
                                                </div>
                                                {% endif %}
                                                <div class="flex items-center mt-2">
                                                    <i class="fas fa-ticket-alt text-gray-400 mr-2 w-5 text-center"></i>
                                                    <span>{{ registration.quantity }} ticket{{ registration.quantity > 1 ? 's' : '' }}</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    
                                    <div class="mt-4 md:mt-0 flex items-end">
                                        {% if registration.paymentStatus == 'paid' %}
                                            <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-gray-200 text-gray-800">
                                                <i class="fas fa-check-circle mr-1"></i> Attended
                                            </span>
                                        {% elseif registration.paymentStatus == 'cancelled' %}
                                            <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-red-100 text-red-800">
                                                <i class="fas fa-times-circle mr-1"></i> Cancelled
                                            </span>
                                        {% else %}
                                            <div class="flex flex-col items-end">
                                                <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-yellow-100 text-yellow-800 mb-2">
                                                    <i class="fas fa-clock mr-1"></i> Pending/No-show
                                                </span>
                                                <form method="post" action="{{ path('event_registration_cancel', {'id': registration.id}) }}" onsubmit="return confirm('Are you sure you want to cancel this registration? This action cannot be undone.');">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('cancel' ~ registration.id) }}">
                                                    <button type="submit" class="px-3 py-1 bg-red-600 text-white rounded-md hover:bg-red-700 transition flex items-center text-sm">
                                                        <i class="fas fa-times-circle mr-1"></i> Cancel
                                                    </button>
                                                </form>
                                            </div>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                        {% endif %}
                    {% endfor %}
                </div>
            {% else %}
                <div class="p-8 text-center text-gray-500">
                    <p>No past events found.</p>
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %} 