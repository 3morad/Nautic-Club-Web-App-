{% extends 'base.html.twig' %}

{% block title %}Register for {{ event.name }}{% endblock %}

{% block body %}
<div class="container mx-auto px-4 py-8">
    <div class="max-w-3xl mx-auto">
        <div class="flex items-center mb-6">
            <a href="{{ path('simple_event_show', {'id': event.id}) }}" class="text-purple-600 hover:text-purple-800 mr-3">
                <i class="fas fa-arrow-left"></i>
            </a>
            <h1 class="text-3xl font-bold text-purple-600">Register for Event</h1>
        </div>

        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="bg-{{ label == 'success' ? 'green' : (label == 'error' ? 'red' : (label == 'info' ? 'blue' : 'yellow')) }}-100 border-l-4 border-{{ label == 'success' ? 'green' : (label == 'error' ? 'red' : (label == 'info' ? 'blue' : 'yellow')) }}-500 text-{{ label == 'success' ? 'green' : (label == 'error' ? 'red' : (label == 'info' ? 'blue' : 'yellow')) }}-700 p-4 mb-6 rounded-md" role="alert">
                    <p>{{ message }}</p>
                </div>
            {% endfor %}
        {% endfor %}

        <!-- Event Information Card -->
        <div class="bg-white rounded-lg shadow-md overflow-hidden mb-8">
            <div class="bg-purple-600 text-white p-4">
                <h2 class="text-xl font-semibold">Event Information</h2>
            </div>
            
            <div class="p-6">
                <div class="md:flex md:justify-between">
                    <div class="md:w-2/3">
                        <h3 class="text-xl font-bold text-gray-800 mb-2">{{ event.name }}</h3>
                        
                        <div class="text-sm text-gray-600 mb-4 space-y-2">
                            <div class="flex items-center">
                                <i class="fas fa-calendar-day text-purple-500 mr-2 w-5 text-center"></i>
                                <span>{{ event.eventDate|date('F j, Y') }}</span>
                            </div>
                            <div class="flex items-center">
                                <i class="fas fa-clock text-purple-500 mr-2 w-5 text-center"></i>
                                <span>{{ event.eventDate|date('g:i A') }}</span>
                            </div>
                            {% if event.locationWeather %}
                            <div class="flex items-center">
                                <i class="fas fa-map-marker-alt text-purple-500 mr-2 w-5 text-center"></i>
                                <span>{{ event.locationWeather.name }}</span>
                            </div>
                            {% endif %}
                        </div>
                    </div>
                    
                    <div class="md:w-1/3 mt-4 md:mt-0">
                        <div class="bg-gray-50 p-4 rounded-lg">
                            <div class="text-center">
                                <p class="text-sm text-gray-500 mb-1">Price per Ticket</p>
                                <p class="text-2xl font-bold text-gray-800">
                                    {% if event.price > 0 %}
                                        €{{ event.price|number_format(2, '.', ',') }}
                                    {% else %}
                                        Free
                                    {% endif %}
                                </p>
                            </div>
                            
                            {% if event.capacity %}
                                <div class="mt-3 text-center">
                                    <p class="text-sm text-gray-500 mb-1">Available Spots</p>
                                    <p class="text-lg font-semibold text-gray-800">
                                        {{ event.availableSpots }}/{{ event.capacity }}
                                    </p>
                                    <div class="w-full bg-gray-200 rounded-full h-2.5 mt-1">
                                        {% set percentage = (event.registrationCount / event.capacity * 100) %}
                                        <div class="bg-purple-600 h-2.5 rounded-full" style="width: {{ percentage }}%"></div>
                                    </div>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Registration Form -->
        <div class="bg-white rounded-lg shadow-md overflow-hidden">
            <div class="bg-purple-600 text-white p-4">
                <h2 class="text-xl font-semibold">Registration Details</h2>
            </div>
            
            <div class="p-6">
                <form method="post" action="{{ path('event_registration_register', {'id': event.id}) }}">
                    <div class="mb-6">
                        <h3 class="text-lg font-semibold text-gray-800 mb-4">Your Information</h3>
                        
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div>
                                <label for="firstName" class="block text-sm font-medium text-gray-700 mb-1">First Name</label>
                                <input type="text" id="firstName" name="firstName" class="w-full border-gray-300 rounded-md shadow-sm focus:ring-purple-500 focus:border-purple-500" value="{{ app.user.firstName }}" readonly>
                            </div>
                            
                            <div>
                                <label for="lastName" class="block text-sm font-medium text-gray-700 mb-1">Last Name</label>
                                <input type="text" id="lastName" name="lastName" class="w-full border-gray-300 rounded-md shadow-sm focus:ring-purple-500 focus:border-purple-500" value="{{ app.user.lastName }}" readonly>
                            </div>
                        </div>
                        
                        <div class="mt-4">
                            <label for="email" class="block text-sm font-medium text-gray-700 mb-1">Email Address</label>
                            <input type="email" id="email" name="email" class="w-full border-gray-300 rounded-md shadow-sm focus:ring-purple-500 focus:border-purple-500" value="{{ app.user.email }}" readonly>
                        </div>
                    </div>
                    
                    <div class="mb-6">
                        <h3 class="text-lg font-semibold text-gray-800 mb-4">Ticket Options</h3>
                        
                        <div>
                            <label for="quantity" class="block text-sm font-medium text-gray-700 mb-1">Number of Tickets</label>
                            <select id="quantity" name="quantity" class="w-full border-gray-300 rounded-md shadow-sm focus:ring-purple-500 focus:border-purple-500">
                                {% for i in 1..10 %}
                                    <option value="{{ i }}">{{ i }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        
                        <div class="mt-4">
                            <label for="notes" class="block text-sm font-medium text-gray-700 mb-1">Special Requests or Notes</label>
                            <textarea id="notes" name="notes" rows="3" class="w-full border-gray-300 rounded-md shadow-sm focus:ring-purple-500 focus:border-purple-500" placeholder="Any special requests or notes for the event organizers..."></textarea>
                        </div>
                    </div>

                    <div class="bg-gray-50 p-4 rounded-lg mb-6">
                        <h3 class="text-lg font-semibold text-gray-800 mb-4">Order Summary</h3>
                        
                        <div class="flex justify-between mb-2">
                            <span class="text-gray-600">Ticket Price</span>
                            <span class="font-medium">€{{ event.price|number_format(2, '.', ',') }}</span>
                        </div>
                        
                        <div class="flex justify-between mb-2">
                            <span class="text-gray-600">Quantity</span>
                            <span class="font-medium" id="summary-quantity">1</span>
                        </div>
                        
                        <div class="flex justify-between mb-2">
                            <span class="text-gray-600">Processing Fee</span>
                            <span class="font-medium">€{{ (event.price * 0.05)|number_format(2, '.', ',') }}</span>
                        </div>
                        
                        <div class="border-t pt-2 mt-2 flex justify-between">
                            <span class="font-semibold">Total</span>
                            <span class="font-bold text-purple-700" id="summary-total">€{{ (event.price + (event.price * 0.05))|number_format(2, '.', ',') }}</span>
                        </div>
                    </div>
                    
                    <div class="mb-6">
                        <div class="flex items-start">
                            <div class="flex items-center h-5">
                                <input id="terms" name="terms" type="checkbox" class="h-4 w-4 text-purple-600 border-gray-300 rounded focus:ring-purple-500" required>
                            </div>
                            <div class="ml-3 text-sm">
                                <label for="terms" class="font-medium text-gray-700">I agree to the <a href="#" class="text-purple-600 hover:text-purple-500">Terms and Conditions</a></label>
                                <p class="text-gray-500">By registering, you confirm that you have read and agree to our event policies.</p>
                            </div>
                        </div>
                    </div>
                    
                    <div class="flex justify-end space-x-4">
                        <a href="{{ path('simple_event_show', {'id': event.id}) }}" class="px-6 py-3 bg-gray-300 text-gray-700 rounded-md hover:bg-gray-400 transition">
                            Cancel
                        </a>
                        <button type="submit" class="px-6 py-3 bg-purple-600 text-white rounded-md hover:bg-purple-700 transition">
                            Complete Registration
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    // Update summary when quantity changes
    document.getElementById('quantity').addEventListener('change', function() {
        const quantity = parseInt(this.value);
        const price = {{ event.price }};
        const processingFee = price * 0.05;
        
        document.getElementById('summary-quantity').textContent = quantity;
        document.getElementById('summary-total').textContent = '€' + ((price * quantity) + (processingFee * quantity)).toFixed(2);
    });
</script>
{% endblock %} 