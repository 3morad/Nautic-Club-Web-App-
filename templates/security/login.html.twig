{% extends 'base.html.twig' %}

{% block title %}Sign In{% endblock %}

{% block body %}
<style>
    .login-container {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #a8edea 0%, #fed6e3 100%);
    }
    .login-card {
        background: #fff;
        border-radius: 16px;
        box-shadow: 0 4px 24px rgba(0,0,0,0.08);
        padding: 2.5rem 2rem;
        width: 100%;
        max-width: 370px;
    }
    .social-btn {
        width: 48%;
        margin-bottom: 1rem;
    }
    .or-divider {
        text-align: center;
        margin: 1.5rem 0 1rem 0;
        color: #aaa;
        font-size: 0.95rem;
        position: relative;
    }
    .or-divider:before, .or-divider:after {
        content: '';
        display: inline-block;
        width: 40px;
        height: 1px;
        background: #eee;
        vertical-align: middle;
        margin: 0 8px;
    }
    .forgot-link {
        font-size: 0.95rem;
        color: #6c63ff;
        text-decoration: none;
        margin-left: 8px;
    }
    .forgot-link:hover {
        text-decoration: underline;
    }
    .signup-link {
        color: #6c63ff;
        text-decoration: none;
        font-weight: 500;
    }
    .signup-link:hover {
        text-decoration: underline;
    }
    .g-recaptcha {
        margin: 1rem 0;
        display: flex;
        justify-content: center;
    }
</style>
<div class="login-container">
    <div class="login-card">
        <h2 class="text-center mb-4">Sign In With</h2>
        <div class="d-flex justify-content-between mb-3">
            <a href="#" class="btn btn-outline-primary social-btn"><i class="fab fa-facebook-f me-2"></i>Facebook</a>
            <a href="#" class="btn btn-outline-danger social-btn"><i class="fab fa-google me-2"></i>Google</a>
        </div>
        <div class="or-divider">or</div>
        <form action="{{ path('app_login') }}" method="post">
            {% if error %}
                <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
            {% endif %}
            <div class="form-group mb-3">
                <label for="username">Username</label>
                <input type="email" value="{{ last_username }}" name="_username" id="username" class="form-control" required autofocus>
            </div>
            <div class="form-group mb-3 position-relative">
                <label for="password">Password</label>
                <div class="input-group">
                    <input type="password" name="_password" id="password" class="form-control" required>
                    <a href="{{ path('forgot_password') }}" class="forgot-link input-group-text bg-white border-start-0">forgot?</a>
                </div>
            </div>
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
            <input type="hidden" name="_target_path" value="{{ path('admin_dashboard') }}">
            <div class="checkbox mb-3 mt-2">
                <label>
                    <input type="checkbox" name="_remember_me"> Remember me
                </label>
            </div>
            <div class="g-recaptcha" data-sitekey="6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI"></div>
            <button class="btn btn-lg btn-primary w-100" type="submit">Sign In</button>
        </form>
        <div class="mt-4 text-center">
            <span>Not a member? <a href="{{ path('create_user') }}" class="signup-link">Sign up now</a></span>
        </div>
    </div>
</div>

<script src="https://www.google.com/recaptcha/api.js" async defer></script>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        setTimeout(function() {
            const iframe = document.querySelector('.g-recaptcha iframe');
            if (iframe) {
                iframe.contentWindow.postMessage({
                    action: 'check',
                    token: 'test-token'
                }, '*');
            }
        }, 1000);
    });
</script>
{% endblock %} 