{% extends 'base.html.twig' %}

{% block title %}Events{% endblock %}

{% block body %}
    <div class="container mx-auto px-4 py-8">
        <div class="flex justify-between items-center mb-6">
            <h1 class="text-3xl font-bold text-purple-600 flex items-center">
                <i class="fas fa-calendar-alt mr-3"></i>Event Gallery
            </h1>
            <a href="{{ path('simple_event_new') }}" class="bg-purple-600 hover:bg-purple-700 text-white font-bold py-2 px-4 rounded-lg shadow transition duration-300 flex items-center">
                <i class="fas fa-plus-circle mr-2"></i>New Event
            </a>
        </div>

        {% for message in app.flashes('success') %}
            <div class="bg-green-100 border-l-4 border-green-500 text-green-700 p-4 mb-6 rounded-md" role="alert">
                <p>{{ message }}</p>
            </div>
        {% endfor %}

        {% if events|length > 0 %}
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                {% for event in events %}
                    <div class="bg-white rounded-lg shadow-md overflow-hidden hover:shadow-xl transition duration-300 transform hover:-translate-y-1">
                        {% if event.imageFilename %}
                            <div class="h-48 bg-gray-100 overflow-hidden">
                                <img src="{{ asset('uploads/events/' ~ event.imageFilename) }}" 
                                     class="w-full h-full object-cover" alt="{{ event.name }}">
                            </div>
                        {% else %}
                            <div class="h-48 bg-gray-200 flex items-center justify-center">
                                <i class="fas fa-image text-4xl text-gray-400"></i>
                            </div>
                        {% endif %}
                        
                        <div class="p-4">
                            <h3 class="text-xl font-semibold text-gray-800 mb-2">{{ event.name }}</h3>
                            
                            <div class="text-sm text-gray-600 mb-4 space-y-2">
                                <div class="flex items-center">
                                    <i class="fas fa-clock mr-2 text-purple-500"></i>
                                    <span>{{ event.eventDate ? event.eventDate|date('M d, Y \\a\\t g:i A') : 'N/A' }}</span>
                                </div>
                                
                                {% if event.locationWeather %}
                                <div class="flex items-center">
                                    <i class="fas fa-map-marker-alt mr-2 text-purple-500"></i>
                                    <span>{{ event.locationWeather.name }}</span>
                                </div>
                                {% endif %}
                            </div>
                            
                            <div class="flex space-x-2 mt-4">
                                <a href="{{ path('simple_event_show', {'id': event.id}) }}" 
                                   class="px-3 py-2 bg-blue-500 text-white text-sm rounded hover:bg-blue-600 transition flex-1 text-center">
                                    <i class="fas fa-eye mr-2"></i>View
                                </a>
                                <a href="{{ path('simple_event_edit', {'id': event.id}) }}" 
                                   class="px-3 py-2 bg-yellow-500 text-white text-sm rounded hover:bg-yellow-600 transition flex-1 text-center">
                                    <i class="fas fa-edit mr-2"></i>Edit
                                </a>
                            </div>
                            
                            <div class="mt-2">
                                <form method="post" action="{{ path('simple_event_delete', {'id': event.id}) }}" 
                                      onsubmit="return confirm('Are you sure you want to delete this event?');" class="w-full">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ event.id) }}">
                                    <button type="submit" class="w-full px-3 py-2 bg-red-500 text-white text-sm rounded hover:bg-red-600 transition flex items-center justify-center">
                                        <i class="fas fa-trash mr-2"></i>Delete
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% else %}
            <div class="bg-blue-50 text-blue-700 p-8 rounded-lg text-center">
                <i class="fas fa-calendar-times text-5xl mb-4"></i>
                <p class="text-lg">No events found. <a href="{{ path('simple_event_new') }}" class="text-blue-600 hover:underline font-semibold">Create one</a>!</p>
            </div>
        {% endif %}
    </div>
{% endblock %} 