{% extends 'base.html.twig' %}

{% block title %}Edit Event{% endblock %}

{% block body %}
<div class="container mx-auto px-4 py-8">
    <div class="flex justify-between items-center mb-6">
        <h1 class="text-3xl font-bold text-purple-600 flex items-center">
            <i class="fas fa-edit mr-3"></i>Edit Event
        </h1>
        <a href="{{ path('simple_event_index') }}" class="bg-gray-600 hover:bg-gray-700 text-white font-bold py-2 px-4 rounded-lg shadow transition duration-300 flex items-center">
            <i class="fas fa-arrow-left mr-2"></i>Back to List
        </a>
    </div>

    {% for message in app.flashes('success') %}
        <div class="bg-green-100 border-l-4 border-green-500 text-green-700 p-4 mb-6 rounded-md" role="alert">
            <p class="font-medium">{{ message }}</p>
        </div>
    {% endfor %}
    
    {% for message in app.flashes('error') %}
        <div class="bg-red-100 border-l-4 border-red-500 text-red-700 p-4 mb-6 rounded-md" role="alert">
            <p class="font-medium">{{ message }}</p>
        </div>
    {% endfor %}

    <div class="bg-white rounded-lg shadow-lg overflow-hidden">
        <div class="md:flex">
            <!-- Main Form Section -->
            <div class="md:w-3/5 p-6">
                <form method="post" action="{{ path('simple_event_edit', {'id': event.id}) }}" enctype="multipart/form-data" class="space-y-6">
                    <div>
                        <label for="name" class="block text-sm font-medium text-gray-700 mb-1">Event Name</label>
                        <input type="text" id="name" name="name" value="{{ event.name }}" required
                               class="w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-purple-500 focus:border-purple-500">
                    </div>
                    
                    <div>
                        <label for="description" class="block text-sm font-medium text-gray-700 mb-1">Description</label>
                        <textarea id="description" name="description" rows="5"
                                  class="w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-purple-500 focus:border-purple-500">{{ event.description }}</textarea>
                    </div>
                    
                    <div>
                        <label for="date" class="block text-sm font-medium text-gray-700 mb-1">Date & Time</label>
                        <input type="datetime-local" id="date" name="date" 
                               value="{{ event.eventDate ? event.eventDate|date('Y-m-d\\TH:i') : '' }}" required
                               class="w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-purple-500 focus:border-purple-500">
                    </div>
                    
                    <div>
                        <label for="location" class="block text-sm font-medium text-gray-700 mb-1">Location</label>
                        <select id="location" name="location" required
                                class="w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-purple-500 focus:border-purple-500">
                            <option value="">-- Select a location --</option>
                            {% for location in locations %}
                                <option value="{{ location.id }}" {% if event.locationWeather and event.locationWeather.id == location.id %}selected{% endif %}>
                                    {{ location.name }}
                                </option>
                            {% endfor %}
                        </select>
                    </div>
                </div>
            
            <!-- Image Preview Section -->
            <div class="md:w-2/5 bg-gray-50 p-6 border-t md:border-t-0 md:border-l border-gray-200">
                <div class="space-y-6">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-3">Event Image</label>
                        {% if event.imageFilename %}
                            <div class="mb-4">
                                <div class="relative rounded-lg overflow-hidden border border-gray-200 shadow-sm">
                                    <img src="{{ asset('uploads/events/' ~ event.imageFilename) }}" 
                                         class="w-full h-64 object-cover" alt="{{ event.name }}">
                                    <div class="absolute inset-0 bg-black bg-opacity-0 hover:bg-opacity-20 transition flex items-center justify-center">
                                        <span class="sr-only">View larger image</span>
                                    </div>
                                </div>
                                <p class="text-xs text-gray-500 mt-1">Currently: {{ event.imageFilename }}</p>
                            </div>
                        {% else %}
                            <div class="mb-4 border-2 border-dashed border-gray-300 rounded-lg p-6 text-center">
                                <div class="text-gray-400">
                                    <i class="fas fa-image text-5xl mb-3"></i>
                                    <p>No image currently uploaded</p>
                                </div>
                            </div>
                        {% endif %}
                        
                        <div class="mt-2">
                            <div class="border-2 border-dashed border-gray-300 rounded-lg p-4 text-center">
                                <input type="file" id="event_image" name="event_image" accept="image/*" class="hidden">
                                <label for="event_image" class="cursor-pointer">
                                    <div class="py-2 flex flex-col items-center">
                                        <i class="fas fa-cloud-upload-alt text-gray-400 text-2xl mb-2"></i>
                                        <span class="text-sm font-medium text-purple-600">Click to upload a new image</span>
                                        <p class="text-xs text-gray-500 mt-1">PNG, JPG up to 5MB</p>
                                    </div>
                                </label>
                            </div>
                            <div id="file-name" class="text-sm text-gray-500 mt-2"></div>
                        </div>
                    </div>
                    
                    <div class="pt-4 border-t border-gray-200">
                        <button type="submit" class="w-full bg-purple-600 hover:bg-purple-700 text-white font-bold py-3 px-4 rounded-lg shadow transition">
                            <i class="fas fa-save mr-2"></i>Update Event
                        </button>
                        
                        <div class="mt-4">
                            <a href="{{ path('simple_event_index') }}" class="block text-center w-full bg-gray-200 hover:bg-gray-300 text-gray-800 font-medium py-2 px-4 rounded-lg">
                                Cancel
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <div class="mt-6 bg-white rounded-lg shadow p-6">
        <h2 class="text-lg font-semibold text-gray-800 mb-4 flex items-center">
            <i class="fas fa-cog text-purple-500 mr-2"></i>Advanced Options
        </h2>
        
        <div class="border-t border-gray-200 pt-4">
            <form method="post" action="{{ path('simple_event_delete', {'id': event.id}) }}" 
                  onsubmit="return confirm('Are you sure you want to delete this event? This action cannot be undone.');"
                  class="inline-block">
                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ event.id) }}">
                <button type="submit" class="flex items-center text-red-600 hover:text-red-800">
                    <i class="fas fa-trash mr-2"></i>Delete this event
                </button>
            </form>
        </div>
    </div>
</div>

<script>
    // Display selected file name
    document.getElementById('event_image').addEventListener('change', function(e) {
        const fileName = e.target.files[0]?.name || 'No file selected';
        document.getElementById('file-name').textContent = fileName;
        
        // Preview image if available
        if (e.target.files[0]) {
            const reader = new FileReader();
            reader.onload = function(event) {
                const imgPreview = document.createElement('div');
                imgPreview.className = 'mt-3';
                imgPreview.innerHTML = `
                    <p class="text-sm font-medium text-gray-700 mb-1">Preview:</p>
                    <img src="${event.target.result}" class="w-full h-auto max-h-32 object-contain rounded-md border border-gray-200" alt="Preview">
                `;
                
                const existingPreview = document.querySelector('#file-name + div');
                if (existingPreview) {
                    existingPreview.remove();
                }
                
                document.getElementById('file-name').after(imgPreview);
            };
            reader.readAsDataURL(e.target.files[0]);
        }
    });
</script>
{% endblock %} 