{% extends 'base.html.twig' %}

{% block title %}{{ location.locationName }} - Location Details{% endblock %}

{% block body %}
<div class="max-w-7xl mx-auto py-8 px-4">
    <div class="mb-6">
        <a href="{{ path('location_index') }}" class="inline-flex items-center text-sm text-indigo-600 hover:text-indigo-900">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
            </svg>
            Back to Location List
        </a>
    </div>

    <div class="bg-white shadow-md rounded-lg overflow-hidden">
        <div class="bg-gradient-to-r from-blue-500 to-indigo-600 px-6 py-4 flex justify-between items-center">
            <div>
                <h1 class="text-2xl font-bold text-white">{{ location.locationName }}</h1>
                <p class="text-blue-100">{{ location.region }}</p>
            </div>
            <div class="flex space-x-2">
                <a href="{{ path('location_edit', {'id': location.id}) }}" class="inline-flex items-center px-3 py-1.5 border border-transparent text-sm font-medium rounded-md text-white bg-indigo-800 bg-opacity-50 hover:bg-opacity-75 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                    </svg>
                    Edit
                </a>
                <form method="post" action="{{ path('location_delete', {'id': location.id}) }}" onsubmit="return confirm('Are you sure you want to delete this location?');" class="inline">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ location.id) }}">
                    <button class="inline-flex items-center px-3 py-1.5 border border-transparent text-sm font-medium rounded-md text-white bg-red-800 bg-opacity-50 hover:bg-opacity-75 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                        </svg>
                        Delete
                    </button>
                </form>
            </div>
        </div>

        <div class="p-6">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="space-y-6">
                    <div>
                        <h2 class="text-lg font-medium text-gray-900">Location Details</h2>
                        <dl class="mt-4 space-y-4">
                            <div class="grid grid-cols-3 gap-4 py-3 border-b border-gray-100">
                                <dt class="text-sm font-medium text-gray-500">Name</dt>
                                <dd class="text-sm text-gray-900 col-span-2">{{ location.locationName }}</dd>
                            </div>
                            <div class="grid grid-cols-3 gap-4 py-3 border-b border-gray-100">
                                <dt class="text-sm font-medium text-gray-500">Region</dt>
                                <dd class="text-sm text-gray-900 col-span-2">{{ location.region }}</dd>
                            </div>
                            <div class="grid grid-cols-3 gap-4 py-3 border-b border-gray-100">
                                <dt class="text-sm font-medium text-gray-500">Coordinates</dt>
                                <dd class="text-sm text-gray-900 col-span-2">
                                    <span class="font-medium">Lat:</span> {{ location.latitude|number_format(6) }}, 
                                    <span class="font-medium">Long:</span> {{ location.longitude|number_format(6) }}
                                </dd>
                            </div>
                        </dl>
                    </div>
                </div>

                <div class="space-y-6">
                    <div class="bg-blue-50 rounded-lg p-6">
                        <h2 class="text-lg font-medium text-gray-900 flex items-center">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2 text-blue-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z" />
                            </svg>
                            Current Weather
                        </h2>
                        <div class="mt-4 flex items-center">
                            <div class="text-5xl font-bold text-blue-600">{{ location.temperature }}°</div>
                            <div class="ml-6">
                                <div class="text-lg font-medium">{{ location.weatherCondition }}</div>
                                <div class="text-sm text-gray-500">Updated: {{ location.updatedAt ? location.updatedAt|date('F j, Y, g:i a') : 'Not available' }}</div>
                            </div>
                        </div>
                    </div>

                    <div class="bg-gray-50 rounded-lg p-6">
                        <h2 class="text-lg font-medium text-gray-900">Events at this Location</h2>
                        {% if location.events is not empty %}
                            <ul class="mt-4 space-y-3">
                                {% for event in location.events %}
                                    <li class="border-b border-gray-100 pb-3">
                                        <a href="{{ path('event_show', {'id': event.id}) }}" class="text-indigo-600 font-medium hover:text-indigo-900">{{ event.name }}</a>
                                        <p class="text-sm text-gray-500">{{ event.startDate|date('M d, Y') }}</p>
                                    </li>
                                {% endfor %}
                            </ul>
                        {% else %}
                            <p class="mt-4 text-sm text-gray-500">No events scheduled at this location.</p>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %} 