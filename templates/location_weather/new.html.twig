{% extends 'base.html.twig' %}

{% block title %}Add New Location{% endblock %}

{% block body %}
<div class="max-w-7xl mx-auto py-8 px-4">
    <div class="mb-6">
        <a href="{{ path('location_index') }}" class="inline-flex items-center text-sm text-indigo-600 hover:text-indigo-900">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
            </svg>
            Back to Location List
        </a>
    </div>

    <div class="bg-white shadow-md rounded-lg overflow-hidden">
        <div class="px-6 py-5 border-b border-gray-200">
            <h1 class="text-2xl font-bold text-gray-800">Add New Location</h1>
            <p class="mt-1 text-sm text-gray-600">Enter the details for a new location to track its weather conditions.</p>
        </div>

        <div class="p-6">
            {{ form_start(form, {'attr': {'class': 'space-y-6'}}) }}
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div class="space-y-4">
                        <div>
                            {{ form_label(form.name, 'Location Name', {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
                            <div class="mt-1">
                                {{ form_widget(form.name, {'attr': {'class': 'shadow-sm focus:ring-indigo-500 focus:border-indigo-500 block w-full sm:text-sm border-gray-300 rounded-md'}}) }}
                            </div>
                            {{ form_errors(form.name, {'attr': {'class': 'text-red-500 text-xs mt-1'}}) }}
                        </div>

                        <div>
                            {{ form_label(form.region, 'Region', {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
                            <div class="mt-1">
                                {{ form_widget(form.region, {'attr': {'class': 'shadow-sm focus:ring-indigo-500 focus:border-indigo-500 block w-full sm:text-sm border-gray-300 rounded-md'}}) }}
                            </div>
                            {{ form_errors(form.region, {'attr': {'class': 'text-red-500 text-xs mt-1'}}) }}
                        </div>
                    </div>

                    <div class="space-y-4">
                        <div>
                            {{ form_label(form.latitude, 'Latitude', {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
                            <div class="mt-1">
                                {{ form_widget(form.latitude, {'attr': {'class': 'shadow-sm focus:ring-indigo-500 focus:border-indigo-500 block w-full sm:text-sm border-gray-300 rounded-md', 'step': '0.000001'}}) }}
                            </div>
                            {{ form_errors(form.latitude, {'attr': {'class': 'text-red-500 text-xs mt-1'}}) }}
                        </div>

                        <div>
                            {{ form_label(form.longitude, 'Longitude', {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
                            <div class="mt-1">
                                {{ form_widget(form.longitude, {'attr': {'class': 'shadow-sm focus:ring-indigo-500 focus:border-indigo-500 block w-full sm:text-sm border-gray-300 rounded-md', 'step': '0.000001'}}) }}
                            </div>
                            {{ form_errors(form.longitude, {'attr': {'class': 'text-red-500 text-xs mt-1'}}) }}
                        </div>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 border-t border-gray-200 pt-6 mt-6">
                    <div class="space-y-4">
                        <h3 class="text-lg font-medium text-gray-800">Weather Information</h3>
                        <p class="text-sm text-gray-500">You can enter initial weather data or update it later</p>
                        
                        <div>
                            {{ form_label(form.temperature, 'Temperature (°C)', {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
                            <div class="mt-1">
                                {{ form_widget(form.temperature, {'attr': {'class': 'shadow-sm focus:ring-indigo-500 focus:border-indigo-500 block w-full sm:text-sm border-gray-300 rounded-md', 'step': '0.1'}}) }}
                            </div>
                            {{ form_errors(form.temperature, {'attr': {'class': 'text-red-500 text-xs mt-1'}}) }}
                        </div>
                    </div>

                    <div class="space-y-4">
                        <div class="mt-8">
                            {{ form_label(form.weatherCondition, 'Weather Condition', {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
                            <div class="mt-1">
                                {{ form_widget(form.weatherCondition, {'attr': {'class': 'shadow-sm focus:ring-indigo-500 focus:border-indigo-500 block w-full sm:text-sm border-gray-300 rounded-md'}}) }}
                            </div>
                            {{ form_errors(form.weatherCondition, {'attr': {'class': 'text-red-500 text-xs mt-1'}}) }}
                        </div>
                    </div>
                </div>

                <div class="flex justify-end pt-6 border-t border-gray-200">
                    <button type="submit" class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
                        </svg>
                        Create Location
                    </button>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %} 