{% extends 'base.html.twig' %}

{% block title %}Edit User - NautiClub{% endblock %}

{% block body %}
<style>
    .edit-user-container {
        max-width: 500px;
        margin: 60px auto;
        background-color: #ffffff;
        padding: 30px 40px;
        border-radius: 12px;
        box-shadow: 0 8px 24px rgba(0, 119, 204, 0.1);
    }

    .edit-user-container h1 {
        text-align: center;
        color: #0077cc;
        margin-bottom: 25px;
    }

    label {
        font-weight: bold;
        color: #333;
    }

    .form-group {
        margin-bottom: 16px;
    }

    input, select {
        width: 100%;
        padding: 10px;
        border: 1px solid #ccc;
        border-radius: 6px;
        margin-top: 6px;
        font-size: 14px;
    }

    input:focus, select:focus {
        border-color: #0077cc;
        outline: none;
        box-shadow: 0 0 4px rgba(0, 119, 204, 0.2);
    }

    button[type="submit"] {
        width: 100%;
        background-color: #0077cc;
        color: white;
        padding: 12px;
        border: none;
        border-radius: 6px;
        font-weight: bold;
        font-size: 16px;
        cursor: pointer;
        margin-top: 10px;
        transition: background 0.3s ease;
    }

    button[type="submit"]:hover {
        background-color: #005fa3;
    }

    .back-link {
        display: block;
        text-align: center;
        margin-top: 20px;
        color: #0077cc;
        text-decoration: none;
        font-size: 0.95em;
    }

    .back-link:hover {
        text-decoration: underline;
    }
</style>

<div class="edit-user-container">
    <h1>Edit User</h1>

    {{ form_start(form, { 'attr': {'autocomplete': 'off'} }) }}
        {{ form_widget(form) }}
        <button type="submit">Save Changes</button>
    {{ form_end(form) }}

    <a href="{{ path('admin_dashboard') }}" class="back-link">← Back to Dashboard</a>
</div>
{% endblock %}
