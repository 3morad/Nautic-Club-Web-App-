<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Welcome!{% endblock %} - Nautic Club Admin</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚓</text></svg>">
        {% block stylesheets %}
            <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
            <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
            <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin=""/>
        {% endblock %}

        {% block javascripts %}
            <script defer src="https://unpkg.com/alpinejs@3.10.5/dist/cdn.min.js"></script>
            <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
            <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
        {% endblock %}
    </head>
    <body class="bg-gray-100">
        <div class="min-h-screen flex">
            <!-- Sidebar -->
            <div class="bg-gray-800 text-white w-64 space-y-6 py-7 px-2 absolute inset-y-0 left-0 transform -translate-x-full md:relative md:translate-x-0 transition duration-200 ease-in-out">
                <a href="{{ path('admin_dashboard') }}" class="text-white flex items-center space-x-2 px-4">
                    <i class="fas fa-ship text-2xl"></i>
                    <span class="text-2xl font-extrabold">Nautic Club</span>
                </a>

                <nav class="space-y-2">
                    <a href="{{ path('admin_dashboard') }}" class="block py-2.5 px-4 rounded transition duration-200 hover:bg-gray-700 hover:text-white">
                        <i class="fas fa-tachometer-alt mr-2"></i>Dashboard
                    </a>
                    <a href="{{ path('admin_user_index') }}" class="block py-2.5 px-4 rounded transition duration-200 hover:bg-gray-700 hover:text-white">
                        <i class="fas fa-users mr-2"></i>Users
                    </a>
                    <a href="{{ path('admin_event_registration_dashboard') }}" class="block py-2.5 px-4 rounded transition duration-200 hover:bg-gray-700 hover:text-white">
                        <i class="fas fa-database mr-2"></i>Event Database
                    </a>
                    
                    <!-- Email System Dropdown -->
                    <div class="relative" x-data="{ open: false }">
                        <button @click="open = !open" class="w-full flex items-center justify-between py-2.5 px-4 rounded transition duration-200 hover:bg-gray-700 hover:text-white">
                            <div>
                                <i class="fas fa-envelope mr-2"></i>Email System
                            </div>
                            <i class="fas fa-chevron-down text-xs transform transition-transform duration-200" :class="{'rotate-180': open}"></i>
                        </button>
                        <div x-show="open" @click.away="open = false" class="bg-gray-700 mt-1 rounded py-2 w-full">
                            <a href="{{ path('email_dashboard') }}" class="block py-2 px-6 rounded transition duration-200 hover:bg-gray-600 hover:text-white">
                                <i class="fas fa-tachometer-alt mr-2"></i>Dashboard
                            </a>
                            <a href="{{ path('email_template_index') }}" class="block py-2 px-6 rounded transition duration-200 hover:bg-gray-600 hover:text-white">
                                <i class="fas fa-envelope-open-text mr-2"></i>Templates
                            </a>
                            <a href="{{ path('email_bulk_send') }}" class="block py-2 px-6 rounded transition duration-200 hover:bg-gray-600 hover:text-white">
                                <i class="fas fa-paper-plane mr-2"></i>Bulk Send
                            </a>
                            <a href="{{ path('email_log_index') }}" class="block py-2 px-6 rounded transition duration-200 hover:bg-gray-600 hover:text-white">
                                <i class="fas fa-history mr-2"></i>Logs
                            </a>
                        </div>
                    </div>
                    
                    <a href="{{ path('admin_transactions_index') }}" class="block py-2.5 px-4 rounded transition duration-200 hover:bg-gray-700 hover:text-white">
                        <i class="fas fa-money-bill-wave mr-2"></i>Transactions
                    </a>
                    <a href="{{ path('admin_tickets_index') }}" class="block py-2.5 px-4 rounded transition duration-200 hover:bg-gray-700 hover:text-white">
                        <i class="fas fa-ticket-alt mr-2"></i>Tickets
                    </a>
                    <a href="{{ path('simple_location_index') }}" class="block py-2.5 px-4 rounded transition duration-200 hover:bg-gray-700 hover:text-white">
                        <i class="fas fa-map-marked-alt mr-2"></i>Locations
                    </a>
                    <a href="{{ path('app_event_index') }}" class="block py-2.5 px-4 rounded transition duration-200 hover:bg-gray-700 hover:text-white">
                        <i class="fas fa-calendar-alt mr-2"></i>Events
                    </a>
                    <a href="{{ path('event_registration_admin_all') }}" class="block py-2.5 px-4 rounded transition duration-200 hover:bg-gray-700 hover:text-white">
                        <i class="fas fa-clipboard-list mr-2"></i>Event Registrations
                    </a>
                    <a href="{{ path('admin_feedback_index') }}" class="block py-2.5 px-4 rounded transition duration-200 hover:bg-gray-700 hover:text-white">
                        <i class="fas fa-comments mr-2"></i>Feedback
                    </a>
                    <a href="{{ path('home') }}" class="block py-2.5 px-4 rounded transition duration-200 hover:bg-gray-700 hover:text-white">
                        <i class="fas fa-home mr-2"></i>View Site
                    </a>
                </nav>
                
                <div class="px-4 py-2 mt-6 border-t border-gray-700">
                    <div class="flex items-center justify-between text-sm">
                        <span class="text-gray-400">API Status</span>
                        <span class="px-2 py-1 text-xs rounded-full {% if app.session.get('api_status') == 'error' %}bg-red-500{% else %}bg-green-500{% endif %}">
                            {% if app.session.get('api_status') == 'error' %}Error{% else %}Active{% endif %}
                        </span>
                    </div>
                    <div class="text-xs text-gray-400 mt-1">
                        OpenWeather API
                    </div>
                </div>
            </div>

            <!-- Content -->
            <div class="flex-1">
                <!-- Top Navigation -->
                <div class="bg-white shadow-lg">
                    <div class="flex items-center justify-between h-16 px-4">
                        <button class="text-gray-500 hover:text-gray-600 md:hidden" id="sidebarToggle">
                            <i class="fas fa-bars text-xl"></i>
                        </button>
                        
                        <!-- Weather Summary -->
                        <div class="hidden md:flex items-center text-sm mr-auto ml-6">
                            <i class="fas fa-map-marker-alt text-purple-500 mr-2"></i>
                            <span class="text-gray-600 font-medium">Weather stations: </span>
                            <span class="ml-1 text-gray-800">{{ locations_count|default(0) }}</span>
                            
                            <i class="fas fa-temperature-high text-red-500 ml-4 mr-2"></i>
                            <span class="text-gray-600 font-medium">Avg temp: </span>
                            <span class="ml-1 text-gray-800">{{ avg_temperature|default('N/A') }}°C</span>
                        </div>
                        
                        <div class="flex items-center">
                            <div class="relative">
                                <button class="flex items-center text-gray-500 hover:text-gray-600">
                                    <img class="h-8 w-8 rounded-full" src="https://ui-avatars.com/api/?name=Admin&background=0D8ABC&color=fff" alt="Admin">
                                    <span class="ml-2">Admin</span>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Flash Messages -->
                <div class="px-6 pt-4">
                    {% for label, messages in app.flashes %}
                        {% for message in messages %}
                            <div class="mb-4 rounded-lg p-4 {% if label == 'success' %}bg-green-100 text-green-700 border-l-4 border-green-500{% elseif label == 'error' %}bg-red-100 text-red-700 border-l-4 border-red-500{% else %}bg-blue-100 text-blue-700 border-l-4 border-blue-500{% endif %}">
                                <p class="font-medium">{{ message }}</p>
                            </div>
                        {% endfor %}
                    {% endfor %}
                </div>

                <!-- Main Content -->
                <main class="p-6">
                    {% block body %}{% endblock %}
                </main>
                
                <!-- Footer -->
                <footer class="bg-white p-4 shadow-inner mt-auto">
                    <div class="container mx-auto">
                        <div class="text-center text-sm text-gray-500">
                            <p>Nautic Club Admin © {{ "now"|date("Y") }} | Weather data powered by <a href="https://openweathermap.org" class="text-blue-500 hover:underline" target="_blank">OpenWeatherMap</a></p>
                        </div>
                    </div>
                </footer>
            </div>
        </div>

        <script>
            // Mobile menu toggle
            document.getElementById('sidebarToggle').addEventListener('click', function() {
                document.querySelector('.bg-gray-800').classList.toggle('-translate-x-full');
            });
        </script>
    </body>
</html> 