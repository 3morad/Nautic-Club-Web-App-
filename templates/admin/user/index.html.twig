{% extends 'admin/base.html.twig' %}

{% block title %}User Management{% endblock %}

{% block body %}
    <div class="container mx-auto px-4">
        <div class="flex justify-between items-center mb-6">
            <h1 class="text-3xl font-bold text-gray-800 flex items-center">
                <i class="fas fa-users text-purple-600 mr-3"></i>User Management
            </h1>
            <a href="{{ path('admin_user_new') }}" class="px-4 py-2 bg-purple-600 text-white rounded-lg hover:bg-purple-700 flex items-center">
                <i class="fas fa-plus mr-2"></i>Add New User
            </a>
        </div>

        <!-- Flash Messages -->
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="mb-4 rounded-lg p-4 {% if label == 'success' %}bg-green-100 text-green-700 border-l-4 border-green-500{% elseif label == 'error' %}bg-red-100 text-red-700 border-l-4 border-red-500{% else %}bg-blue-100 text-blue-700 border-l-4 border-blue-500{% endif %}">
                    <p class="font-medium">{{ message }}</p>
                </div>
            {% endfor %}
        {% endfor %}

        <!-- Search Form -->
        <div class="mb-6 bg-white rounded-lg shadow-md p-4">
            <form method="get" class="flex gap-4 items-end">
                <div class="flex-1">
                    <label for="search" class="block text-sm font-medium text-gray-700 mb-1">Search Users</label>
                    <input type="text" id="search" name="search" value="{{ search }}" 
                           class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-purple-500"
                           placeholder="Search by email, first name, or last name">
                </div>
                <button type="submit" class="px-4 py-2 bg-purple-600 text-white rounded-lg hover:bg-purple-700">
                    <i class="fas fa-search mr-2"></i>Search
                </button>
                {% if search %}
                    <a href="{{ path('admin_user_index') }}" class="px-4 py-2 bg-gray-500 text-white rounded-lg hover:bg-gray-600">
                        <i class="fas fa-times mr-2"></i>Clear
                    </a>
                {% endif %}
            </form>
        </div>

        <!-- Users Table -->
        <div class="bg-white rounded-lg shadow-md overflow-hidden">
            <div class="overflow-x-auto">
                <table class="min-w-full">
                    <thead class="bg-gray-50 text-gray-600 uppercase text-xs">
                        <tr>
                            <th class="py-3 px-6 text-left">ID</th>
                            <th class="py-3 px-6 text-left">Name</th>
                            <th class="py-3 px-6 text-left">Email</th>
                            <th class="py-3 px-6 text-left">Roles</th>
                            <th class="py-3 px-6 text-left">Registrations</th>
                            <th class="py-3 px-6 text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-200">
                        {% for user in users %}
                            <tr class="hover:bg-gray-50">
                                <td class="py-4 px-6">{{ user.id }}</td>
                                <td class="py-4 px-6 font-medium">{{ user.firstName }} {{ user.lastName }}</td>
                                <td class="py-4 px-6">{{ user.email }}</td>
                                <td class="py-4 px-6">
                                    {% for role in user.roles %}
                                        {% if role == 'ROLE_ADMIN' %}
                                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-purple-100 text-purple-800">
                                                <i class="fas fa-shield-alt mr-1"></i>Admin
                                            </span>
                                        {% elseif role == 'ROLE_USER' %}
                                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                                                <i class="fas fa-user mr-1"></i>User
                                            </span>
                                        {% else %}
                                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
                                                {{ role }}
                                            </span>
                                        {% endif %}
                                    {% endfor %}
                                </td>
                                <td class="py-4 px-6">
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                                        <i class="fas fa-ticket-alt mr-1"></i>{{ user.eventRegistrations|length }}
                                    </span>
                                </td>
                                <td class="py-4 px-6 text-right space-x-2">
                                    <a href="{{ path('admin_user_show', {'id': user.id}) }}" class="inline-flex items-center px-3 py-1 bg-blue-600 hover:bg-blue-700 text-white text-sm rounded">
                                        <i class="fas fa-eye mr-1"></i>View
                                    </a>
                                    <a href="{{ path('admin_user_edit', {'id': user.id}) }}" class="inline-flex items-center px-3 py-1 bg-yellow-500 hover:bg-yellow-600 text-white text-sm rounded">
                                        <i class="fas fa-edit mr-1"></i>Edit
                                    </a>
                                    <form method="post" action="{{ path('admin_user_delete', {'id': user.id}) }}" class="inline" onsubmit="return confirm('Are you sure you want to delete this user?');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">
                                        <button class="inline-flex items-center px-3 py-1 bg-red-600 hover:bg-red-700 text-white text-sm rounded">
                                            <i class="fas fa-trash mr-1"></i>Delete
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="6" class="py-4 px-6 text-center text-gray-500">No users found</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Pagination -->
        <div class="mt-4">
            {{ knp_pagination_render(users, 'admin/pagination.html.twig') }}
        </div>
    </div>
{% endblock %} 