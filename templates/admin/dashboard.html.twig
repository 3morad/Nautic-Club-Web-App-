{% extends 'base.html.twig' %}

{% block title %}Admin Dashboard - NautiClub{% endblock %}

{% block body %}
<style>
    .dashboard-container {
        max-width: 1000px;
        margin: 50px auto;
        padding: 30px;
        background-color: white;
        border-radius: 12px;
        box-shadow: 0 10px 20px rgba(0, 119, 204, 0.1);
    }

    .dashboard-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
    }

    .dashboard-header h1 {
        color: #0077cc;
        font-weight: 700;
    }

    .add-user-btn {
        background-color: #0077cc;
        color: white;
        padding: 10px 16px;
        font-weight: bold;
        border: none;
        border-radius: 6px;
        text-decoration: none;
        transition: background 0.2s ease;
    }

    .add-user-btn:hover {
        background-color: #005fa3;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 20px;
    }

    thead {
        background-color: #0077cc;
        color: white;
    }

    th, td {
        padding: 12px 16px;
        border-bottom: 1px solid #eee;
        text-align: left;
    }

    tr:hover {
        background-color: #f7fbff;
    }

    .badge {
        padding: 6px 10px;
        border-radius: 20px;
        font-size: 0.85em;
    }

    .bg-success {
        background-color: #28a745;
        color: white;
    }

    .bg-danger {
        background-color: #dc3545;
        color: white;
    }

    .btn-sm {
        padding: 6px 10px;
        font-size: 0.85em;
        border-radius: 4px;
        text-decoration: none;
        margin-right: 5px;
    }

    .btn-warning {
        background-color: #ffc107;
        color: #212529;
    }

    .btn-warning:hover {
        background-color: #e0a800;
    }

    .btn-danger {
        background-color: #dc3545;
        color: white;
    }

    .btn-danger:hover {
        background-color: #bb2d3b;
    }

    .text-muted {
        color: #6c757d;
    }
</style>

<div class="dashboard-container">
    <div class="dashboard-header">
        <h1>👨‍💼 Admin Dashboard</h1>
        <a href="{{ path('admin_add_user') }}" class="add-user-btn">➕ Add New User</a>
    </div>

    <table>
        <thead>
            <tr>
                <th>Username</th>
                <th>Email</th>
                <th>User Type</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for user in users %}
            <tr>
                <td>{{ user.username }}</td>
                <td>{{ user.email }}</td>
                <td>{{ user.userType|capitalize }}</td>
                <td>
                    {% if user.status == 'active' %}
                        <span class="badge bg-success">Active</span>
                    {% else %}
                        <span class="badge bg-danger">Inactive</span>
                    {% endif %}
                </td>
                <td>
                    <a href="{{ path('admin_edit_user', { id: user.id }) }}" class="btn-sm btn-warning">
                        ✏️ Edit
                    </a>
                    <a href="{{ path('admin_delete_user', { id: user.id }) }}"
                       class="btn-sm btn-danger"
                       onclick="return confirm('Are you sure you want to delete this user?');">
                        🗑️ Delete
                    </a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5" class="text-center text-muted">No users found.</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
