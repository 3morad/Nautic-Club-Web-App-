{% extends 'base.html.twig' %}

{% block title %}Admin Dashboard{% endblock %}

{% block body %}
<div class="container mt-5">
    <h1 class="mb-4">👨‍💼 Admin Dashboard</h1>

    <div class="row mb-4">
        <div class="col-md-8">
            <form class="d-flex" method="get">
                <div class="input-group">
                    <input type="text" name="search" class="form-control" placeholder="Search by username, email, or type..." value="{{ searchTerm }}">
                    <button class="btn btn-primary" type="submit">
                        🔍 Search
                    </button>
                    {% if searchTerm %}
                        <a href="{{ path('admin_dashboard') }}" class="btn btn-secondary">❌ Clear</a>
                    {% endif %}
                </div>
            </form>
        </div>
        <div class="col-md-4 text-end">
            <a href="{{ path('admin_add_user') }}" class="btn btn-success">➕ Add New User</a>
        </div>
    </div>

    <table class="table table-bordered table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>{{ knp_pagination_sortable(pagination, 'Username', 'u.username') }}</th>
                <th>{{ knp_pagination_sortable(pagination, 'Email', 'u.email') }}</th>
                <th>{{ knp_pagination_sortable(pagination, 'User Type', 'u.user_type') }}</th>
                <th>{{ knp_pagination_sortable(pagination, 'Status', 'u.status') }}</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for user in pagination %}
            <tr>
                <td>{{ user.username }}</td>
                <td>{{ user.email }}</td>
                <td>{{ user.userType|capitalize }}</td>
                <td>
                    {% if user.status == 'active' %}
                        <span class="badge bg-success">Active</span>
                    {% else %}
                        <span class="badge bg-danger">Inactive</span>
                    {% endif %}
                </td>
                <td>
                    <a href="{{ path('admin_edit_user', { id: user.id }) }}" class="btn btn-sm btn-warning">
                        ✏️ Edit
                    </a>
                    <a href="{{ path('admin_delete_user', { id: user.id }) }}"
                       class="btn btn-sm btn-danger"
                       onclick="return confirm('Are you sure you want to delete this user?');">
                        🗑️ Delete
                    </a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5" class="text-center text-muted">No users found.</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
    
    <div class="navigation d-flex justify-content-center">
        {{ knp_pagination_render(pagination) }}
    </div>
</div>
{% endblock %}
