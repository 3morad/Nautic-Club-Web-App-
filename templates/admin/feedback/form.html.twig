{% extends 'admin/base.html.twig' %}

{% block title %}{{ feedback.id ? 'Edit' : 'New' }} Sample Feedback{% endblock %}

{% block body %}
    <div class="container mx-auto px-4">
        <div class="flex justify-between items-center mb-6">
            <h1 class="text-3xl font-bold">{{ feedback.id ? 'Edit' : 'New' }} Sample Feedback</h1>
            <a href="{{ path('admin_feedback_index') }}" class="bg-gray-500 hover:bg-gray-700 text-white font-bold py-2 px-4 rounded">
                Back to List
            </a>
        </div>

        <div class="bg-white shadow-md rounded-lg p-6">
            {{ form_start(form, {'attr': {'class': 'space-y-6'}}) }}
                <div>
                    {{ form_label(form.eventName, 'Event Name', {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
                    {{ form_widget(form.eventName, {'attr': {'class': 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500'}}) }}
                    {{ form_errors(form.eventName, {'attr': {'class': 'mt-2 text-sm text-red-600'}}) }}
                </div>

                <div>
                    {{ form_label(form.username, 'Customer Name', {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
                    {{ form_widget(form.username, {'attr': {'class': 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500'}}) }}
                    {{ form_errors(form.username, {'attr': {'class': 'mt-2 text-sm text-red-600'}}) }}
                </div>

                {# Set current admin user as the user #}
                {{ form_widget(form.user, {'value': app.user.id}) }}

                <div>
                    {{ form_label(form.rating, 'Rating', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-2'}}) }}
                    <div class="flex space-x-4">
                        {{ form_widget(form.rating, {'attr': {'class': 'rating-selector'}}) }}
                    </div>
                    {{ form_errors(form.rating, {'attr': {'class': 'mt-2 text-sm text-red-600'}}) }}
                </div>

                <div>
                    {{ form_label(form.comment, 'Comment', {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
                    {{ form_widget(form.comment, {'attr': {'class': 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500'}}) }}
                    {{ form_errors(form.comment, {'attr': {'class': 'mt-2 text-sm text-red-600'}}) }}
                </div>

                <div class="flex justify-end">
                    <button type="submit" class="bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded">
                        {{ feedback.id ? 'Update' : 'Create' }}
                    </button>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %} 