{% extends 'base.html.twig' %}

{% block title %}{{ ticket.isSupport ? 'Support Ticket' : 'Event Ticket' }} - {{ ticket.isSupport ? ticket.title : ticket.eventName }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .ticket-card {
            background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
            color: white;
            border-radius: 1rem;
            overflow: hidden;
        }
        .support-ticket-card {
            background: linear-gradient(135deg, #9333ea 0%, #7e22ce 100%);
            color: white;
            border-radius: 1rem;
            overflow: hidden;
        }
        .qr-code {
            background: white;
            padding: 1rem;
            border-radius: 0.5rem;
        }
        .detail-row {
            display: flex;
            justify-content: space-between;
            padding: 0.75rem 0;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }
        .detail-row:last-child {
            border-bottom: none;
        }
    </style>
{% endblock %}

{% block body %}
<div class="container mx-auto px-4 py-8">
    <div class="max-w-2xl mx-auto">
        <!-- Header with back button -->
        <div class="flex items-center mb-8">
            <a href="{{ path('ticket_index') }}" class="text-gray-600 hover:text-purple-600">
                <i class="fas fa-arrow-left mr-2"></i> Back to Tickets
            </a>
        </div>

        {% for message in app.flashes('error') %}
            <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4" role="alert">
                <span class="block sm:inline">{{ message }}</span>
            </div>
        {% endfor %}

        <!-- Ticket Card -->
        <div class="{{ ticket.isSupport ? 'support-ticket-card' : 'ticket-card' }} p-8 mb-8">
            <div class="text-center mb-8">
                {% if ticket.isSupport %}
                    <span class="bg-purple-300 text-purple-800 text-sm font-medium px-3 py-1 rounded-full">Support Ticket</span>
                    <h1 class="text-3xl font-bold mb-2 mt-3">{{ ticket.title }}</h1>
                    <p class="text-lg opacity-90">{{ ticket.createdAt|date('F d, Y') }}</p>
                {% else %}
                    <h1 class="text-3xl font-bold mb-2">{{ ticket.eventName }}</h1>
                    <p class="text-lg opacity-90">{{ ticket.eventDate|date('F d, Y') }}</p>
                {% endif %}
            </div>

            <!-- QR Code - Only for event tickets -->
            {% if not ticket.isSupport and qr_code_data_uri is defined and qr_code_data_uri is not null %}
                <div class="flex justify-center mb-8">
                    <div class="qr-code">
                        <img src="{{ qr_code_data_uri }}" alt="Ticket QR Code" class="w-48 h-48">
                    </div>
                </div>
            {% elseif not ticket.isSupport %}
                <div class="flex justify-center mb-8">
                    <div class="bg-white p-4 rounded-lg text-center">
                        <div class="bg-gray-100 p-4 rounded-lg mb-2">
                            <i class="fas fa-ticket-alt text-4xl text-gray-400"></i>
                        </div>
                        <p class="text-gray-600 text-sm">Ticket #{{ ticket.id }}</p>
                    </div>
                </div>
            {% endif %}

            <!-- Ticket Details -->
            <div class="space-y-2">
                {% if ticket.isSupport %}
                    <div class="detail-row">
                        <span class="opacity-75">Category</span>
                        <span class="font-semibold">{{ ticket.category }}</span>
                    </div>
                    <div class="detail-row">
                        <span class="opacity-75">Status</span>
                        <span class="font-semibold">{{ ticket.status|capitalize }}</span>
                    </div>
                    <div class="detail-row">
                        <span class="opacity-75">Priority</span>
                        <span class="font-semibold">{{ ticket.priority|capitalize }}</span>
                    </div>
                    <div class="detail-row">
                        <span class="opacity-75">Description</span>
                        <span class="font-semibold">{{ ticket.description }}</span>
                    </div>
                {% else %}
                    <div class="detail-row">
                        <span class="opacity-75">Event</span>
                        <span class="font-semibold">{{ ticket.eventName }}</span>
                    </div>
                    <div class="detail-row">
                        <span class="opacity-75">Date</span>
                        <span class="font-semibold">{{ ticket.eventDate|date('M d, Y') }}</span>
                    </div>
                    <div class="detail-row">
                        <span class="opacity-75">Amount Paid</span>
                        <span class="font-semibold">${{ ticket.price|number_format(2) }}</span>
                    </div>
                    <div class="detail-row">
                        <span class="opacity-75">Ticket Type</span>
                        <span class="font-semibold">{{ ticket.ticketType }}</span>
                    </div>
                    <div class="detail-row">
                        <span class="opacity-75">Status</span>
                        <span class="font-semibold text-green-300">Confirmed</span>
                    </div>
                {% endif %}
            </div>
        </div>

        <!-- Action Buttons -->
        <div class="flex space-x-4">
            {% if not ticket.isSupport %}
                <a href="{{ path('ticket_download', {'id': ticket.id}) }}" 
                   class="flex-1 bg-purple-600 text-white text-center py-3 rounded-lg font-bold hover:bg-purple-700">
                    Download Ticket
                </a>
                <a href="{{ path('ticket_scan', {'id': ticket.id}) }}" 
                   class="flex-1 bg-indigo-600 text-white text-center py-3 rounded-lg font-bold hover:bg-indigo-700">
                    Scan Ticket
                </a>
                <button onclick="shareTicket()" 
                        class="flex-1 bg-white text-gray-700 text-center py-3 rounded-lg font-bold border border-gray-300 hover:bg-gray-50">
                    Share
                </button>
            {% else %}
                <a href="{{ path('ticket_index') }}" 
                   class="flex-1 bg-purple-600 text-white text-center py-3 rounded-lg font-bold hover:bg-purple-700">
                    Back to Tickets
                </a>
            {% endif %}
        </div>

        <!-- Similar Events Section -->
        <div class="mt-12">
            <h2 class="text-2xl font-bold mb-4">Similar Events</h2>
            <div class="grid grid-cols-2 gap-4">
                <!-- Add similar events here if available -->
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        function shareTicket() {
            if (navigator.share) {
                navigator.share({
                    title: '{{ ticket.eventName }} Ticket',
                    text: 'Check out my ticket for {{ ticket.eventName }} on {{ ticket.eventDate|date("F d, Y") }}!',
                    url: window.location.href
                })
                .catch(console.error);
            } else {
                alert('Sharing is not supported on this browser');
            }
        }
    </script>
{% endblock %} 