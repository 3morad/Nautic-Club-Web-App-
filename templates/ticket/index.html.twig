{% extends 'base.html.twig' %}

{% block title %}My Tickets{% endblock %}

{% block body %}
<div class="container mx-auto px-4 py-8">
    <h1 class="text-3xl font-bold text-gray-800 mb-6">My Tickets</h1>
    
    <div class="bg-white shadow-md rounded-lg overflow-hidden mb-8">
        <div class="border-b px-6 py-4 flex items-center justify-between">
            <h2 class="text-xl font-semibold text-gray-800">Upcoming Events</h2>
            <a href="{{ path('payment_page') }}" class="bg-purple-600 hover:bg-purple-700 text-white px-4 py-2 rounded-md text-sm">
                Book New Tickets
            </a>
        </div>
        
        <div class="divide-y">
            <!-- Ticket Item 1 -->
            <div class="p-6">
                <div class="md:flex md:justify-between md:items-center">
                    <div>
                        <h3 class="text-lg font-semibold text-gray-800">Summer Sailing Competition</h3>
                        <div class="mt-2 flex items-center text-gray-600">
                            <i class="far fa-calendar-alt mr-2"></i>
                            <span>June 15, 2023 - 10:00 AM</span>
                        </div>
                        <div class="mt-1 flex items-center text-gray-600">
                            <i class="fas fa-map-marker-alt mr-2"></i>
                            <span>Marina Bay, Beach City</span>
                        </div>
                        <div class="mt-3 inline-flex items-center px-3 py-1 bg-green-100 text-green-800 rounded-full text-sm">
                            <i class="fas fa-check-circle mr-1"></i>
                            <span>Confirmed</span>
                        </div>
                    </div>
                    
                    <div class="mt-4 md:mt-0 flex flex-col items-start md:items-end">
                        <span class="text-sm text-gray-500">Ticket #: T2023-1234</span>
                        <span class="mt-1 text-sm text-gray-500">Type: Standard</span>
                        <span class="mt-1 text-sm text-gray-500">Quantity: 2</span>
                        
                        <div class="mt-4 flex space-x-2">
                            <button class="bg-gray-100 hover:bg-gray-200 text-gray-800 px-3 py-1 rounded text-sm">
                                <i class="fas fa-download mr-1"></i> Download
                            </button>
                            <button class="bg-gray-100 hover:bg-gray-200 text-gray-800 px-3 py-1 rounded text-sm">
                                <i class="fas fa-envelope mr-1"></i> Email
                            </button>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Ticket Item 2 -->
            <div class="p-6">
                <div class="md:flex md:justify-between md:items-center">
                    <div>
                        <h3 class="text-lg font-semibold text-gray-800">Yacht Parade</h3>
                        <div class="mt-2 flex items-center text-gray-600">
                            <i class="far fa-calendar-alt mr-2"></i>
                            <span>July 4, 2023 - 5:00 PM</span>
                        </div>
                        <div class="mt-1 flex items-center text-gray-600">
                            <i class="fas fa-map-marker-alt mr-2"></i>
                            <span>Harbor View, Beach City</span>
                        </div>
                        <div class="mt-3 inline-flex items-center px-3 py-1 bg-blue-100 text-blue-800 rounded-full text-sm">
                            <i class="fas fa-clock mr-1"></i>
                            <span>Pending Payment</span>
                        </div>
                    </div>
                    
                    <div class="mt-4 md:mt-0 flex flex-col items-start md:items-end">
                        <span class="text-sm text-gray-500">Ticket #: T2023-1235</span>
                        <span class="mt-1 text-sm text-gray-500">Type: VIP</span>
                        <span class="mt-1 text-sm text-gray-500">Quantity: 1</span>
                        
                        <div class="mt-4">
                            <button class="bg-purple-600 hover:bg-purple-700 text-white px-3 py-1 rounded text-sm">
                                Complete Payment
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <div class="bg-white shadow-md rounded-lg overflow-hidden">
        <div class="border-b px-6 py-4">
            <h2 class="text-xl font-semibold text-gray-800">Past Events</h2>
        </div>
        
        <div class="divide-y">
            <!-- Past Ticket Item -->
            <div class="p-6 opacity-70">
                <div class="md:flex md:justify-between md:items-center">
                    <div>
                        <h3 class="text-lg font-semibold text-gray-800">Coastal Wildlife Tour</h3>
                        <div class="mt-2 flex items-center text-gray-600">
                            <i class="far fa-calendar-alt mr-2"></i>
                            <span>May 12, 2023 - 9:00 AM</span>
                        </div>
                        <div class="mt-1 flex items-center text-gray-600">
                            <i class="fas fa-map-marker-alt mr-2"></i>
                            <span>Coral Bay, Beach City</span>
                        </div>
                        <div class="mt-3 inline-flex items-center px-3 py-1 bg-gray-100 text-gray-800 rounded-full text-sm">
                            <i class="fas fa-check-circle mr-1"></i>
                            <span>Completed</span>
                        </div>
                    </div>
                    
                    <div class="mt-4 md:mt-0 flex flex-col items-start md:items-end">
                        <span class="text-sm text-gray-500">Ticket #: T2023-1125</span>
                        <span class="mt-1 text-sm text-gray-500">Type: Premium</span>
                        <span class="mt-1 text-sm text-gray-500">Quantity: 4</span>
                        
                        <div class="mt-4">
                            <button class="bg-gray-100 hover:bg-gray-200 text-gray-800 px-3 py-1 rounded text-sm">
                                <i class="fas fa-star mr-1"></i> Leave Review
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %} 