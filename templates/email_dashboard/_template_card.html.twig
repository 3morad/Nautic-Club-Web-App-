<div class="template-card bg-white shadow-md rounded-lg p-4 flex flex-col justify-between h-full">
    <div>
        <div class="flex items-center mb-2">
            <span class="category-pill bg-blue-100 text-blue-700 mr-2">{{ template.category|default('Uncategorized') }}</span>
            <span class="text-xs text-gray-400 ml-auto">Updated: {{ template.updatedAt|date('M d, Y') }}</span>
        </div>
        <h2 class="text-lg font-bold text-gray-800 mb-1">{{ template.name }}</h2>
        <div class="text-xs text-gray-500 mb-2">
            <span class="font-mono bg-gray-100 px-2 py-0.5 rounded">{{ template.code }}</span>
        </div>
        <div class="mb-2">
            <span class="font-semibold text-gray-700">Subject:</span>
            <span class="text-gray-600">{{ template.subject }}</span>
        </div>
        <div class="text-gray-500 text-sm mb-3">{{ template.description }}</div>
    </div>
    <div class="flex items-center justify-between mt-2 template-actions">
        <a href="{{ path('email_template_edit', {'id': template.id}) }}" class="action-btn primary text-white bg-blue-600 hover:bg-blue-700 px-3 py-1 rounded flex items-center">
            <i class="fas fa-edit mr-1"></i>Edit
        </a>
        <a href="{{ path('email_template_delete', {'id': template.id}) }}" class="action-btn bg-red-100 text-red-700 hover:bg-red-200 px-3 py-1 rounded flex items-center">
            <i class="fas fa-trash mr-1"></i>Delete
        </a>
        <a href="{{ path('email_log_index', {'template': template.code}) }}" class="action-btn bg-gray-100 text-gray-700 hover:bg-gray-200 px-3 py-1 rounded flex items-center">
            <i class="fas fa-history mr-1"></i>View Logs
        </a>
    </div>
</div> 