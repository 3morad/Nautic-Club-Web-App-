<div class="mb-8">
    <h2 class="text-xl font-bold text-gray-800 mb-4">Review & Send</h2>
    
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
        <!-- Template Summary -->
        <div class="bg-white rounded-lg shadow-sm p-6 border border-gray-100">
            <div class="flex items-center justify-between mb-4">
                <h3 class="text-lg font-semibold text-gray-800">Template</h3>
                <a href="#step-1" class="text-blue-600 hover:text-blue-800 text-sm flex items-center">
                    <i class="fas fa-edit mr-1"></i> Change
                </a>
            </div>
            
            {% if selectedTemplate is defined and selectedTemplate %}
                <div class="mb-4">
                    <span class="inline-block bg-blue-100 text-blue-700 text-xs font-medium px-2.5 py-0.5 rounded-full mb-2">
                        {{ selectedTemplate.category|default('Uncategorized')|capitalize }}
                    </span>
                    <h4 class="text-gray-900 font-bold mb-1">{{ selectedTemplate.name }}</h4>
                    <div class="text-xs text-gray-500 mb-2">
                        <span class="font-mono bg-gray-100 px-2 py-0.5 rounded">{{ selectedTemplate.code }}</span>
                    </div>
                </div>
                
                <div class="mb-4">
                    <div class="font-medium text-gray-700 mb-1">Subject</div>
                    <div class="bg-gray-50 p-2 rounded border border-gray-200 text-gray-600">
                        {{ selectedTemplate.subject }}
                    </div>
                </div>
                
                <button type="button" class="text-sm text-green-600 hover:text-green-700 flex items-center" data-bs-toggle="modal" data-bs-target="#previewEmailModal">
                    <i class="fas fa-eye mr-1"></i> Preview Email
                </button>
            {% else %}
                <div class="p-4 rounded-lg bg-yellow-50 text-yellow-800 border border-yellow-200">
                    <i class="fas fa-exclamation-triangle mr-2"></i>
                    No template selected. <a href="#step-1" class="font-medium underline">Go back</a> to select a template.
                </div>
            {% endif %}
        </div>
        
        <!-- Recipients Summary -->
        <div class="bg-white rounded-lg shadow-sm p-6 border border-gray-100">
            <div class="flex items-center justify-between mb-4">
                <h3 class="text-lg font-semibold text-gray-800">Recipients</h3>
                <a href="#step-2" class="text-blue-600 hover:text-blue-800 text-sm flex items-center">
                    <i class="fas fa-edit mr-1"></i> Change
                </a>
            </div>
            
            <div class="mb-4">
                <div class="flex items-center justify-between mb-3">
                    <div class="font-medium text-gray-700">Total Recipients</div>
                    <div class="text-2xl font-bold text-blue-600">{{ recipientCount|default(0) }}</div>
                </div>
                
                <div class="h-2 bg-gray-200 rounded-full mb-3">
                    <div class="h-2 bg-blue-600 rounded-full" style="width: 100%"></div>
                </div>
                
                <div class="grid grid-cols-2 gap-4 text-center">
                    <div class="bg-gray-50 p-3 rounded-lg">
                        <div class="text-sm text-gray-500">Individual Users</div>
                        <div class="font-semibold text-gray-700">{{ individualCount|default(0) }}</div>
                    </div>
                    <div class="bg-gray-50 p-3 rounded-lg">
                        <div class="text-sm text-gray-500">From Groups</div>
                        <div class="font-semibold text-gray-700">{{ groupCount|default(0) }}</div>
                    </div>
                </div>
            </div>
            
            <button type="button" class="text-sm text-blue-600 hover:text-blue-800 flex items-center" data-bs-toggle="modal" data-bs-target="#recipientListModal">
                <i class="fas fa-list mr-1"></i> View Complete List
            </button>
        </div>
    </div>
    
    <!-- Sending Options -->
    <div class="bg-white rounded-lg shadow-sm p-6 border border-gray-100 mb-6">
        <h3 class="text-lg font-semibold text-gray-800 mb-4">Sending Options</h3>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
                <div class="mb-4">
                    <label for="senderName" class="block text-sm font-medium text-gray-700 mb-1">Sender Name</label>
                    <input type="text" id="senderName" name="senderName" value="Nautic Club" 
                           class="w-full p-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500">
                </div>
                
                <div class="mb-4">
                    <label for="senderEmail" class="block text-sm font-medium text-gray-700 mb-1">Sender Email</label>
                    <input type="email" id="senderEmail" name="senderEmail" value="info@nauticclub.com" 
                           class="w-full p-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500">
                </div>
            </div>
            
            <div>
                <div class="mb-4">
                    <label for="scheduleSend" class="flex items-center">
                        <input type="checkbox" id="scheduleSend" name="scheduleSend" class="form-checkbox h-5 w-5 text-blue-600 rounded">
                        <span class="ml-2 text-sm font-medium text-gray-700">Schedule for later</span>
                    </label>
                </div>
                
                <div id="scheduleOptions" class="hidden mb-4">
                    <label for="scheduleDate" class="block text-sm font-medium text-gray-700 mb-1">Date & Time</label>
                    <input type="datetime-local" id="scheduleDate" name="scheduleDate" 
                           class="w-full p-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500">
                </div>
                
                <div class="mb-4">
                    <label for="trackOpens" class="flex items-center">
                        <input type="checkbox" id="trackOpens" name="trackOpens" class="form-checkbox h-5 w-5 text-blue-600 rounded" checked>
                        <span class="ml-2 text-sm font-medium text-gray-700">Track opens and clicks</span>
                    </label>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Send Campaign Button -->
    <div class="bg-blue-50 rounded-lg p-6 border border-blue-100">
        <div class="flex flex-col md:flex-row items-center justify-between">
            <div class="mb-4 md:mb-0">
                <h3 class="text-lg font-semibold text-blue-800 mb-1">Ready to Send?</h3>
                <p class="text-blue-600">This campaign will be sent to {{ recipientCount|default(0) }} recipients.</p>
            </div>
            
            <div class="flex flex-col sm:flex-row gap-3">
                <button type="button" class="px-6 py-3 bg-gray-200 text-gray-800 font-medium rounded-lg hover:bg-gray-300 flex items-center justify-center">
                    <i class="fas fa-save mr-2"></i> Save Draft
                </button>
                <button type="submit" id="sendCampaign" class="px-6 py-3 bg-blue-600 text-white font-medium rounded-lg hover:bg-blue-700 flex items-center justify-center">
                    <i class="fas fa-paper-plane mr-2"></i> Send Campaign
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Preview Email Modal -->
<div class="modal fade" id="previewEmailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-blue-600 text-white">
                <h5 class="modal-title">Email Preview</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="p-2 mb-3 border-b border-gray-200">
                    <div class="mb-1"><strong>From:</strong> Nautic Club &lt;info@nauticclub.com&gt;</div>
                    <div class="mb-1"><strong>To:</strong> [Recipient]</div>
                    <div><strong>Subject:</strong> {{ selectedTemplate.subject|default('Subject will appear here') }}</div>
                </div>
                <div class="email-preview-content p-4 bg-white rounded-lg border">
                    <div class="flex justify-center items-center py-10">
                        <div class="spinner-border text-blue-500" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary">
                    <i class="fas fa-envelope mr-1"></i> Send Test Email
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Recipient List Modal -->
<div class="modal fade" id="recipientListModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-blue-600 text-white">
                <h5 class="modal-title">Recipient List</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="mb-4">
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                            <i class="fas fa-search text-gray-400"></i>
                        </div>
                        <input type="text" id="recipientSearch" placeholder="Search recipients..." 
                               class="pl-10 w-full py-2 px-4 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500">
                    </div>
                </div>
                
                <div class="overflow-auto max-h-96">
                    <table class="min-w-full divide-y divide-gray-200">
                        <thead class="bg-gray-50 sticky top-0">
                            <tr>
                                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                    Name
                                </th>
                                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                    Email
                                </th>
                                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                    Source
                                </th>
                            </tr>
                        </thead>
                        <tbody class="bg-white divide-y divide-gray-200">
                            {% for recipient in recipients|default([
                                {name: 'Admin User', email: 'admin@example.com', source: 'Individual'},
                                {name: 'Regular User', email: 'user@example.com', source: 'Group: All Users'},
                                {name: 'Farouk Nakach', email: 'ahmed@gmail.com', source: 'Individual'},
                                {name: 'Farouk Farouk', email: 'farouk@gmail.com', source: 'Group: Event Registrants'}
                            ]) %}
                                <tr>
                                    <td class="px-6 py-4 whitespace-nowrap">
                                        <div class="font-medium text-gray-900">{{ recipient.name }}</div>
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap">
                                        <div class="text-gray-600">{{ recipient.email }}</div>
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap">
                                        <div class="text-gray-600">{{ recipient.source }}</div>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Schedule options toggle
    const scheduleCheckbox = document.getElementById('scheduleSend');
    const scheduleOptions = document.getElementById('scheduleOptions');
    
    scheduleCheckbox.addEventListener('change', function() {
        if (this.checked) {
            scheduleOptions.classList.remove('hidden');
        } else {
            scheduleOptions.classList.add('hidden');
        }
    });
    
    // Send campaign confirmation
    const sendButton = document.getElementById('sendCampaign');
    
    sendButton.addEventListener('click', function(e) {
        const recipientCount = {{ recipientCount|default(0) }};
        
        if (recipientCount === 0) {
            e.preventDefault();
            alert('Please select at least one recipient before sending.');
            return;
        }
        
        if (!confirm(`Are you sure you want to send this campaign to ${recipientCount} recipients?`)) {
            e.preventDefault();
        }
    });
});
</script> 