{% extends 'admin/base.html.twig' %}

{% block title %}Email Logs{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .stats-card {
            transition: all 0.2s;
        }
        
        .stats-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
        }
    </style>
{% endblock %}

{% block body %}
<div class="container-fluid px-4">
    <div class="flex justify-between items-center mb-6 py-4 border-b border-gray-200">
        <h1 class="text-3xl font-bold text-gray-800 flex items-center">
            <i class="fas fa-history text-blue-600 mr-3"></i>Email Logs
        </h1>
        <a href="{{ path('email_dashboard') }}" class="px-4 py-2 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 flex items-center">
            <i class="fas fa-arrow-left mr-2"></i>Back to Dashboard
        </a>
    </div>
    
    <!-- Stats Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
        <!-- Total Emails -->
        <div class="bg-white rounded-lg shadow-md p-6 stats-card border-l-4 border-blue-500">
            <div class="flex items-center">
                <div class="rounded-full bg-blue-100 p-3 mr-4">
                    <i class="fas fa-envelope text-blue-500 text-xl"></i>
                </div>
                <div>
                    <div class="text-3xl font-bold text-gray-800">{{ total_emails|default(142) }}</div>
                    <div class="text-sm text-gray-500">Total Emails</div>
                </div>
            </div>
        </div>
        
        <!-- Delivery Rate -->
        <div class="bg-white rounded-lg shadow-md p-6 stats-card border-l-4 border-green-500">
            <div class="flex items-center">
                <div class="rounded-full bg-green-100 p-3 mr-4">
                    <i class="fas fa-check-circle text-green-500 text-xl"></i>
                </div>
                <div>
                    <div class="text-3xl font-bold text-gray-800">{{ delivery_rate|default('98.6%') }}</div>
                    <div class="text-sm text-gray-500">Delivery Rate</div>
                </div>
            </div>
        </div>
        
        <!-- Open Rate -->
        <div class="bg-white rounded-lg shadow-md p-6 stats-card border-l-4 border-purple-500">
            <div class="flex items-center">
                <div class="rounded-full bg-purple-100 p-3 mr-4">
                    <i class="fas fa-eye text-purple-500 text-xl"></i>
                </div>
                <div>
                    <div class="text-3xl font-bold text-gray-800">{{ open_rate|default('43.2%') }}</div>
                    <div class="text-sm text-gray-500">Open Rate</div>
                </div>
            </div>
        </div>
        
        <!-- Click Rate -->
        <div class="bg-white rounded-lg shadow-md p-6 stats-card border-l-4 border-yellow-500">
            <div class="flex items-center">
                <div class="rounded-full bg-yellow-100 p-3 mr-4">
                    <i class="fas fa-mouse-pointer text-yellow-500 text-xl"></i>
                </div>
                <div>
                    <div class="text-3xl font-bold text-gray-800">{{ click_rate|default('21.5%') }}</div>
                    <div class="text-sm text-gray-500">Click Rate</div>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Logs List -->
    <div class="mb-6">
        {% include 'email_dashboard/_logs_list.html.twig' with { 
            logs: logs|default([
                {id: 1, status: 'sent', recipient: {email: 'user1@example.com'}, subject: 'Welcome to Nautic Club', sentAt: 'now'|date_modify('-20 minutes'), template: {name: 'Welcome Email', code: 'welcome_email'}},
                {id: 2, status: 'delivered', recipient: {email: 'user2@example.com'}, subject: 'Upcoming Nautical Event', sentAt: 'now'|date_modify('-2 hours'), template: {name: 'Event Notification', code: 'event_notification'}},
                {id: 3, status: 'opened', recipient: {email: 'user3@example.com'}, subject: 'Your Membership Renewal', sentAt: 'now'|date_modify('-1 day'), template: {name: 'Membership Renewal', code: 'membership_renewal'}},
                {id: 4, status: 'clicked', recipient: {email: 'user4@example.com'}, subject: 'Special Offer for Members', sentAt: 'now'|date_modify('-3 days'), template: {name: 'Promotion', code: 'special_promotion'}},
                {id: 5, status: 'failed', recipient: {email: 'invalid@example'}, subject: 'Monthly Newsletter', sentAt: 'now'|date_modify('-5 days'), template: {name: 'Newsletter', code: 'monthly_newsletter'}}
            ]),
            total_logs: total_logs|default(142)
        } %}
    </div>
    
    <!-- Additional Resources -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-6">
        <div class="bg-white rounded-lg shadow-md p-6">
            <h3 class="text-lg font-bold text-gray-800 mb-4 flex items-center">
                <i class="fas fa-chart-bar text-blue-500 mr-2"></i> Email Analytics
            </h3>
            <p class="text-gray-600 mb-4">Get detailed insights into your email campaign performance.</p>
            <a href="{{ path('email_log_stats') }}" class="text-blue-600 hover:text-blue-800 flex items-center">
                View Analytics <i class="fas fa-arrow-right ml-1"></i>
            </a>
        </div>
        
        <div class="bg-white rounded-lg shadow-md p-6">
            <h3 class="text-lg font-bold text-gray-800 mb-4 flex items-center">
                <i class="fas fa-paper-plane text-blue-500 mr-2"></i> Send New Campaign
            </h3>
            <p class="text-gray-600 mb-4">Create and send a new email campaign to your users.</p>
            <a href="{{ path('email_bulk_send') }}" class="text-blue-600 hover:text-blue-800 flex items-center">
                Start Campaign <i class="fas fa-arrow-right ml-1"></i>
            </a>
        </div>
        
        <div class="bg-white rounded-lg shadow-md p-6">
            <h3 class="text-lg font-bold text-gray-800 mb-4 flex items-center">
                <i class="fas fa-file-code text-blue-500 mr-2"></i> Manage Templates
            </h3>
            <p class="text-gray-600 mb-4">View, edit or create email templates for your campaigns.</p>
            <a href="{{ path('email_template_index') }}" class="text-blue-600 hover:text-blue-800 flex items-center">
                View Templates <i class="fas fa-arrow-right ml-1"></i>
            </a>
        </div>
    </div>
</div>

<!-- Export Options Modal -->
<div id="export-modal" class="fixed inset-0 overflow-y-auto hidden z-50">
    <div class="flex items-center justify-center min-h-screen pt-4 px-4 pb-20 text-center sm:block sm:p-0">
        <div class="fixed inset-0 transition-opacity" aria-hidden="true">
            <div class="absolute inset-0 bg-gray-500 opacity-75"></div>
        </div>
        <span class="hidden sm:inline-block sm:align-middle sm:h-screen" aria-hidden="true">&#8203;</span>
        <div class="inline-block align-bottom bg-white rounded-lg text-left overflow-hidden shadow-xl transform transition-all sm:my-8 sm:align-middle sm:max-w-lg sm:w-full">
            <div class="bg-white px-4 pt-5 pb-4 sm:p-6 sm:pb-4">
                <div class="sm:flex sm:items-start">
                    <div class="mx-auto flex-shrink-0 flex items-center justify-center h-12 w-12 rounded-full bg-blue-100 sm:mx-0 sm:h-10 sm:w-10">
                        <i class="fas fa-file-export text-blue-600"></i>
                    </div>
                    <div class="mt-3 text-center sm:mt-0 sm:ml-4 sm:text-left">
                        <h3 class="text-lg leading-6 font-medium text-gray-900" id="modal-title">
                            Export Email Logs
                        </h3>
                        <div class="mt-2">
                            <p class="text-sm text-gray-500">
                                Choose a format to export your email logs.
                            </p>
                        </div>
                        
                        <div class="mt-4">
                            <div class="space-y-4">
                                <div class="flex items-center">
                                    <input id="export-csv" name="export-format" type="radio" class="focus:ring-blue-500 h-4 w-4 text-blue-600 border-gray-300" checked>
                                    <label for="export-csv" class="ml-3 block text-sm font-medium text-gray-700">
                                        CSV (.csv)
                                    </label>
                                </div>
                                <div class="flex items-center">
                                    <input id="export-excel" name="export-format" type="radio" class="focus:ring-blue-500 h-4 w-4 text-blue-600 border-gray-300">
                                    <label for="export-excel" class="ml-3 block text-sm font-medium text-gray-700">
                                        Excel (.xlsx)
                                    </label>
                                </div>
                                <div class="flex items-center">
                                    <input id="export-pdf" name="export-format" type="radio" class="focus:ring-blue-500 h-4 w-4 text-blue-600 border-gray-300">
                                    <label for="export-pdf" class="ml-3 block text-sm font-medium text-gray-700">
                                        PDF (.pdf)
                                    </label>
                                </div>
                            </div>
                            
                            <div class="mt-4">
                                <div class="flex items-start">
                                    <div class="flex items-center h-5">
                                        <input id="export-all" name="export-all" type="checkbox" class="focus:ring-blue-500 h-4 w-4 text-blue-600 border-gray-300 rounded">
                                    </div>
                                    <div class="ml-3 text-sm">
                                        <label for="export-all" class="font-medium text-gray-700">Export all logs</label>
                                        <p class="text-gray-500">If unchecked, only current filtered logs will be exported</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="bg-gray-50 px-4 py-3 sm:px-6 sm:flex sm:flex-row-reverse">
                <button type="button" id="export-btn" class="w-full inline-flex justify-center rounded-md border border-transparent shadow-sm px-4 py-2 bg-blue-600 text-base font-medium text-white hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 sm:ml-3 sm:w-auto sm:text-sm">
                    Export
                </button>
                <button type="button" id="cancel-export-btn" class="mt-3 w-full inline-flex justify-center rounded-md border border-gray-300 shadow-sm px-4 py-2 bg-white text-base font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 sm:mt-0 sm:ml-3 sm:w-auto sm:text-sm">
                    Cancel
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Toast Notifications -->
<div class="fixed bottom-4 right-4 z-50" id="toast-container"></div>

{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Export modal functionality
            const exportModal = document.getElementById('export-modal');
            const cancelExportBtn = document.getElementById('cancel-export-btn');
            const exportBtn = document.getElementById('export-btn');
            
            // Open export modal (this would be triggered by a button in the UI)
            function openExportModal() {
                exportModal.classList.remove('hidden');
            }
            
            // Close the export modal
            cancelExportBtn.addEventListener('click', function() {
                exportModal.classList.add('hidden');
            });
            
            // Handle export button click
            exportBtn.addEventListener('click', function() {
                const format = document.querySelector('input[name="export-format"]:checked').id.replace('export-', '');
                const exportAll = document.getElementById('export-all').checked;
                
                // Here you would trigger the export via AJAX or redirect to an export endpoint
                console.log('Exporting logs in format:', format, 'Export all:', exportAll);
                
                // Show a toast notification
                showToast(`Exporting email logs as ${format.toUpperCase()}...`, 'info');
                
                // Close the modal
                exportModal.classList.add('hidden');
                
                // Simulate export completion after a delay
                setTimeout(() => {
                    showToast('Export completed! File is ready for download.', 'success');
                }, 2000);
            });
            
            // Close modal when clicking outside
            exportModal.addEventListener('click', function(event) {
                if (event.target === exportModal) {
                    exportModal.classList.add('hidden');
                }
            });
            
            // Add a global export button click handler
            document.querySelectorAll('.export-logs-btn').forEach(btn => {
                btn.addEventListener('click', openExportModal);
            });
            
            // Toast notification function
            function showToast(message, type = 'info') {
                const toastContainer = document.getElementById('toast-container');
                const toast = document.createElement('div');
                
                let bgColor = 'bg-blue-500';
                let icon = 'info-circle';
                
                if (type === 'success') {
                    bgColor = 'bg-green-500';
                    icon = 'check-circle';
                } else if (type === 'error') {
                    bgColor = 'bg-red-500';
                    icon = 'exclamation-circle';
                } else if (type === 'warning') {
                    bgColor = 'bg-yellow-500';
                    icon = 'exclamation-triangle';
                }
                
                toast.className = `${bgColor} text-white p-4 rounded-lg shadow-lg mb-3 flex items-center transform transition-transform duration-300 translate-x-full`;
                toast.innerHTML = `
                    <i class="fas fa-${icon} mr-2"></i>
                    <span>${message}</span>
                    <button class="ml-auto text-white hover:text-gray-200 focus:outline-none">
                        <i class="fas fa-times"></i>
                    </button>
                `;
                
                toastContainer.appendChild(toast);
                
                // Animate in
                setTimeout(() => {
                    toast.classList.remove('translate-x-full');
                }, 10);
                
                // Auto dismiss
                setTimeout(() => {
                    toast.classList.add('translate-x-full');
                    setTimeout(() => {
                        toastContainer.removeChild(toast);
                    }, 300);
                }, 5000);
                
                // Close button
                const closeBtn = toast.querySelector('button');
                closeBtn.addEventListener('click', () => {
                    toast.classList.add('translate-x-full');
                    setTimeout(() => {
                        toastContainer.removeChild(toast);
                    }, 300);
                });
            }
        });
    </script>
{% endblock %} 