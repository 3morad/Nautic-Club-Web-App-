            // Update email chips for custom recipients
            function updateCustomEmailsChips() {
                const emailChipsContainer = document.querySelector('.email-chips');
                const validEmailsCount = document.querySelector('.valid-email-count span');
                const invalidEmailsCount = document.querySelector('.invalid-email-count span');
                
                emailChipsContainer.innerHTML = '';
                
                const emailsText = customRecipientsInput.value.trim();
                if (!emailsText) {
                    document.querySelector('.valid-email-count').style.display = 'none';
                    document.querySelector('.invalid-email-count').style.display = 'none';
                    return;
                }
                
                const emails = emailsText.split(',').map(e => e.trim()).filter(e => e);
                let validCount = 0;
                let invalidCount = 0;
                
                emails.forEach(email => {
                    const isValid = validateEmail(email);
                    const chipEl = document.createElement('div');
                    chipEl.className = `email-chip ${isValid ? '' : 'invalid'}`;
                    
                    chipEl.innerHTML = `
                        ${email}
                        <span class="remove-chip" data-email="${email}">
                            <i class="fas fa-times"></i>
                        </span>
                    `;
                    
                    emailChipsContainer.appendChild(chipEl);
                    
                    if (isValid) {
                        validCount++;
                    } else {
                        invalidCount++;
                    }
                });
                
                // Update counters
                validEmailsCount.textContent = validCount;
                invalidEmailsCount.textContent = invalidCount;
                
                document.querySelector('.valid-email-count').style.display = validCount > 0 ? 'block' : 'none';
                document.querySelector('.invalid-email-count').style.display = invalidCount > 0 ? 'block' : 'none';
                
                // Add click event for removing chips
                document.querySelectorAll('.remove-chip').forEach(btn => {
                    btn.addEventListener('click', function() {
                        const emailToRemove = this.dataset.email;
                        const updatedEmails = emails.filter(e => e !== emailToRemove);
                        customRecipientsInput.value = updatedEmails.join(', ');
                        updateCustomEmailsChips();
                        updateRecipientInfo();
                    });
                });
            }
            
            // Validate email format
            function validateEmail(email) {
                const re = /^(([^<>()\[\]\\.,;:\s@"]+(\.[^<>()\[\]\\.,;:\s@"]+)*)|(".+"))@((\[[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}])|(([a-zA-Z\-0-9]+\.)+[a-zA-Z]{2,}))$/;
                return re.test(String(email).toLowerCase());
            }
            
            // Update recipient info based on selection
            function updateRecipientInfo() {
                const recipientType = document.querySelector('input[name="recipient_type"]:checked').value;
                const recipientCountEl = document.getElementById('recipientCount');
                const recipientCountNumber = document.getElementById('recipientCountNumber');
                
                let recipientCount = 0;
                
                if (recipientType === 'all_users') {
                    recipientCountEl.className = 'alert alert-info mt-2';
                    recipientCountEl.innerHTML = '<i class="fas fa-users me-2"></i> All users will receive this email';
                    recipientCountNumber.textContent = '{{ user_count|default("25+") }}';
                } 
                else if (recipientType === 'user_groups') {
                    const selectedGroups = document.querySelectorAll('input[name="user_groups[]"]:checked');
                    recipientCount = Array.from(selectedGroups).reduce((count, group) => {
                        const groupCountBadge = group.closest('.group-card').querySelector('.group-count');
                        const groupCount = parseInt(groupCountBadge.textContent) || 0;
                        return count + groupCount;
                    }, 0);
                    
                    if (selectedGroups.length > 0) {
                        const groupNames = Array.from(selectedGroups).map(g => {
                            return g.closest('.group-card').querySelector('.group-name').textContent;
                        });
                        
                        recipientCountEl.className = 'alert alert-info mt-2';
                        recipientCountEl.innerHTML = `<i class="fas fa-layer-group me-2"></i> Selected groups: ${groupNames.join(', ')}`;
                        recipientCountNumber.textContent = recipientCount;
                    } else {
                        recipientCountEl.className = 'alert alert-warning mt-2';
                        recipientCountEl.innerHTML = '<i class="fas fa-exclamation-triangle me-2"></i> No user groups selected';
                        recipientCountNumber.textContent = '0';
                    }
                }
                else if (recipientType === 'specific_users') {
                    const selectedUsers = document.querySelectorAll('input[name="specific_users[]"]:checked');
                    recipientCount = selectedUsers.length;
                    
                    document.querySelector('.selected-count').textContent = `${recipientCount} users selected`;
                    
                    if (recipientCount > 0) {
                        recipientCountEl.className = 'alert alert-info mt-2';
                        recipientCountEl.innerHTML = `<i class="fas fa-user-check me-2"></i> ${recipientCount} specific users selected`;
                        recipientCountNumber.textContent = recipientCount;
                    } else {
                        recipientCountEl.className = 'alert alert-warning mt-2';
                        recipientCountEl.innerHTML = '<i class="fas fa-exclamation-triangle me-2"></i> No users selected';
                        recipientCountNumber.textContent = '0';
                    }
                }
                else if (recipientType === 'custom') {
                    const validEmails = customRecipientsInput.value.split(',')
                        .map(e => e.trim())
                        .filter(e => e && validateEmail(e));
                    
                    recipientCount = validEmails.length;
                    
                    if (recipientCount > 0) {
                        recipientCountEl.className = 'alert alert-info mt-2';
                        recipientCountEl.innerHTML = `<i class="fas fa-envelope me-2"></i> ${recipientCount} valid email addresses`;
                        recipientCountNumber.textContent = recipientCount;
                    } else {
                        recipientCountEl.className = 'alert alert-warning mt-2';
                        recipientCountEl.innerHTML = '<i class="fas fa-exclamation-triangle me-2"></i> No valid email addresses';
                        recipientCountNumber.textContent = '0';
                    }
                }
            }
            
