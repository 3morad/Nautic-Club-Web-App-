{% extends 'admin/base.html.twig' %}

{% block title %}Bulk Email Sender{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        /* Additional stylesheet for Bulk Sender */
        .nav-link.disabled {
            color: #9CA3AF !important;
            cursor: not-allowed;
        }
        
        .form-checkbox {
            border-radius: 0.25rem !important;
        }
        
        .dropdown-menu {
            display: none;
        }
        
        .dropdown-menu.show {
            display: block;
        }
        
        .line-clamp-2 {
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }
    </style>
{% endblock %}

{% block body %}
<div class="container-fluid px-4">
    <div class="flex justify-between items-center mb-6 py-4 border-b border-gray-200">
        <h1 class="text-3xl font-bold text-gray-800 flex items-center">
            <i class="fas fa-paper-plane text-blue-600 mr-3"></i>Bulk Email Sender
        </h1>
        <a href="{{ path('email_dashboard') }}" class="px-4 py-2 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 flex items-center">
            <i class="fas fa-arrow-left mr-2"></i>Back to Dashboard
        </a>
    </div>
    
    <form method="post" action="{{ path('email_bulk_send_process') }}" id="bulk-send-form">
        <!-- Stepper Navigation -->
        <div class="mb-8" id="stepper-container">
            {% include 'email_dashboard/_stepper.html.twig' with { currentStep: currentStep|default(0) } %}
        </div>
        
        <!-- Steps Container -->
        <div id="steps-content">
            <!-- Step 1: Template Selection -->
            <div id="step-1" class="step-content {% if currentStep|default(0) != 0 %}hidden{% endif %}">
                {% include 'email_dashboard/_template_selection.html.twig' with { 
                    templates: templates|default([]),
                    selectedTemplate: selectedTemplate|default(null)
                } %}
                
                <div class="flex justify-end mt-6">
                    <button type="button" id="next-to-step-2" class="px-6 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 flex items-center">
                        Next <i class="fas fa-chevron-right ml-2"></i>
                    </button>
                </div>
            </div>
            
            <!-- Step 2: Recipient Selection -->
            <div id="step-2" class="step-content {% if currentStep|default(0) != 1 %}hidden{% endif %}">
                {% include 'email_dashboard/_recipient_selection.html.twig' with { 
                    users: users|default([]),
                    groups: groups|default([])
                } %}
                
                <div class="flex justify-between mt-6">
                    <button type="button" id="back-to-step-1" class="px-6 py-2 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 flex items-center">
                        <i class="fas fa-chevron-left mr-2"></i> Previous
                    </button>
                    <button type="button" id="next-to-step-3" class="px-6 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 flex items-center">
                        Next <i class="fas fa-chevron-right ml-2"></i>
                    </button>
                </div>
            </div>
            
            <!-- Step 3: Review & Send -->
            <div id="step-3" class="step-content {% if currentStep|default(0) != 2 %}hidden{% endif %}">
                {% include 'email_dashboard/_review_send.html.twig' with { 
                    selectedTemplate: selectedTemplate|default(null),
                    recipientCount: recipientCount|default(0),
                    individualCount: individualCount|default(0),
                    groupCount: groupCount|default(0),
                    recipients: recipients|default([])
                } %}
                
                <div class="flex justify-between mt-6">
                    <button type="button" id="back-to-step-2" class="px-6 py-2 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 flex items-center">
                        <i class="fas fa-chevron-left mr-2"></i> Previous
                    </button>
                </div>
            </div>
        </div>
    </form>
</div>

<!-- Toast Notifications -->
<div class="fixed bottom-4 right-4 z-50" id="toast-container"></div>

{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Step navigation
            const stepperContainer = document.getElementById('stepper-container');
            const stepsContent = document.querySelectorAll('.step-content');
            let currentStep = {{ currentStep|default(0) }};
            
            // Template selection validation
            const nextToStep2 = document.getElementById('next-to-step-2');
            
            nextToStep2.addEventListener('click', function() {
                const selectedTemplate = document.querySelector('.template-radio:checked');
                
                if (!selectedTemplate) {
                    showToast('Please select a template before proceeding.', 'error');
                    return;
                }
                
                goToStep(1);
            });
            
            // Recipient selection validation
            const nextToStep3 = document.getElementById('next-to-step-3');
            
            nextToStep3.addEventListener('click', function() {
                const selectedUsers = document.querySelectorAll('.user-checkbox:checked');
                const selectedGroups = document.querySelectorAll('input[name="groups[]"]:checked');
                const manualEmailsField = document.getElementById('manualEmails');
                
                let hasRecipients = selectedUsers.length > 0 || selectedGroups.length > 0;
                
                if (manualEmailsField && manualEmailsField.value.trim() !== '') {
                    hasRecipients = true;
                }
                
                if (!hasRecipients) {
                    showToast('Please select at least one recipient before proceeding.', 'error');
                    return;
                }
                
                goToStep(2);
            });
            
            // Previous buttons
            const backToStep1 = document.getElementById('back-to-step-1');
            const backToStep2 = document.getElementById('back-to-step-2');
            
            backToStep1.addEventListener('click', function() {
                goToStep(0);
            });
            
            backToStep2.addEventListener('click', function() {
                goToStep(1);
            });
            
            // Navigate to step function
            function goToStep(stepIndex) {
                // Update UI
                stepsContent.forEach((step, index) => {
                    if (index === stepIndex) {
                        step.classList.remove('hidden');
                    } else {
                        step.classList.add('hidden');
                    }
                });
                
                // Update currentStep
                currentStep = stepIndex;
                
                // Update stepper
                stepperContainer.innerHTML = '';
                const stepperTemplate = document.createElement('template');
                stepperTemplate.innerHTML = `{% include 'email_dashboard/_stepper.html.twig' with { currentStep: ${currentStep} } %}`;
                stepperContainer.appendChild(stepperTemplate.content.firstChild);
                
                // Update form state
                document.querySelector('input[name="current_step"]').value = currentStep;
                
                // Scroll to top
                window.scrollTo(0, 0);
            }
            
            // Toast notification function
            function showToast(message, type = 'info') {
                const toastContainer = document.getElementById('toast-container');
                const toast = document.createElement('div');
                
                let bgColor = 'bg-blue-500';
                let icon = 'info-circle';
                
                if (type === 'success') {
                    bgColor = 'bg-green-500';
                    icon = 'check-circle';
                } else if (type === 'error') {
                    bgColor = 'bg-red-500';
                    icon = 'exclamation-circle';
                } else if (type === 'warning') {
                    bgColor = 'bg-yellow-500';
                    icon = 'exclamation-triangle';
                }
                
                toast.className = `${bgColor} text-white p-4 rounded-lg shadow-lg mb-3 flex items-center transform transition-transform duration-300 translate-x-full`;
                toast.innerHTML = `
                    <i class="fas fa-${icon} mr-2"></i>
                    <span>${message}</span>
                    <button class="ml-auto text-white hover:text-gray-200 focus:outline-none">
                        <i class="fas fa-times"></i>
                    </button>
                `;
                
                toastContainer.appendChild(toast);
                
                // Animate in
                setTimeout(() => {
                    toast.classList.remove('translate-x-full');
                }, 10);
                
                // Auto dismiss
                setTimeout(() => {
                    toast.classList.add('translate-x-full');
                    setTimeout(() => {
                        toastContainer.removeChild(toast);
                    }, 300);
                }, 5000);
                
                // Close button
                const closeBtn = toast.querySelector('button');
                closeBtn.addEventListener('click', () => {
                    toast.classList.add('translate-x-full');
                    setTimeout(() => {
                        toastContainer.removeChild(toast);
                    }, 300);
                });
            }
            
            // Show success toast if redirect with success message
            {% if app.session.flashBag.has('success') %}
                {% for message in app.session.flashBag.get('success') %}
                    showToast('{{ message }}', 'success');
                {% endfor %}
            {% endif %}
            
            // Show error toast if redirect with error message
            {% if app.session.flashBag.has('error') %}
                {% for message in app.session.flashBag.get('error') %}
                    showToast('{{ message }}', 'error');
                {% endfor %}
            {% endif %}
        });
    </script>
{% endblock %} 