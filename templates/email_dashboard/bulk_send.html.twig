        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">
                    <i class="fas fa-plus-circle me-2"></i> Create New Email Template
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="quickTemplateForm" action="{{ path('email_template_new') }}" method="post">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label for="template_name" class="form-label">Template Name <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="template_name" name="template[name]" required>
                        </div>
                        <div class="col-md-6">
                            <label for="template_code" class="form-label">Template Code <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="template_code" name="template[code]" 
                                pattern="[a-z0-9_]+" title="Use only lowercase letters, numbers and underscores" required>
                            <div class="form-text">Unique identifier (e.g., welcome_email, event_reminder)</div>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-8">
                            <label for="template_subject" class="form-label">Email Subject <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="template_subject" name="template[subject]" required>
                        </div>
                        <div class="col-md-4">
                            <label for="template_category" class="form-label">Category <span class="text-danger">*</span></label>
                            <select class="form-select" id="template_category" name="template[category]" required>
                                <option value="">Select category</option>
                                <option value="system">System</option>
                                <option value="notifications">Notifications</option>
                                <option value="events">Events</option>
                                <option value="marketing">Marketing</option>
                            </select>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="template_view_name" class="form-label">Template File Name <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <input type="text" class="form-control" id="template_view_name" name="template[view_name]" required>
                            <span class="input-group-text">.html.twig</span>
                        </div>
                        <div class="form-text">Name of the template file without extension</div>
                    </div>

                    <div class="mb-3">
                        <label for="template_description" class="form-label">Description</label>
                        <textarea class="form-control" id="template_description" name="template[description]" rows="2"></textarea>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Template Variables</label>
                        <div class="alert alert-info">
                            <i class="fas fa-info-circle me-2"></i> These variables will be available in your template:
                            <ul class="mb-0 mt-2">
                                <li><code>{{ '{{recipient.firstName}}' }}</code> - The user's first name</li>
                                <li><code>{{ '{{recipient.lastName}}' }}</code> - The user's last name</li>
                                <li><code>{{ '{{recipient.email}}' }}</code> - The user's email address</li>
                                <li><code>{{ '{{app_name}}' }}</code> - The application name</li>
                                <li><code>{{ '{{current_year}}' }}</code> - The current year</li>
                            </ul>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" id="submitTemplateBtn" class="btn btn-primary">
                    <i class="fas fa-save me-1"></i> Create Template
                </button>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Template selection
            const templateItems = document.querySelectorAll('.template-item');
            const templateRadios = document.querySelectorAll('.template-radio');
            const previewTemplateBtn = document.getElementById('previewTemplateBtn');
            const stepElements = document.querySelectorAll('.step');
            
            // Recipient containers
            const userGroupsContainer = document.querySelector('.user-groups-container');
            const specificUsersContainer = document.querySelector('.specific-users-container');
            const customEmailsContainer = document.querySelector('.custom-emails-container');
            
            // Add click event listeners to template cards
            templateItems.forEach(item => {
                const templateCard = item.querySelector('.template-card');
                const radio = item.querySelector('.template-radio');
                const previewBtn = item.querySelector('.action-button.preview');
                const selectBtn = item.querySelector('.action-button.select');
                
                // Select on card click
                templateCard.addEventListener('click', function(e) {
                    if (!e.target.closest('.action-button')) {
                        selectTemplate(item);
                    }
                });
                
                // Select button click
                selectBtn.addEventListener('click', function() {
                    selectTemplate(item);
                });
                
                // Preview button click
                previewBtn.addEventListener('click', function() {
                    const templateCode = item.dataset.templateCode;
                    previewTemplate(templateCode);
                });
            });
            
            // Function to select a template
            function selectTemplate(item) {
                const templateCode = item.dataset.templateCode;
                const radio = item.querySelector('.template-radio');
                
                // Update UI
                templateItems.forEach(i => {
                    i.querySelector('.template-card').classList.remove('selected');
                });
                item.querySelector('.template-card').classList.add('selected');
                
                // Check the radio
                radio.checked = true;
                
                // Enable preview button
                previewTemplateBtn.disabled = false;
                
                // Update preview
                updateTemplatePreview(templateCode);
                
                // Mark step 1 as completed and step 2 as active
                stepElements[0].classList.add('completed');
                stepElements[1].classList.add('active');
                
                // Scroll to recipient section
                const recipientSection = document.querySelector('h5.section-title:nth-of-type(2)');
                if (recipientSection) {
                    recipientSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
                }
            }
            
            // Function to preview a template
            function previewTemplate(templateCode) {
                // In real implementation, this would fetch the actual template preview via AJAX
                const modal = new bootstrap.Modal(document.getElementById('previewModal'));
                
                // Show loading state
                document.getElementById('previewModalBody').innerHTML = '<div class="text-center py-5"><div class="spinner-border text-primary" role="status"></div><p class="mt-3">Loading template preview...</p></div>';
                modal.show();
                
                // Simulate AJAX call to get template preview
                setTimeout(() => {
                    // Get template details from the selected card
                    const selectedTemplate = Array.from(templateItems).find(item => item.dataset.templateCode === templateCode);
                    
                    if (selectedTemplate) {
                        const templateName = selectedTemplate.querySelector('.template-name').textContent;
                        const templateSubject = selectedTemplate.querySelector('.template-subject').textContent.trim();
                        const templateCode = selectedTemplate.querySelector('.template-code code').textContent;
                        
                        // Update modal with template info
                        document.getElementById('previewModalTitle').textContent = templateName;
                        
                        // Create template content
                        {% verbatim %}
                        const emailContent = `
                            <div class="preview-container">
                                <div class="email-preview-header p-3 bg-light rounded mb-3">
                                    <div class="row">
                                        <div class="col-md-8">
                                            <div class="mb-2"><strong><i class="fas fa-envelope me-2"></i>Subject:</strong> ${templateSubject}</div>
                                            <div class="mb-2"><strong><i class="fas fa-paper-plane me-2"></i>From:</strong> Nautic Club &lt;noreply@nauticclub.com&gt;</div>
                                            <div><strong><i class="fas fa-user me-2"></i>To:</strong> {{recipient.firstName}} {{recipient.lastName}} &lt;{{recipient.email}}&gt;</div>
                                        </div>
                                        <div class="col-md-4 text-end">
                                            <span class="badge bg-primary mb-2">Template: ${templateName}</span><br>
                                            <span class="badge bg-secondary">Code: ${templateCode}</span>
                                        </div>
                                    </div>
                                </div>
                                
                                <ul class="nav nav-tabs" id="previewTabs" role="tablist">
                                    <li class="nav-item" role="presentation">
                                        <button class="nav-link active" id="rendered-tab" data-bs-toggle="tab" data-bs-target="#rendered" type="button" role="tab">
                                            <i class="fas fa-eye me-1"></i> Rendered View
                                        </button>
                                    </li>
                                    <li class="nav-item" role="presentation">
                                        <button class="nav-link" id="html-tab" data-bs-toggle="tab" data-bs-target="#html" type="button" role="tab">
                                            <i class="fas fa-code me-1"></i> HTML Source
                                        </button>
                                    </li>
                                    <li class="nav-item" role="presentation">
                                        <button class="nav-link" id="variables-tab" data-bs-toggle="tab" data-bs-target="#variables" type="button" role="tab">
                                            <i class="fas fa-code-branch me-1"></i> Variables
