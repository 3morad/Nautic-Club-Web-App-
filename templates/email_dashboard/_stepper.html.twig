<div class="flex items-center justify-between mb-8">
    {% set steps = [
        { 'title': 'Select Template', 'desc': 'Choose an email template to use' },
        { 'title': 'Choose Recipients', 'desc': 'Select who will receive the email' },
        { 'title': 'Review & Send', 'desc': 'Confirm and send your campaign' }
    ] %}
    {% for step in steps %}
        <div class="flex-1 flex items-center relative">
            <div class="flex flex-col items-center">
                <div class="w-10 h-10 flex items-center justify-center rounded-full font-bold text-lg
                    {% if loop.index0 < currentStep %} bg-green-500 text-white
                    {% elseif loop.index0 == currentStep %} bg-blue-600 text-white
                    {% else %} bg-gray-200 text-gray-500 {% endif %}">
                    {{ loop.index }}
                </div>
                <div class="mt-2 text-sm font-semibold {% if loop.index0 == currentStep %}text-blue-600{% else %}text-gray-700{% endif %}">
                    {{ step.title }}
                </div>
                <div class="text-xs text-gray-400 text-center max-w-xs">{{ step.desc }}</div>
            </div>
            {% if not loop.last %}
                <div class="flex-1 h-1 mx-2 rounded bg-gray-200 {% if loop.index0 < currentStep %}bg-green-400{% elseif loop.index0 == currentStep %}bg-blue-300{% endif %}"></div>
            {% endif %}
        </div>
    {% endfor %}
</div> 