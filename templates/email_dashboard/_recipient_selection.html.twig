<div class="mb-8">
    <h2 class="text-xl font-bold text-gray-800 mb-4">Choose Recipients</h2>

    <!-- Recipient Selection Options -->
    <div class="bg-white rounded-lg shadow-sm p-4 mb-6">
        <ul class="flex border-b border-gray-200 mb-4" role="tablist">
            <li class="mr-2">
                <button class="px-4 py-2 text-sm font-medium rounded-t-lg border-b-2 border-blue-500 text-blue-600 active" 
                        id="users-tab" data-bs-toggle="tab" data-bs-target="#users-content" type="button" role="tab" aria-selected="true">
                    <i class="fas fa-users mr-2"></i> All Users
                </button>
            </li>
            <li class="mr-2">
                <button class="px-4 py-2 text-sm font-medium rounded-t-lg border-b-2 border-transparent hover:border-gray-300 text-gray-500 hover:text-gray-600" 
                        id="groups-tab" data-bs-toggle="tab" data-bs-target="#groups-content" type="button" role="tab" aria-selected="false">
                    <i class="fas fa-layer-group mr-2"></i> Groups
                </button>
            </li>
            <li>
                <button class="px-4 py-2 text-sm font-medium rounded-t-lg border-b-2 border-transparent hover:border-gray-300 text-gray-500 hover:text-gray-600" 
                        id="manual-tab" data-bs-toggle="tab" data-bs-target="#manual-content" type="button" role="tab" aria-selected="false">
                    <i class="fas fa-pen mr-2"></i> Manual Entry
                </button>
            </li>
        </ul>
        
        <div class="tab-content">
            <!-- All Users Tab -->
            <div class="tab-pane fade show active" id="users-content" role="tabpanel" aria-labelledby="users-tab">
                <div class="flex items-center space-x-4 mb-4">
                    <div class="flex-1">
                        <div class="relative">
                            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                <i class="fas fa-search text-gray-400"></i>
                            </div>
                            <input type="text" id="userSearch" placeholder="Search users by name or email..." 
                                   class="pl-10 w-full py-2 px-4 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500">
                        </div>
                    </div>
                    
                    <div class="flex items-center">
                        <button class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 flex items-center">
                            <i class="fas fa-check-square mr-2"></i> Select All
                        </button>
                    </div>
                </div>
                
                <div class="border rounded-lg overflow-hidden">
                    <table class="min-w-full divide-y divide-gray-200">
                        <thead class="bg-gray-50">
                            <tr>
                                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                    <input type="checkbox" id="select-all-users" class="form-checkbox rounded text-blue-600">
                                </th>
                                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                    Name
                                </th>
                                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                    Email
                                </th>
                                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                    Status
                                </th>
                            </tr>
                        </thead>
                        <tbody class="bg-white divide-y divide-gray-200" id="userTableBody">
                            {% for user in users|default([
                                {id: 1, name: 'Admin User', email: 'admin@example.com', status: 'Active'},
                                {id: 2, name: 'Regular User', email: 'user@example.com', status: 'Active'},
                                {id: 3, name: 'Farouk Nakach', email: 'ahmed@gmail.com', status: 'Active'},
                                {id: 4, name: 'Farouk Farouk', email: 'farouk@gmail.com', status: 'Inactive'}
                            ]) %}
                                <tr class="hover:bg-gray-50 user-row" data-name="{{ user.name|lower }}" data-email="{{ user.email|lower }}">
                                    <td class="px-6 py-4 whitespace-nowrap">
                                        <input type="checkbox" name="recipients[]" value="{{ user.id }}" 
                                              class="form-checkbox rounded text-blue-600 user-checkbox">
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap">
                                        <div class="font-medium text-gray-900">{{ user.name }}</div>
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap">
                                        <div class="text-gray-600">{{ user.email }}</div>
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap">
                                        <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full 
                                                    {% if user.status == 'Active' %}bg-green-100 text-green-800
                                                    {% else %}bg-gray-100 text-gray-800{% endif %}">
                                            {{ user.status }}
                                        </span>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
                
                <div class="mt-4 flex justify-between items-center">
                    <div class="text-sm text-gray-500">
                        <span id="selectedCount">0</span> users selected
                    </div>
                    <nav class="flex items-center">
                        <button class="px-3 py-1 rounded-md bg-white border border-gray-300 text-gray-500 hover:bg-gray-50 mr-2">
                            Previous
                        </button>
                        <div class="flex">
                            <a href="#" class="px-3 py-1 rounded-md bg-blue-600 text-white">1</a>
                            <a href="#" class="px-3 py-1 rounded-md text-gray-500 hover:bg-gray-50">2</a>
                            <a href="#" class="px-3 py-1 rounded-md text-gray-500 hover:bg-gray-50">3</a>
                        </div>
                        <button class="px-3 py-1 rounded-md bg-white border border-gray-300 text-gray-500 hover:bg-gray-50 ml-2">
                            Next
                        </button>
                    </nav>
                </div>
            </div>
            
            <!-- Groups Tab -->
            <div class="tab-pane fade" id="groups-content" role="tabpanel" aria-labelledby="groups-tab">
                <div class="p-4 rounded-lg bg-gray-50 border border-gray-200">
                    <div class="flex flex-wrap gap-3">
                        {% for group in groups|default([
                            {id: 1, name: 'All Users', count: 4},
                            {id: 2, name: 'Admin Users', count: 1},
                            {id: 3, name: 'Event Registrants', count: 3}
                        ]) %}
                            <div class="flex items-center p-3 bg-white rounded-lg border border-gray-300 hover:border-blue-400 transition-colors">
                                <input type="checkbox" name="groups[]" value="{{ group.id }}" class="form-checkbox rounded text-blue-600 mr-3">
                                <div>
                                    <div class="font-medium text-gray-900">{{ group.name }}</div>
                                    <div class="text-xs text-gray-500">{{ group.count }} user(s)</div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            </div>
            
            <!-- Manual Entry Tab -->
            <div class="tab-pane fade" id="manual-content" role="tabpanel" aria-labelledby="manual-tab">
                <div class="p-4 rounded-lg bg-gray-50 border border-gray-200">
                    <label for="manualEmails" class="block text-sm font-medium text-gray-700 mb-2">
                        Enter email addresses (one per line or comma-separated)
                    </label>
                    <textarea id="manualEmails" name="manualEmails" rows="6" 
                              class="w-full p-3 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500"
                              placeholder="example1@example.com&#10;example2@example.com&#10;or example1@example.com, example2@example.com"></textarea>
                    
                    <div class="mt-3 text-xs text-gray-500">
                        <i class="fas fa-info-circle mr-1"></i>
                        Email addresses will be validated before sending. Invalid emails will be skipped.
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Selected Recipients Summary -->
    <div class="bg-blue-50 border border-blue-200 rounded-lg p-4">
        <div class="flex items-center justify-between">
            <div>
                <h3 class="font-semibold text-blue-700 mb-1">Recipients Summary</h3>
                <div class="text-blue-600">
                    <span id="totalSelectedCount">0</span> recipients selected in total
                </div>
            </div>
            <div class="text-right">
                <div class="text-xs text-blue-600 mb-1">Email will be sent to selected recipients</div>
                <button type="button" class="text-xs underline text-blue-600 hover:text-blue-800">
                    <i class="fas fa-eye mr-1"></i> Preview recipient list
                </button>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // User search functionality
    const userSearchInput = document.getElementById('userSearch');
    const userRows = document.querySelectorAll('.user-row');
    
    userSearchInput.addEventListener('input', function() {
        const searchTerm = this.value.toLowerCase().trim();
        
        userRows.forEach(row => {
            const name = row.dataset.name;
            const email = row.dataset.email;
            
            if (name.includes(searchTerm) || email.includes(searchTerm)) {
                row.style.display = '';
            } else {
                row.style.display = 'none';
            }
        });
    });
    
    // Checkbox selection
    const selectAllCheckbox = document.getElementById('select-all-users');
    const userCheckboxes = document.querySelectorAll('.user-checkbox');
    const selectedCountElement = document.getElementById('selectedCount');
    const totalSelectedCountElement = document.getElementById('totalSelectedCount');
    
    function updateSelectedCount() {
        const selectedCount = document.querySelectorAll('.user-checkbox:checked').length;
        selectedCountElement.textContent = selectedCount;
        totalSelectedCountElement.textContent = selectedCount; // This would need to add group counts as well
    }
    
    selectAllCheckbox.addEventListener('change', function() {
        const isChecked = this.checked;
        
        userCheckboxes.forEach(checkbox => {
            const row = checkbox.closest('tr');
            if (window.getComputedStyle(row).display !== 'none') {
                checkbox.checked = isChecked;
            }
        });
        
        updateSelectedCount();
    });
    
    userCheckboxes.forEach(checkbox => {
        checkbox.addEventListener('change', updateSelectedCount);
    });
});
</script> 