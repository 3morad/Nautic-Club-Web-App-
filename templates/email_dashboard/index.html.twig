{% extends 'admin/base.html.twig' %}

{% block title %}Email System{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link href="https://cdn.jsdelivr.net/npm/simple-datatables@latest/dist/style.css" rel="stylesheet" />
    <style>
        .template-card {
            transition: transform 0.2s;
            border-radius: 0.5rem;
            overflow: hidden;
            box-shadow: 0 4px 6px rgba(0,0,0,0.04);
        }
        .template-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.1);
        }
        .category-pill {
            font-size: 0.8rem;
            padding: 0.25rem 0.75rem;
            border-radius: 50px;
        }
        .stats-box {
            position: relative;
            padding: 1.5rem;
            border-radius: 0.75rem;
            overflow: hidden;
            box-shadow: 0 4px 8px rgba(0,0,0,0.08);
            background: linear-gradient(135deg, var(--bg-start) 0%, var(--bg-end) 100%);
        }
        .stats-box.primary {
            --bg-start: #4e73df;
            --bg-end: #224abe;
        }
        .stats-box.success {
            --bg-start: #1cc88a;
            --bg-end: #169a67;
        }
        .stats-box.info {
            --bg-start: #36b9cc;
            --bg-end: #258391;
        }
        .stats-box.warning {
            --bg-start: #f6c23e;
            --bg-end: #daa520;
        }
        .stats-box .icon {
            position: absolute;
            top: 1rem;
            right: 1rem;
            font-size: 2.5rem;
            opacity: 0.2;
            color: rgba(255,255,255,0.5);
        }
        .stats-box .count {
            font-size: 2.5rem;
            font-weight: 700;
            line-height: 1;
            margin-bottom: 0.5rem;
        }
        .stats-box .label {
            font-size: 1rem;
            font-weight: 500;
            opacity: 0.8;
        }
        .stats-box .btn-light {
            background: rgba(255,255,255,0.2);
            border: none;
            color: white;
            transition: all 0.2s;
        }
        .stats-box .btn-light:hover {
            background: rgba(255,255,255,0.3);
            transform: translateY(-2px);
        }
        .chart-container {
            height: 300px;
        }
        .action-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            padding: 0.5rem 1rem;
            border-radius: 0.5rem;
            font-weight: 500;
            transition: all 0.2s;
        }
        .action-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        }
        .action-btn.primary {
            background: #4e73df;
            border-color: #4e73df;
        }
        .action-btn.primary:hover {
            background: #3a5ccc;
            border-color: #3a5ccc;
        }
        .template-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 1.5rem;
        }
        .template-actions {
            opacity: 0.7;
            transition: opacity 0.2s;
        }
        .template-card:hover .template-actions {
            opacity: 1;
        }
        .card {
            border: none;
            box-shadow: 0 0.15rem 1.75rem 0 rgba(58, 59, 69, 0.15);
            border-radius: 0.75rem;
        }
        .card-header {
            border-top-left-radius: 0.75rem !important;
            border-top-right-radius: 0.75rem !important;
            background-color: #f8f9fc;
            border-bottom: 1px solid #e3e6f0;
        }
        .card-footer {
            border-bottom-left-radius: 0.75rem !important;
            border-bottom-right-radius: 0.75rem !important;
            background-color: #f8f9fc;
            border-top: 1px solid #e3e6f0;
        }
        .heading-section {
            display: flex;
            align-items: center;
            margin-bottom: 1rem;
            padding-bottom: 1rem;
            border-bottom: 1px solid #e3e6f0;
        }
        .heading-section h1 {
            margin: 0;
            font-weight: 700;
            background: linear-gradient(135deg, #4e73df 0%, #224abe 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .heading-section .badge {
            margin-left: 1rem;
            padding: 0.5rem 1rem;
            border-radius: 50px;
            background: rgba(78, 115, 223, 0.1);
            color: #4e73df;
            font-weight: 500;
        }
    </style>
{% endblock %}

{% block body %}
<div class="container-fluid px-4">
    <div class="heading-section my-4">
        <h1 class="display-5">Email System</h1>
        <span class="badge">Dashboard</span>
        <div class="ms-auto d-flex gap-2">
            <a href="{{ path('email_bulk_send') }}" class="btn btn-primary action-btn primary">
                <i class="fas fa-paper-plane"></i>
                <span>Bulk Send</span>
            </a>
            <a href="{{ path('email_template_index') }}" class="btn btn-outline-primary action-btn">
                <i class="fas fa-plus"></i>
                <span>New Template</span>
            </a>
        </div>
    </div>
    
    <!-- Statistics Summary -->
    <div class="row mb-4">
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="stats-box text-white primary">
                <div class="icon">
                    <i class="fas fa-envelope-open-text"></i>
                </div>
                <div class="count">{{ templateCount }}</div>
                <div class="label">Email Templates</div>
                <div class="mt-3">
                    <a href="{{ path('email_template_index') }}" class="btn btn-light btn-sm">
                        Manage Templates
                    </a>
                </div>
            </div>
        </div>
        
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="stats-box text-white success">
                <div class="icon">
                    <i class="fas fa-paper-plane"></i>
                </div>
                <div class="count">{{ stats.sent|default(0) }}</div>
                <div class="label">Emails Sent</div>
                <div class="mt-3">
                    <a href="{{ path('email_log_index') }}" class="btn btn-light btn-sm">
                        View Logs
                    </a>
                </div>
            </div>
        </div>
        
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="stats-box text-white info">
                <div class="icon">
                    <i class="fas fa-clock"></i>
                </div>
                <div class="count">{{ stats.last24h|default(0) }}</div>
                <div class="label">Last 24 Hours</div>
                <div class="mt-3">
                    <a href="{{ path('email_log_stats') }}" class="btn btn-light btn-sm">
                        View Statistics
                    </a>
                </div>
            </div>
        </div>
        
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="stats-box text-white warning">
                <div class="icon">
                    <i class="fas fa-chart-line"></i>
                </div>
                <div class="count">{{ stats.successRate|default(100) }}%</div>
                <div class="label">Success Rate</div>
                <div class="mt-3">
                    <a href="{{ path('email_log_stats') }}" class="btn btn-light btn-sm">
                        View Details
                    </a>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Analytics and Charts -->
    <div class="row mb-4">
        <div class="col-xl-8 col-lg-7">
            <div class="card mb-4">
                <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
                    <h6 class="m-0 font-weight-bold text-primary">Email Activity</h6>
                    <div class="dropdown no-arrow">
                        <a class="dropdown-toggle" href="#" role="button" id="dropdownMenuLink"
                            data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="fas fa-ellipsis-v text-gray-400"></i>
                        </a>
                        <div class="dropdown-menu dropdown-menu-end shadow" aria-labelledby="dropdownMenuLink">
                            <div class="dropdown-header">Options:</div>
                            <a class="dropdown-item" href="{{ path('email_log_stats') }}">View Detailed Stats</a>
                            <a class="dropdown-item" href="#">Export Data</a>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <div class="chart-container">
                        <canvas id="emailActivityChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="col-xl-4 col-lg-5">
            <div class="card mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Categories</h6>
                </div>
                <div class="card-body">
                    <div class="chart-container" style="height: 250px;">
                        <canvas id="categoriesChart"></canvas>
                    </div>
                    <div class="mt-4 text-center small">
                        {% for category, count in categories %}
                            <span class="mr-2">
                                <i class="fas fa-circle text-{{ loop.index % 4 == 1 ? 'primary' : (loop.index % 4 == 2 ? 'success' : (loop.index % 4 == 3 ? 'info' : 'warning')) }}"></i> {{ category|capitalize }}
                            </span>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Email Templates -->
    <div class="card mb-4">
        <div class="card-header py-3 d-flex justify-content-between align-items-center">
            <h6 class="m-0 font-weight-bold text-primary">Email Templates</h6>
            <div class="btn-group">
                <button type="button" class="btn btn-sm btn-outline-primary category-filter active" data-category="all">
                    All Templates
                </button>
                {% for category, count in categories %}
                    <button type="button" class="btn btn-sm btn-outline-primary category-filter" data-category="{{ category }}">
                        {{ category|capitalize }}
                    </button>
                {% endfor %}
            </div>
        </div>
        <div class="card-body">
            {% if templates is empty %}
                <div class="alert alert-warning">
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    No email templates found. <a href="{{ path('email_template_index') }}">Create your first template</a>.
                </div>
            {% else %}
                <div class="template-grid mt-3" id="templates-container">
                    {% for template in templates %}
                        <div class="template-item" data-category="{{ template.category }}">
                            <div class="card template-card h-100">
                                <div class="card-header d-flex justify-content-between align-items-center">
                                    <span class="badge category-pill bg-{{ template.category == 'notifications' ? 'info' : (template.category == 'events' ? 'success' : 'primary') }}">
                                        {{ template.category|capitalize }}
                                    </span>
                                    <div class="dropdown">
                                        <button class="btn btn-sm btn-link text-dark" type="button" data-bs-toggle="dropdown">
                                            <i class="fas fa-ellipsis-v"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end">
                                            <li>
                                                <a class="dropdown-item" href="{{ path('email_template_edit', {'id': template.id}) }}">
                                                    <i class="fas fa-edit me-2"></i> Edit
                                                </a>
                                            </li>
                                            <li>
                                                <a class="dropdown-item" href="{{ path('email_template_preview', {'id': template.id}) }}" target="_blank">
                                                    <i class="fas fa-eye me-2"></i> Preview
                                                </a>
                                            </li>
                                            <li><hr class="dropdown-divider"></li>
                                            <li>
                                                <button class="dropdown-item test-email-btn" data-template-code="{{ template.code }}" data-template-name="{{ template.name }}">
                                                    <i class="fas fa-paper-plane me-2"></i> Send Test
                                                </button>
                                            </li>
                                        </ul>
                                    </div>
                                </div>
                                <div class="card-body">
                                    <h5 class="card-title">{{ template.name }}</h5>
                                    <p class="card-text small text-muted">{{ template.description|default('No description')|length > 100 ? template.description|slice(0, 100) ~ '...' : template.description }}</p>
                                    <div class="small">
                                        <strong>Code:</strong> <code>{{ template.code }}</code>
                                    </div>
                                    <div class="small">
                                        <strong>Subject:</strong> {{ template.subject }}
                                    </div>
                                </div>
                                <div class="card-footer">
                                    <div class="d-flex justify-content-between template-actions">
                                        <a href="{{ path('email_log_template', {'code': template.code}) }}" class="btn btn-sm btn-outline-secondary">
                                            <i class="fas fa-history me-1"></i> Logs
                                        </a>
                                        <a href="{{ path('email_template_edit', {'id': template.id}) }}" class="btn btn-sm btn-primary">
                                            <i class="fas fa-edit me-1"></i> Edit
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    </div>
</div>

<!-- Test Email Modal -->
<div class="modal fade" id="testEmailModal" tabindex="-1" aria-labelledby="testEmailModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="testEmailModalLabel">Send Test Email</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="testEmailForm" method="post" action="{{ path('email_send_test') }}">
                <div class="modal-body">
                    <input type="hidden" name="template" id="template_code">
                    <div class="mb-3">
                        <label for="recipient" class="form-label">Recipient Email</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fas fa-envelope"></i></span>
                            <input type="email" class="form-control" id="recipient" name="recipient" required placeholder="Enter email address">
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="name" class="form-label">Recipient Name</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fas fa-user"></i></span>
                            <input type="text" class="form-control" id="name" name="name" value="Test User" placeholder="Enter recipient name">
                        </div>
                    </div>
                    <div class="alert alert-info">
                        <i class="fas fa-info-circle me-2"></i>
                        Sending test email for template: <strong id="template_name_display"></strong>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-paper-plane me-2"></i> Send Test
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://cdn.jsdelivr.net/npm/chart.js@3.7.1/dist/chart.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/simple-datatables@latest"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Template filtering
            const categoryFilters = document.querySelectorAll('.category-filter');
            const templateItems = document.querySelectorAll('.template-item');
            
            categoryFilters.forEach(filter => {
                filter.addEventListener('click', function() {
                    const category = this.dataset.category;
                    
                    // Update active button
                    categoryFilters.forEach(btn => btn.classList.remove('active'));
                    this.classList.add('active');
                    
                    // Filter templates
                    templateItems.forEach(item => {
                        if (category === 'all' || item.dataset.category === category) {
                            item.style.display = 'block';
                        } else {
                            item.style.display = 'none';
                        }
                    });
                });
            });
            
            // Test email modal
            const testEmailBtns = document.querySelectorAll('.test-email-btn');
            const testEmailModal = new bootstrap.Modal(document.getElementById('testEmailModal'));
            
            testEmailBtns.forEach(btn => {
                btn.addEventListener('click', function() {
                    const templateCode = this.dataset.templateCode;
                    const templateName = this.dataset.templateName;
                    
                    document.getElementById('template_code').value = templateCode;
                    document.getElementById('template_name_display').textContent = templateName;
                    
                    testEmailModal.show();
                });
            });
            
            // Charts setup
            setupCharts();
            
            function setupCharts() {
                // Email activity chart (past 7 days)
                const ctx1 = document.getElementById('emailActivityChart').getContext('2d');
                
                // Sample data - would be replaced with real data from API call
                const labels = ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'];
                const sentData = [65, 59, 80, 81, 56, 55, 40];
                const failedData = [10, 5, 8, 12, 3, 2, 5];
                
                new Chart(ctx1, {
                    type: 'line',
                    data: {
                        labels: labels,
                        datasets: [
                            {
                                label: 'Sent',
                                data: sentData,
                                borderColor: '#4e73df',
                                backgroundColor: 'rgba(78, 115, 223, 0.1)',
                                tension: 0.3,
                                fill: true
                            },
                            {
                                label: 'Failed',
                                data: failedData,
                                borderColor: '#e74a3b',
                                backgroundColor: 'rgba(231, 74, 59, 0.1)',
                                tension: 0.3,
                                fill: true
                            }
                        ]
                    },
                    options: {
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                position: 'top'
                            }
                        },
                        scales: {
                            y: {
                                beginAtZero: true
                            }
                        }
                    }
                });
                
                // Categories chart
                const ctx2 = document.getElementById('categoriesChart').getContext('2d');
                
                // Prepare data from categories
                const categoryLabels = [];
                const categoryCounts = [];
                const categoryColors = [];
                
                {% for category, count in categories %}
                    categoryLabels.push("{{ category|capitalize }}");
                    categoryCounts.push({{ count }});
                    categoryColors.push(
                        "{{ loop.index % 4 == 1 ? '#4e73df' : (loop.index % 4 == 2 ? '#1cc88a' : (loop.index % 4 == 3 ? '#36b9cc' : '#f6c23e')) }}"
                    );
                {% endfor %}
                
                new Chart(ctx2, {
                    type: 'doughnut',
                    data: {
                        labels: categoryLabels,
                        datasets: [{
                            data: categoryCounts,
                            backgroundColor: categoryColors,
                            hoverOffset: 4
                        }]
                    },
                    options: {
                        maintainAspectRatio: false,
                        cutout: '70%',
                        plugins: {
                            legend: {
                                position: 'bottom'
                            }
                        }
                    }
                });
                
                // Fetch actual stats data (could be implemented)
                // fetchDashboardStats();
            }
            
            /* 
            function fetchDashboardStats() {
                fetch('{{ path('email_stats_json') }}')
                    .then(response => response.json())
                    .then(data => {
                        // Update charts with real data
                        // ...
                    });
            }
            */
        });
    </script>
{% endblock %}
