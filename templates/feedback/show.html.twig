{% extends 'base.html.twig' %}

{% block title %}Share Your Experience - Nautic Club{% endblock %}

{% block body %}
<div class="container mx-auto px-4 py-8">
    <div class="max-w-2xl mx-auto">
        <div class="bg-white rounded-lg shadow-sm p-6 mb-8">
            <h2 class="text-2xl font-bold mb-2">{{ transaction.eventName }}</h2>
            <div class="text-gray-600 mb-4">
                <i class="far fa-calendar mr-2"></i>{{ transaction.createdAt|date('M d, Y') }}
            </div>
        </div>

        <h1 class="text-3xl font-bold mb-4">Share Your Experience</h1>
        <p class="text-gray-600 mb-8">Your feedback helps us improve and assists other users in making informed decisions.</p>
        
        <form id="feedback-form" class="space-y-6" data-transaction-id="{{ transaction.id }}">
            <div>
                <label class="block text-gray-700 mb-2">Rating</label>
                <div class="flex items-center space-x-2">
                    {% for i in 1..5 %}
                        <button type="button" class="rating-star text-3xl text-gray-300 hover:text-yellow-400 focus:outline-none" data-rating="{{ i }}">
                            ★
                        </button>
                    {% endfor %}
                </div>
            </div>

            <div>
                <label class="block text-gray-700 mb-2">Username</label>
                <input type="text" name="username" class="w-full border rounded-lg p-2" required>
            </div>
            
            <div>
                <label class="block text-gray-700 mb-2">Your Review</label>
                <textarea name="comment" class="w-full border rounded-lg p-2 h-32" placeholder="Tell us about your experience..."></textarea>
            </div>

            <div>
                <label class="block text-gray-700 mb-2">Add Photos</label>
                <div class="photo-upload cursor-pointer border-2 border-dashed border-gray-300 rounded-lg p-6 text-center" id="photo-upload">
                    <input type="file" id="photo-input" class="hidden" accept="image/*" multiple>
                    <div class="text-gray-600">
                        <i class="fas fa-camera mb-2 text-2xl"></i>
                        <p>Tap to upload photos</p>
                    </div>
                </div>
                <div id="photo-preview" class="grid grid-cols-3 gap-4 mt-4"></div>
            </div>

            <div class="text-sm text-gray-600 mb-4">
                By submitting, you agree to our community guidelines and confirm this is your genuine experience.
            </div>

            <button type="submit" class="w-full bg-purple-600 text-white py-3 rounded-lg font-bold hover:bg-purple-700">
                Submit Review
            </button>
        </form>
    </div>
</div>

{% block javascripts %}
{{ parent() }}
<script>
document.addEventListener('DOMContentLoaded', function() {
    const form = document.getElementById('feedback-form');
    const stars = document.querySelectorAll('.rating-star');
    let selectedRating = 0;

    // Handle star rating
    stars.forEach(star => {
        star.addEventListener('click', () => {
            const rating = parseInt(star.dataset.rating);
            selectedRating = rating;
            stars.forEach((s, index) => {
                s.classList.toggle('text-yellow-400', index < rating);
                s.classList.toggle('text-gray-300', index >= rating);
            });
        });
    });

    // Handle form submission
    form.addEventListener('submit', async (e) => {
        e.preventDefault();
        
        const formData = {
            transactionId: form.dataset.transactionId,
            rating: selectedRating,
            username: form.username.value,
            comment: form.comment.value
        };

        try {
            const response = await fetch('{{ path('feedback_submit') }}', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify(formData)
            });

            const data = await response.json();
            
            if (data.success) {
                window.location.href = '{{ path('app_feedback_index') }}';
            } else {
                alert('Error submitting feedback. Please try again.');
            }
        } catch (error) {
            console.error('Error:', error);
            alert('Error submitting feedback. Please try again.');
        }
    });
});
</script>
{% endblock %}
{% endblock %} 