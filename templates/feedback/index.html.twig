{% extends 'base.html.twig' %}

{% block title %}Share Your Feedback - Nautic Club{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .feedback-container {
            max-width: 600px;
            margin: 3rem auto;
            padding: 2rem;
            background: white;
            border-radius: 16px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.1);
        }
        
        .feedback-header {
            text-align: center;
            margin-bottom: 2rem;
        }
        
        .feedback-header h1 {
            font-size: 1.75rem;
            margin-bottom: 0.5rem;
            color: #333;
            font-weight: 600;
        }
        
        .feedback-header p {
            color: #666;
        }
        
        .form-group {
            margin-bottom: 1.5rem;
        }
        
        .form-label {
            display: block;
            margin-bottom: 0.5rem;
            font-weight: 500;
            color: #333;
        }
        
        .form-control {
            width: 100%;
            padding: 0.75rem;
            border: 1px solid #e0e0e0;
            border-radius: 8px;
            font-size: 1rem;
        }
        
        textarea.form-control {
            min-height: 120px;
        }
        
        .rating-group {
            display: flex;
            justify-content: space-between;
            margin: 1rem 0;
        }
        
        .rating-option {
            display: flex;
            flex-direction: column;
            align-items: center;
        }
        
        .rating-option input {
            margin-bottom: 0.5rem;
        }
        
        .rating-option label {
            font-size: 0.875rem;
            color: #666;
        }
        
        .feedback-types {
            display: flex;
            flex-wrap: wrap;
            gap: 0.5rem;
            margin-bottom: 1rem;
        }
        
        .feedback-type {
            cursor: pointer;
            padding: 0.5rem 1rem;
            border: 1px solid #e0e0e0;
            border-radius: 20px;
            font-size: 0.875rem;
            color: #666;
        }
        
        .feedback-type:hover {
            background-color: #f5f5f5;
        }
        
        .feedback-type input {
            display: none;
        }
        
        .feedback-type input:checked + label {
            background-color: #4285F4;
            color: white;
            border-color: #4285F4;
        }
        
        .submit-btn {
            display: block;
            width: 100%;
            padding: 0.875rem;
            background-color: #4285F4;
            color: white;
            border: none;
            border-radius: 8px;
            font-weight: 600;
            cursor: pointer;
            transition: background-color 0.2s;
        }
        
        .submit-btn:hover {
            background-color: #3367D6;
        }
        
        .alert {
            padding: 1rem;
            border-radius: 8px;
            margin-bottom: 1.5rem;
        }
        
        .alert-danger {
            background-color: #FEEBE9;
            border-left: 4px solid #F87171;
            color: #991B1B;
        }
        
        .alert-success {
            background-color: #ECFDF5;
            border-left: 4px solid #10B981;
            color: #065F46;
        }
        
        .events-list {
            max-width: 800px;
            margin: 3rem auto;
            padding: 0 1rem;
        }
        
        .events-header {
            text-align: center;
            margin-bottom: 2rem;
        }
        
        .event-card {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 1.5rem;
            background: white;
            border-radius: 8px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
            margin-bottom: 1rem;
            transition: transform 0.2s;
        }
        
        .event-card:hover {
            transform: translateY(-2px);
        }
        
        .event-info h3 {
            margin: 0 0 0.5rem 0;
            font-size: 1.25rem;
        }
        
        .event-stats {
            display: flex;
            gap: 1rem;
        }
        
        .event-rating {
            color: #FFC107;
        }
        
        .event-actions a {
            display: inline-block;
            padding: 0.5rem 1rem;
            background-color: #4285F4;
            color: white;
            border-radius: 20px;
            text-decoration: none;
            font-size: 0.875rem;
            transition: background-color 0.2s;
        }
        
        .event-actions a:hover {
            background-color: #3367D6;
        }
    </style>
{% endblock %}

{% block body %}
<div class="feedback-container">
    <div class="feedback-header">
        <h1>Share Your Feedback</h1>
        <p>We value your opinion and would love to hear about your experience</p>
    </div>
    
    {% for message in app.flashes('error') %}
        <div class="alert alert-danger">
            {{ message }}
        </div>
    {% endfor %}
    
    <form action="{{ path('app_feedback_submit') }}" method="POST">
        <div class="form-group">
            <label for="name" class="form-label">Your Name</label>
            <input type="text" id="name" name="name" class="form-control" value="{{ data.name|default('') }}" required>
        </div>
        
        <div class="form-group">
            <label for="email" class="form-label">Your Email</label>
            <input type="email" id="email" name="email" class="form-control" value="{{ data.email|default('') }}" required>
        </div>
        
        <div class="form-group">
            <label for="event" class="form-label">Event</label>
            <select id="event" name="event" class="form-control" required>
                <option value="">-- Select an event --</option>
                <option value="Annual Regatta 2023" {% if data.event|default('') == 'Annual Regatta 2023' %}selected{% endif %}>Annual Regatta 2023</option>
                <option value="Summer Sailing Camp" {% if data.event|default('') == 'Summer Sailing Camp' %}selected{% endif %}>Summer Sailing Camp</option>
                <option value="Coastal Race Challenge" {% if data.event|default('') == 'Coastal Race Challenge' %}selected{% endif %}>Coastal Race Challenge</option>
                <option value="Beginners Yacht Training" {% if data.event|default('') == 'Beginners Yacht Training' %}selected{% endif %}>Beginners Yacht Training</option>
                <option value="Nautical Festival" {% if data.event|default('') == 'Nautical Festival' %}selected{% endif %}>Nautical Festival</option>
            </select>
        </div>
        
        <div class="form-group">
            <label class="form-label">Feedback Type</label>
            <div class="feedback-types">
                <div class="feedback-type">
                    <input type="radio" id="type-general" name="type" value="general" checked>
                    <label for="type-general">General</label>
                </div>
                <div class="feedback-type">
                    <input type="radio" id="type-suggestion" name="type" value="suggestion">
                    <label for="type-suggestion">Suggestion</label>
                </div>
                <div class="feedback-type">
                    <input type="radio" id="type-complaint" name="type" value="complaint">
                    <label for="type-complaint">Complaint</label>
                </div>
                <div class="feedback-type">
                    <input type="radio" id="type-praise" name="type" value="praise">
                    <label for="type-praise">Praise</label>
                </div>
                <div class="feedback-type">
                    <input type="radio" id="type-question" name="type" value="question">
                    <label for="type-question">Question</label>
                </div>
            </div>
        </div>
        
        <div class="form-group">
            <label class="form-label">Rate Your Experience</label>
            <div class="rating-group">
                {% for rating in 1..5 %}
                    <div class="rating-option">
                        <input type="radio" id="rating-{{ rating }}" name="rating" value="{{ rating }}" {% if data.rating|default(0) == rating %}checked{% endif %}>
                        <label for="rating-{{ rating }}">{{ rating }}</label>
                    </div>
                {% endfor %}
            </div>
        </div>
        
        <div class="form-group">
            <label for="message" class="form-label">Your Feedback</label>
            <textarea id="message" name="message" class="form-control" required>{{ data.message|default('') }}</textarea>
        </div>
        
        <button type="submit" class="submit-btn">Submit Feedback</button>
    </form>
    
    <div class="form-footer">
        <p class="text-center mt-4 text-sm text-gray-500">
            Your feedback is handled securely via FormSpree
        </p>
    </div>
</div>

<div class="events-list">
    <div class="events-header">
        <h2>Browse Event Feedback</h2>
        <p>Check out what others are saying about our events</p>
    </div>
    
    <div class="event-cards">
        {% for event in events %}
            <div class="event-card">
                <div class="event-info">
                    <h3>{{ event.name }}</h3>
                    <div class="event-stats">
                        <span class="event-rating">★ {{ event.rating }}</span>
                        <span class="event-count">{{ event.count }} reviews</span>
                    </div>
                </div>
                <div class="event-actions">
                    <a href="{{ path('app_feedback_by_event', {'eventName': event.name|url_encode}) }}">View Feedback</a>
                </div>
            </div>
        {% endfor %}
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Enhance feedback type selection
            const feedbackTypes = document.querySelectorAll('.feedback-type');
            
            feedbackTypes.forEach(function(type) {
                type.addEventListener('click', function() {
                    const radio = this.querySelector('input[type="radio"]');
                    radio.checked = true;
                });
            });
        });
    </script>
{% endblock %} 