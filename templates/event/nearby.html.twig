{% extends 'base.html.twig' %}

{% block title %}Nearby Events{% endblock %}

{% block body %}
<div class="container mx-auto px-4 py-8">
    <div class="mb-6">
        <a href="{{ path('app_event_index') }}" class="inline-flex items-center text-purple-600 hover:text-purple-800">
            <i class="fas fa-arrow-left mr-2"></i> Back to All Events
        </a>
    </div>

    <h1 class="text-3xl font-bold text-gray-800 mb-6">Find Events Near You</h1>
    
    <div class="bg-white shadow-md rounded-lg overflow-hidden mb-8">
        <div class="p-6">
            <form method="get" action="{{ path('app_event_nearby') }}" class="flex flex-wrap gap-4 items-end">
                <div class="w-full md:w-auto flex-1">
                    <label for="latitude" class="block text-sm font-medium text-gray-700 mb-1">Latitude</label>
                    <input type="text" id="latitude" name="latitude" value="{{ latitude }}" 
                           class="w-full border-gray-300 rounded-md shadow-sm focus:ring-purple-500 focus:border-purple-500" 
                           placeholder="Enter latitude">
                </div>
                
                <div class="w-full md:w-auto flex-1">
                    <label for="longitude" class="block text-sm font-medium text-gray-700 mb-1">Longitude</label>
                    <input type="text" id="longitude" name="longitude" value="{{ longitude }}" 
                           class="w-full border-gray-300 rounded-md shadow-sm focus:ring-purple-500 focus:border-purple-500" 
                           placeholder="Enter longitude">
                </div>
                
                <div class="w-full md:w-auto">
                    <label for="radius" class="block text-sm font-medium text-gray-700 mb-1">Radius (km)</label>
                    <input type="number" id="radius" name="radius" value="{{ radius }}" min="1" max="500" 
                           class="w-full border-gray-300 rounded-md shadow-sm focus:ring-purple-500 focus:border-purple-500" 
                           placeholder="Search radius">
                </div>
                
                <div class="w-full md:w-auto">
                    <button type="submit" class="w-full bg-purple-600 hover:bg-purple-700 text-white py-2 px-4 rounded">
                        <i class="fas fa-search mr-2"></i> Find Events
                    </button>
                </div>
                
                <div class="w-full md:w-auto">
                    <button type="button" id="get-location" class="w-full border border-purple-600 text-purple-600 hover:bg-purple-50 py-2 px-4 rounded">
                        <i class="fas fa-location-arrow mr-2"></i> Use My Location
                    </button>
                </div>
            </form>
        </div>
    </div>
    
    {% if latitude and longitude %}
        <h2 class="text-xl font-semibold text-gray-800 mb-4">Events within {{ radius }}km of [{{ latitude }}, {{ longitude }}]</h2>
        
        <div class="bg-white shadow-md rounded-lg overflow-hidden">
            {% if events|length > 0 %}
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 p-6">
                    {% for result in events %}
                        {% set event = result[0] %}
                        {% set distance = result['distance']|round(1) %}
                        
                        <div class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden hover:shadow-md transition-shadow">
                            <div class="p-5">
                                <h3 class="text-xl font-semibold text-gray-800 mb-2">{{ event.name }}</h3>
                                
                                <div class="flex items-center mb-3 text-gray-600">
                                    <i class="far fa-calendar-alt mr-2"></i>
                                    <span>{{ event.eventDate|date('F d, Y - H:i') }}</span>
                                </div>
                                
                                <div class="flex items-center mb-3 text-gray-600">
                                    <i class="fas fa-map-marker-alt mr-2"></i>
                                    <span>{{ event.locationWeather.name }}, {{ event.locationWeather.region }}</span>
                                </div>
                                
                                <div class="flex items-center mb-3 text-purple-600 font-medium">
                                    <i class="fas fa-route mr-2"></i>
                                    <span>{{ distance }} km away</span>
                                </div>
                                
                                <p class="text-gray-600 mb-4">{{ event.description|length > 100 ? event.description|slice(0, 100) ~ '...' : event.description }}</p>
                                
                                <a href="{{ path('app_event_show', {'id': event.id}) }}" class="inline-block bg-purple-100 hover:bg-purple-200 text-purple-800 px-4 py-2 rounded">
                                    View Details
                                </a>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% else %}
                <div class="p-6 text-center text-gray-500">
                    <p>No events found within {{ radius }}km of this location.</p>
                </div>
            {% endif %}
        </div>
    {% endif %}
</div>

<script>
    document.getElementById('get-location').addEventListener('click', function() {
        if (navigator.geolocation) {
            navigator.geolocation.getCurrentPosition(function(position) {
                document.getElementById('latitude').value = position.coords.latitude.toFixed(6);
                document.getElementById('longitude').value = position.coords.longitude.toFixed(6);
            }, function(error) {
                alert('Error getting your location: ' + error.message);
            });
        } else {
            alert('Geolocation is not supported by your browser');
        }
    });
</script>
{% endblock %} 